---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { SiteNoticeViewModel } from "@/services/site-notice";
import ActivityCenterClient from "./ActivityCenter.svelte";
import "./activity-center.css";
import { render } from "astro:content";

interface Props {
	notice?: SiteNoticeViewModel;
}

const { notice } = Astro.props;
const labels = {
	activityCenter: i18n(I18nKey.activityCenter),
	notifications: i18n(I18nKey.notifications),
	markAllRead: i18n(I18nKey.markAllRead),
	noNotifications: i18n(I18nKey.noNotifications),
	noUnreadNotifications: i18n(I18nKey.noUnreadNotifications),
	noImportantNotifications: i18n(I18nKey.noImportantNotifications),
	notificationDetails: i18n(I18nKey.notificationDetails),
	notificationSection: i18n(I18nKey.notificationSection),
	notificationAll: i18n(I18nKey.notificationAll),
	notificationUnread: i18n(I18nKey.notificationUnread),
	notificationImportant: i18n(I18nKey.notificationImportant),
	notificationUnreadCount: i18n(I18nKey.notificationUnreadCount),
	notificationRead: i18n(I18nKey.notificationRead),
	notificationDismiss: i18n(I18nKey.notificationDismiss),
	notificationAcknowledge: i18n(I18nKey.notificationAcknowledge),
	notificationLater: i18n(I18nKey.notificationLater),
	notificationOpen: i18n(I18nKey.notificationOpen),
	readingStatus: i18n(I18nKey.readingStatus),
	readingProgress: i18n(I18nKey.readingProgress),
	remainingReading: i18n(I18nKey.remainingReading),
	currentSection: i18n(I18nKey.currentSection),
	resumeReading: i18n(I18nKey.resumeReading),
};
const noticeItems = notice?.notices ?? [];
const renderedNotices = await Promise.all(
	noticeItems.map(async (item) => {
		const { entry, ...clientNotice } = item;
		if (!entry) return { id: item.id, clientNotice, Content: undefined };

		const { Content } = await render(entry);
		return { id: item.id, clientNotice, Content };
	}),
);
const clientNotices = renderedNotices.map(({ clientNotice }) => clientNotice);
---

<ActivityCenterClient notices={clientNotices} {labels} client:load />
<div class="activity-center__content-source" hidden>
	{
		renderedNotices.map(({ id, Content, clientNotice }) => (
			<template data-notification-content={id}>
				{Content ? <Content /> : <p>{clientNotice.content}</p>}
			</template>
		))
	}
</div>
