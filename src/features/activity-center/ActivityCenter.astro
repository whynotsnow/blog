---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { SiteNoticeViewModel } from "@/services/site-notice";
import ActivityCenterClient from "./ActivityCenter.svelte";
import "./activity-center.css";

interface Props {
	notice?: SiteNoticeViewModel;
}

const { notice } = Astro.props;
const labels = {
	activityCenter: i18n(I18nKey.activityCenter),
	notifications: i18n(I18nKey.notifications),
	markAllRead: i18n(I18nKey.markAllRead),
	noNotifications: i18n(I18nKey.noNotifications),
	readingStatus: i18n(I18nKey.readingStatus),
	readingProgress: i18n(I18nKey.readingProgress),
	remainingReading: i18n(I18nKey.remainingReading),
	currentSection: i18n(I18nKey.currentSection),
	resumeReading: i18n(I18nKey.resumeReading),
};
---

<ActivityCenterClient notices={notice?.notices ?? []} {labels} client:load />
