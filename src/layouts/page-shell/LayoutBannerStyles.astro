<style is:global>
	@reference "../../styles/main.css";

	@layer components {
		.enable-banner.is-home #banner-wrapper {
			@apply lg:h-(--banner-height-home) lg:translate-y-(--banner-height-extend);
		}
		.enable-banner #banner-wrapper {
			@apply lg:h-(--banner-height-home);
		}
		.enable-banner.is-home #banner {
			@apply lg:h-(--banner-height-home) lg:translate-y-0;
		}
		.enable-banner #banner {
			@apply lg:h-(--banner-height-home) lg:translate-y-(--bannerOffset);
		}
		.enable-banner.fullscreen-banner #banner-wrapper {
			@apply lg:h-screen lg:translate-y-0;
		}
		.enable-banner.fullscreen-banner #banner {
			@apply lg:h-screen lg:translate-y-0;
		}
		.enable-banner.fullscreen-banner #top-row {
			@apply lg:h-[calc(100vh-4.5rem)];
		}
		.enable-banner.is-home #main-grid {
			@apply lg:translate-y-(--banner-height-extend);
		}
		.enable-banner.fullscreen-banner.is-home #main-grid {
			@apply lg:translate-y-0;
		}
		.enable-banner #top-row {
			@apply lg:h-[calc(var(--banner-height-home)-4.5rem)] transition-all duration-300;
		}
		@media (min-width: 1280px) {
			.enable-banner.is-home:not(.fullscreen-banner)
				:is(#sidebar-sticky, #right-sidebar-sticky) {
				top: calc(1rem - var(--banner-height-extend)) !important;
			}
			.enable-banner.fullscreen-banner.is-home
				:is(#sidebar-sticky, #right-sidebar-sticky) {
				top: 1rem !important;
			}
		}
		.navbar-hidden {
			@apply opacity-0 -translate-y-16;
		}

		/* Water waves animation */
		.waves > .parallax use {
			animation: wave 25s cubic-bezier(0.5, 0.5, 0.45, 0.5) infinite;
		}
		@keyframes wave {
			0% {
				transform: translate3d(-90px, 0, 0);
			}
			100% {
				transform: translate3d(85px, 0, 0);
			}
		}
	}
</style>
