---
import type { MarkdownHeading } from "astro";
import FullscreenWallpaper from "@components/misc/FullscreenWallpaper.astro";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import Navbar from "@components/Navbar.astro";
import Banner from "@/components/layout/Banner/Banner.astro";
import MainGridContent from "@/components/layout/MainGridContent.astro";
import SidebarTocRegion from "@/components/layout/SidebarTocRegion.astro";
import { fullscreenWallpaperConfig, siteConfig } from "@/config";
import type { ContentStore } from "@/services/core/types";
import { buildMainGridLayoutViewModel } from "@/services/layout/main-grid";
import { WidgetManager, widgetManager } from "@/utils/widget-manager";
import Layout from "./Layout.astro";
import "@/styles/main-grid-layout.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	store: ContentStore;
	custom_widgetManager?: WidgetManager;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
	store,
	custom_widgetManager,
} = Astro.props;
const applyWidgetManager = custom_widgetManager ?? widgetManager;
const viewModel = await buildMainGridLayoutViewModel({
	config: siteConfig,
	widgetManager: applyWidgetManager,
	pathname: Astro.url.pathname,
});
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
>
	<script>
		import "@/components/layout/main-grid-client";
	</script>

	<FullscreenWallpaper config={fullscreenWallpaperConfig} />
	<IconifyLoader />

	<slot slot="head" name="head" />
	<div
		id="top-row"
		class="z-50 pointer-events-none relative transition-all duration-700 max-w-(--page-width) px-0 md:px-4 mx-auto"
		class:list={[""]}
	>
		<div
			id="navbar-wrapper"
			class="pointer-events-auto sticky top-0 transition-all"
		>
			<Navbar />
		</div>
	</div>

	<Banner
		bannerImages={viewModel.bannerImages}
		config={siteConfig.banner}
		mobileNonHomeClass={viewModel.banner.mobileNonHomeClass}
		showHomeText={viewModel.banner.showHomeText}
	/>

	<MainGridContent
		headings={headings}
		store={store}
		widgetManager={applyWidgetManager}
		viewModel={viewModel}
	>
		<slot />
	</MainGridContent>

	<SidebarTocRegion headings={headings} viewModel={viewModel} />
</Layout>
