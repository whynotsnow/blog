---
import type { MarkdownHeading } from "astro";
import FullscreenWallpaper from "@components/misc/FullscreenWallpaper.astro";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import Navbar from "@components/Navbar.astro";
import Banner from "@/components/layout/Banner/Banner.astro";
import MainGridContent from "@/components/layout/MainGridContent.astro";
import { fullscreenWallpaperConfig, siteConfig, siteNoticeConfig } from "@/config";
import type { ContentStore } from "@/services/core/types";
import { buildMainGridLayoutViewModel } from "@/services/layout/main-grid";
import { buildSiteNoticeViewModel } from "@/services/site-notice";
import { buildFooterViewModel } from "@/services/footer";
import type { PageLayoutPolicyName } from "@/services/layout/types";
import { resolveWidgetPlacement } from "@/services/widget/resolver";
import type { WidgetPlacementName } from "@/services/widget/types";
import Layout from "./Layout.astro";
import "@/styles/main-grid-layout.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	store: ContentStore;
	layoutPolicy?: PageLayoutPolicyName;
	widgetPlacement?: WidgetPlacementName;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
	store,
	layoutPolicy = "default",
	widgetPlacement = "default",
} = Astro.props;
const viewModel = await buildMainGridLayoutViewModel({
	config: siteConfig,
	layoutPolicy,
	pathname: Astro.url.pathname,
});
const widgets = resolveWidgetPlacement(widgetPlacement, { store });
const siteNotice = buildSiteNoticeViewModel(siteNoticeConfig, Astro.url.pathname);
const footer = buildFooterViewModel(store);
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
	navbarBehavior={viewModel.interaction.navbar}
	shellStrategy={viewModel.pageLayout.shellStrategy}
>
	<script>
		import "@/components/layout/main-grid-client";
	</script>

	<FullscreenWallpaper config={fullscreenWallpaperConfig} />
	<IconifyLoader />
	<div
		id="navigation-progress"
		class="navigation-progress"
		data-state="idle"
		aria-hidden="true"
	>
		<div class="navigation-progress__indicator"></div>
	</div>

	<slot slot="head" name="head" />
	<div
		id="top-row"
		class:list={[
			"z-50 pointer-events-none relative transition-all duration-700 mx-auto",
			{
				"max-w-(--page-width) px-0 md:px-4":
					viewModel.pageLayout.shellStrategy !== "container-content",
			},
		]}
		data-shell-strategy={viewModel.pageLayout.shellStrategy}
	>
		<div
			id="navbar-wrapper"
			class="pointer-events-auto sticky top-0 transition-all"
		>
			<Navbar
				containerContent={viewModel.pageLayout.shellStrategy === "container-content"}
				class={viewModel.pageLayout.shellStrategy === "container-content"
					? "navbar__inner--container-content"
					: undefined}
			/>
		</div>
	</div>

	<Banner
		bannerImages={viewModel.bannerImages}
		config={siteConfig.banner}
		mobileNonHomeClass={viewModel.banner.mobileNonHomeClass}
		showHomeText={viewModel.banner.showHomeText}
	/>

	<MainGridContent
		headings={headings}
		widgets={widgets}
		viewModel={viewModel}
		siteNotice={siteNotice}
		footer={footer}
	>
		<slot />
	</MainGridContent>

</Layout>
