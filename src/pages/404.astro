---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
	layoutPolicy="content"
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
>
	<!-- 引入右侧边栏布局管理器 -->
	<div
		class="not-found-page flex w-full rounded-(--radius-large) overflow-hidden relative min-h-96"
	>
		<div
			class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center"
		>
			<!-- 404 大号数字 -->
			<div
				class="not-found-page__code font-bold text-(--primary) opacity-20 mb-4"
			>
				{i18n(I18nKey.notFound)}
			</div>

			<!-- 404 图标 -->
			<div class="mb-6">
				<Icon
					name="material-symbols:error-outline"
					class="not-found-page__main-icon text-(--primary)"
				/>
			</div>

			<!-- 标题 -->
			<h1 class="not-found-page__title font-bold mb-4 text-90">
				{i18n(I18nKey.notFoundTitle)}
			</h1>

			<!-- 描述 -->
			<p class="not-found-page__description text-75 mb-8 max-w-md">
				{i18n(I18nKey.notFoundDescription)}
			</p>

			<!-- 返回首页按钮 -->
			<a
				href="/"
				class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white rounded-(--radius-large) hover:opacity-95 transition-colors transition-transform duration-200 font-medium"
			>
				<Icon name="material-symbols:home" class="not-found-page__button-icon" />
				{i18n(I18nKey.backToHome)}
			</a>

			<!-- 装饰性元素 -->
			<div class="absolute top-4 left-4 opacity-10">
				<Icon
					name="material-symbols:sentiment-sad"
					class="not-found-page__decor-icon text-(--primary)"
				/>
			</div>
			<div class="absolute bottom-4 right-4 opacity-10">
				<Icon
					name="material-symbols:search-off"
					class="not-found-page__decor-icon text-(--primary)"
				/>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.not-found-page__code {
		font-size: clamp(var(--text-list-title-size), 14vw, 8rem);
	}

	.not-found-page__main-icon {
		font-size: var(--text-icon-display-size);
	}

	.not-found-page__title {
		font-size: var(--text-page-title-size);
	}

	.not-found-page__description {
		font-size: var(--text-section-title-size);
	}

	.not-found-page__button-icon {
		font-size: var(--text-icon-inline-size);
	}

	.not-found-page__decor-icon {
		font-size: var(--text-icon-heading-size);
	}

	/* 添加一些动画效果 */
	.card-base {
		animation: fadeInUp 0.6s ease-out;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 按钮悬停效果 */
	a:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.3);
	}
</style>
