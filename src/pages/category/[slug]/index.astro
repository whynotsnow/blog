---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import CategoryPage from "@components/category/CategoryPage.astro";
import {
	getCategoryIndexStaticPaths,
	type CategoryPageProps,
} from "@/services/category-page";

export const getStaticPaths = getCategoryIndexStaticPaths;

const { posts, allPosts, page, categories, categorySlug, store } =
	Astro.props as CategoryPageProps;
---

<MainGridLayout store={store} layoutPolicy="listing">
	<CategoryPage {posts} {allPosts} {page} {categories} {categorySlug} {store} />
</MainGridLayout>
