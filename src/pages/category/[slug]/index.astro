---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import PostPage from "@/components/PostPage.astro";
import Pagination from "@/components/control/Pagination.astro";
import CategoryPostListClient from "@components/post/CategoryPostListClient.svelte";
import {
	getCategoryIndexStaticPaths,
	type CategoryPageProps,
} from "@/services/category-page";

export const getStaticPaths = getCategoryIndexStaticPaths;

const { posts, allPosts, page, categories, categorySlug, store } =
	Astro.props as CategoryPageProps;
---

<MainGridLayout store={store}>
	<CategoryPostListClient
		client:load
		posts={allPosts}
		categories={categories}
		categorySlug={categorySlug}
	>
		<PostPage posts={posts} categories={categories} />

		<Pagination
			page={page}
			class="mx-auto"
			style={`animation-delay: calc(var(--content-delay) + ${page.data.length * 50}ms)`}
		/>
	</CategoryPostListClient>
</MainGridLayout>
