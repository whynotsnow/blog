---
import type { Page } from "astro";
import { render } from "astro:content";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import PostPage from "@/components/PostPage.astro";
import Pagination from "@/components/control/Pagination.astro";
import { PAGE_SIZE, UNCATEGORIZED } from "@/constants/constants";
import { buildCategoryIndex } from "@/utils/category-page";
import CategoryPostListClient from "@components/post/CategoryPostListClient.svelte";
import type { CategoryItem, TagItem, UIPost } from "@components/post/useCategoryPagination";
import { toSlug } from "@utils/client-utils";
import { CollectionEntry } from "astro:content";
import { getPostUrl, getTagUrl, resolveImageUrl } from "@utils/url-utils";
import { getPostNavigatorData } from "@utils/content-utils";

/**
 * static paths
 */
export const getStaticPaths = async () => {
  const categoryMap = await buildCategoryIndex();

  return [...categoryMap.keys()].map((slug) => ({
    params: { slug },
  }));
};

/**
 * params
 */
const { slug } = Astro.params;
// 只有分类没有 slug 重定向为404，例如/category/
if (!slug) return Astro.redirect("/404");

/**
 * data source
 */
const categoryMap = await buildCategoryIndex();
const entry = categoryMap.get(slug);

if (!entry) return Astro.redirect("/404");

const { posts: allPosts } = entry;
const categories = await getPostNavigatorData();

/**
 * 将 Astro 内容集合中的文章条目转换为前端 UI 所需的统一格式（UIPost）
 * @param post - Astro 内容集合中的文章条目（类型 `CollectionEntry<"posts">`）
 * @returns 符合前端组件使用的标准化文章对象（`Promise<UIPost>`）
 */
export async function toUIPost(post: CollectionEntry<"posts">): Promise<UIPost> {
  const { id, data } = post;

  // 渲染文章以获取 remark 插件生成的数据（字数、摘要等）
  const { remarkPluginFrontmatter } = await render(post);

  // 解析文章的封面图片 URL（客户端可访问）
  const imageUrl = resolveImageUrl(post);

  // 构造分类对象（复用公共类型 BaseSlug）
  const category: CategoryItem = {
    label: data.category?.trim() || UNCATEGORIZED,
    slug: toSlug(data.category || ""),
  };

  // 构造标签数组（每个标签对象包含预计算的 URL）
  const tags: TagItem[] = (data.tags ?? [])
    .map((t: string) => ({
      label: t.trim(),
      slug: toSlug(t),
      // 此处 url 由 getTagUrl 预计算，确保与全局标签链接规则一致
      // 注意：需要导入 getTagUrl 或确保它在此作用域可用
      url: getTagUrl(t),
    }))
    .sort((a, b) => a.label.localeCompare(b.label)); // 按字母排序，保持一致性

  return {
    // 基础标识
    id,
    slug: category.slug, // 文章所属分类的 slug（用于归档链接）
    url: getPostUrl(post), // 文章本身的 URL

    // 文本内容
    title: data.title,
    description: data.description,

    // 时间（ISO 字符串格式，便于前端展示和排序）
    published: data.published.toISOString(),
    updated: data.updated?.toISOString(),

    // 分类与标签
    category,
    tags,

    // 元数据（用于文章信息栏）
    meta: {
      id,
      published: data.published.toISOString(),
      updated: data.updated?.toISOString(),
      category,
      tags,
      words: remarkPluginFrontmatter?.words,
      excerpt: remarkPluginFrontmatter?.excerpt,
    },

    // 封面图相关
    hasCoverImage: Boolean(data.image), // 基于原始字段判断，仅用于 UI 提示
    image: imageUrl, // 客户端可访问的图片 URL

    source: "client", // 标识数据来源（client 表示用于客户端渲染）
  };
}

/**
 * pagination (page 1)
 */

const lastPageNumber = Math.ceil(allPosts.length / PAGE_SIZE);

const page: Page<(typeof allPosts)[number]> = {
  data: allPosts.slice(0, PAGE_SIZE),
  start: 0,
  end: PAGE_SIZE,
  size: PAGE_SIZE,
  total: allPosts.length,
  currentPage: 1,
  lastPage: Math.max(1, lastPageNumber),
  url: {
    current: `/category/${slug}/`,
    first: `/category/${slug}/`,
    last: lastPageNumber > 1 ? `/category/${slug}/page/${lastPageNumber}/` : `/category/${slug}/`,
    prev: undefined,
    next: allPosts.length > PAGE_SIZE ? `/category/${slug}/page/2/` : undefined,
  },
};
const posts = await Promise.all(allPosts.map(toUIPost));
---

<MainGridLayout>
  <CategoryPostListClient client:load posts={posts} categories={categories} categorySlug={slug}>
    <PostPage posts={page!.data} />

    <Pagination
      page={page}
      class="mx-auto"
      style={`animation-delay: calc(var(--content-delay) + ${page.data.length * 50}ms)`}
    />
  </CategoryPostListClient>
</MainGridLayout>
