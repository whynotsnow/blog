---
import type { GetStaticPaths } from "astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import PostPage from "@/components/PostPage.astro";
import Pagination from "@/components/control/Pagination.astro";
import CategoryPostListClient from "@components/post/CategoryPostListClient.svelte";
import {
	getCategoryPaginatedStaticPaths,
	type CategoryPageProps,
} from "@/services/category-page";

export const getStaticPaths =
	getCategoryPaginatedStaticPaths satisfies GetStaticPaths;

/**
 * params & props
 */
const { slug } = Astro.params;
const { posts, allPosts, page, categorySlug, categories, store } =
	Astro.props as CategoryPageProps;

if (!slug) return Astro.redirect("/404");
---

<MainGridLayout store={store}>
	<CategoryPostListClient
		client:load
		posts={allPosts}
		categories={categories}
		categorySlug={categorySlug}
	>
		<PostPage posts={posts} categories={categories} />

		<Pagination
			page={page}
			class="mx-auto"
			style={`animation-delay: calc(var(--content-delay) + ${page.data.length * 50}ms)`}
		/>
	</CategoryPostListClient>
</MainGridLayout>
