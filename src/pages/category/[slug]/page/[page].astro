---
import type { GetStaticPaths, Page } from "astro";
import type { CategoryEntry, RawPost } from "@/services/core/types";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import PostPage from "@/components/PostPage.astro";
import Pagination from "@/components/control/Pagination.astro";
import CategoryPostListClient from "@components/post/CategoryPostListClient.svelte";
import { toUIPost } from "@/services/core/inject";
import { getCategoryPaginatedStaticPaths } from "@/services/category-page";
import { PostNavigatorCategory } from "@utils/client-utils";

export interface Props {
  page: Page<RawPost>;
  categorySlug: string;
  categories: PostNavigatorCategory[];
  categoryAllPosts: CategoryEntry;
}

export const getStaticPaths = getCategoryPaginatedStaticPaths satisfies GetStaticPaths;

/**
 * params & props
 */
const { slug } = Astro.params;
const { page, categorySlug, categories, categoryAllPosts } = Astro.props as Props;

if (!slug) return Astro.redirect("/404");

/**
 *
 * SSG 静态时使用 page.data 做分页
 * client 分页需要分类的所有数据做分页
 */
const posts = await Promise.all(page.data.map(toUIPost));
const allPosts = await Promise.all(categoryAllPosts.posts.map(toUIPost));
---

<MainGridLayout>
  <CategoryPostListClient
    client:load
    posts={allPosts}
    categories={categories}
    categorySlug={categorySlug}
  >
    <PostPage posts={posts} categories={categories} />

    <Pagination
      page={page}
      class="mx-auto"
      style={`animation-delay: calc(var(--content-delay) + ${page.data.length * 50}ms)`}
    />
  </CategoryPostListClient>
</MainGridLayout>
