---
import CategoryHubPage from "@components/category/CategoryHubPage.astro";
import CategorySupport from "@components/category/CategorySupport.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryRecommendedPageViewModel } from "@/services/category-hub";

const model = await getCategoryRecommendedPageViewModel();
---

<MainGridLayout title={model.title} layoutPolicy="listing">
	<CategorySupport
		slot="support"
		support={model.support}
	/>
	<CategoryHubPage {model} />
</MainGridLayout>
