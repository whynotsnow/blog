---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { buildArchivePageData } from "@/services/archive";

const { posts, tags, categories, store } = await buildArchivePageData();
---

<MainGridLayout title={i18n(I18nKey.archive)} store={store}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<ArchivePanel
		sortedPosts={posts}
		tags={tags}
		categories={categories}
		client:only="svelte"
	/>
</MainGridLayout>
