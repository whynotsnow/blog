---
import PostPage from "../components/PostPage.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getContentStore } from "@/services/core/content-store";
import { toUIPost } from "@/services/core/inject";
import { PAGE_SIZE } from "@constants/constants";

// const { posts, categories } = await getHomeList();

const store = await getContentStore();
const { posts, categories } = store;

const uiPosts = await Promise.all(posts.map(toUIPost));

const sliced = uiPosts.slice(0, PAGE_SIZE);
---

<MainGridLayout store={store}>
	<PostPage posts={sliced} categories={categories} />
</MainGridLayout>
