---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import { UNCATEGORIZED } from "../constants/constants";
import {
	getAllTechStack,
	getFeaturedProjects,
	getProjectStats,
	getProjectsByCategory,
	projectsData,
} from "../data/projects";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import "../styles/gradient-buttons.css";

// 检查项目页面是否启用
if (!siteConfig.featurePages.projects) {
	return Astro.redirect("/404/");
}

// 获取项目统计信息
const stats = getProjectStats();
const featuredProjects = getFeaturedProjects();
const allTechStack = getAllTechStack();

// 获取所有分类
const categories = [
	...new Set(projectsData.map((project) => project.category)),
];

// 按分类获取项目
const projectsByCategory = categories.reduce(
	(acc, category) => {
		acc[category] = getProjectsByCategory(category);
		return acc;
	},
	{} as Record<string, typeof projectsData>,
);

const title = i18n(I18nKey.projects);
const subtitle = i18n(I18nKey.projectsSubtitle);

// 获取分类文本的国际化翻译
const getCategoryText = (category: string) => {
	switch (category) {
		case "web":
			return i18n(I18nKey.projectsWeb);
		case "mobile":
			return i18n(I18nKey.projectsMobile);
		case "desktop":
			return i18n(I18nKey.projectsDesktop);
		case "other":
			return i18n(I18nKey.projectsOther);
		case UNCATEGORIZED:
			return i18n(I18nKey.uncategorized);
		default:
			return category;
	}
};
---

<MainGridLayout title={title} description={subtitle} layoutPolicy="content">
	<div
		class="projects-page flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<!-- 页面标题 -->
			<div class="flex flex-col items-start justify-center mb-8">
				<h1
					class="projects-page__title font-bold text-black/90 dark:text-white/90 mb-2 relative
                  before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                  before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
				>
					{i18n(I18nKey.projects)}
				</h1>
				<p class="projects-page__subtitle text-black/60 dark:text-white/60">
					{i18n(I18nKey.projectsSubtitle)}
				</p>
			</div>

			<!-- 统计信息 -->
			<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
				<div
					class="bg-blue-500/10 dark:bg-blue-900/30 rounded-lg p-4 border border-blue-500/20 dark:border-blue-900/30 hover:shadow-lg transition-shadow duration-300"
				>
					<div
						class="projects-page__stat-value font-bold text-blue-600 dark:text-blue-400"
					>
						{stats.total}
					</div>
					<div class="projects-page__stat-label text-blue-600/70 dark:text-blue-400/70">
						{i18n(I18nKey.projectsTotal)}
					</div>
				</div>
				<div
					class="bg-green-500/10 dark:bg-green-900/30 rounded-lg p-4 border border-green-500/20 dark:border-green-900/30 hover:shadow-lg transition-shadow duration-300"
				>
					<div
						class="projects-page__stat-value font-bold text-green-600 dark:text-green-400"
					>
						{stats.byStatus.completed}
					</div>
					<div
						class="projects-page__stat-label text-green-600/70 dark:text-green-400/70"
					>
						{i18n(I18nKey.projectsCompleted)}
					</div>
				</div>
				<div
					class="bg-yellow-500/10 dark:bg-yellow-900/30 rounded-lg p-4 border border-yellow-500/20 dark:border-yellow-900/30 hover:shadow-lg transition-shadow duration-300"
				>
					<div
						class="projects-page__stat-value font-bold text-yellow-600 dark:text-yellow-400"
					>
						{stats.byStatus.inProgress}
					</div>
					<div
						class="projects-page__stat-label text-yellow-600/70 dark:text-yellow-400/70"
					>
						{i18n(I18nKey.projectsInProgress)}
					</div>
				</div>
				<div
					class="bg-purple-500/10 dark:bg-purple-900/30 rounded-lg p-4 border border-purple-500/20 dark:border-purple-900/30 hover:shadow-lg transition-shadow duration-300"
				>
					<div
						class="projects-page__stat-value font-bold text-purple-600 dark:text-purple-400"
					>
						{allTechStack.length}
					</div>
					<div
						class="projects-page__stat-label text-purple-600/70 dark:text-purple-400/70"
					>
						{i18n(I18nKey.projectsTechStack)}
					</div>
				</div>
			</div>

			<!-- 特色项目 -->
			{
				featuredProjects.length > 0 && (
					<div class="mb-8">
						<h2
							class="projects-page__section-title font-bold text-black/90 dark:text-white/90 mb-4 relative
                    before:w-1 before:h-6 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
						>
							{i18n(I18nKey.projectsFeatured)}
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{featuredProjects.map((project) => (
								<div class="bg-transparent rounded-lg border border-black/10 dark:border-white/10 overflow-hidden hover:shadow-lg transition-shadow duration-300">
									{project.image && (
										<div class="aspect-video overflow-hidden">
											<img
												src={project.image}
												alt={project.title}
												class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
											/>
										</div>
									)}
									<div class="p-6">
										<div class="flex items-start justify-between mb-3">
											<h3 class="projects-page__featured-title font-semibold text-black/90 dark:text-white/90">
												{project.title}
											</h3>
											<span
												class={`projects-page__badge px-2 py-1 rounded-full ${
													project.status ===
													"completed"
														? "bg-green-600/20 text-green-700 dark:bg-green-900/30 dark:text-green-400"
														: project.status ===
															  "in-progress"
															? "bg-yellow-600/20 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400"
															: "bg-gray-600/20 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400"
												}`}
											>
												{i18n(
													project.status ===
														"completed"
														? I18nKey.projectsCompleted
														: project.status ===
															  "in-progress"
															? I18nKey.projectsInProgress
															: I18nKey.projectsPlanned,
												)}
											</span>
										</div>
										<p class="text-black/60 dark:text-white/60 mb-4 line-clamp-2">
											{project.description}
										</p>
										<div class="flex flex-wrap gap-2 mb-4">
											{project.techStack
												.slice(0, 4)
												.map((tech) => (
													<span class="projects-page__tag px-2 py-1 bg-blue-600/20 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 rounded">
														{tech}
													</span>
												))}
											{project.techStack.length > 4 && (
												<span class="projects-page__tag px-2 py-1 bg-gray-600/20 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400 rounded">
													+
													{project.techStack.length -
														4}
												</span>
											)}
										</div>
										<div class="projects-page__actions flex flex-wrap gap-2">
											{project.visitUrl && (
												<a
													href={project.visitUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="btn-gradient btn-gradient-primary btn-gradient-md"
												>
													<Icon
														name="material-symbols:open-in-new"
														class="projects-page__action-icon"
													/>
													{i18n(
														I18nKey.projectsVisit,
													)}
												</a>
											)}
											{project.sourceCode && (
												<a
													href={project.sourceCode}
													target="_blank"
													rel="noopener noreferrer"
													class="btn-gradient btn-github btn-gradient-md"
												>
													<Icon
														name="mdi:github"
														class="projects-page__action-icon"
													/>
													{i18n(
														I18nKey.projectsGitHub,
													)}
												</a>
											)}
										</div>
									</div>
								</div>
							))}
						</div>
					</div>
				)
			}

			<!-- 按分类展示项目 -->
			<div class="space-y-8">
				{
					categories.map((category) => {
						const categoryProjects = projectsByCategory[category];
						if (categoryProjects.length === 0) return null;

						return (
							<div>
								<h2
									class="projects-page__section-title font-bold text-black/90 dark:text-white/90 mb-4 relative
                        before:w-1 before:h-6 before:rounded-md before:bg-[var(--primary)]
                        before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
								>
									{getCategoryText(category)}
									<span class="projects-page__section-count font-normal text-black/60 dark:text-white/60 ml-2">
										({categoryProjects.length})
									</span>
								</h2>
								<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
									{categoryProjects.map((project) => (
										<div class="bg-transparent rounded-lg border border-black/10 dark:border-white/10 overflow-hidden hover:shadow-lg transition-shadow duration-300">
											{project.image && (
												<div class="aspect-video overflow-hidden">
													<img
														src={project.image}
														alt={project.title}
														class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
													/>
												</div>
											)}
											<div class="p-4">
												<div class="flex items-start justify-between mb-2">
													<h3 class="projects-page__card-title font-semibold text-black/90 dark:text-white/90 line-clamp-1">
														{project.title}
													</h3>
													<span
														class={`projects-page__badge px-2 py-1 rounded-full shrink-0 ml-2 ${
															project.status ===
															"completed"
																? "bg-green-600/20 text-green-700 dark:bg-green-900/30 dark:text-green-400"
																: project.status ===
																	  "in-progress"
																	? "bg-yellow-600/20 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400"
																	: "bg-gray-600/20 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400"
														}`}
													>
														{i18n(
															project.status ===
																"completed"
																? I18nKey.projectsCompleted
																: project.status ===
																	  "in-progress"
																	? I18nKey.projectsInProgress
																	: I18nKey.projectsPlanned,
														)}
													</span>
												</div>
												<p class="projects-page__description text-black/60 dark:text-white/60 mb-3 line-clamp-2">
													{project.description}
												</p>
												<div class="flex flex-wrap gap-1 mb-3">
													{project.techStack
														.slice(0, 3)
														.map((tech) => (
															<span class="projects-page__tag px-2 py-1 bg-blue-600/20 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 rounded">
																{tech}
															</span>
														))}
													{project.techStack.length >
														3 && (
														<span class="projects-page__tag px-2 py-1 bg-gray-600/20 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400 rounded">
															+
															{project.techStack
																.length - 3}
														</span>
													)}
												</div>
												<div class="projects-page__actions flex flex-wrap gap-2">
													{project.visitUrl && (
														<a
															href={
																project.visitUrl
															}
															target="_blank"
															rel="noopener noreferrer"
															class="btn-gradient btn-gradient-primary btn-gradient-md"
														>
															<Icon
																name="material-symbols:open-in-new"
																class="projects-page__action-icon"
															/>
															{i18n(
																I18nKey.projectsVisit,
															)}
														</a>
													)}
													{project.sourceCode && (
														<a
															href={
																project.sourceCode
															}
															target="_blank"
															rel="noopener noreferrer"
															class="btn-gradient btn-github btn-gradient-md"
														>
															<Icon
																name="mdi:github"
																class="projects-page__action-icon"
															/>
															{i18n(
																I18nKey.projectsGitHub,
															)}
														</a>
													)}
												</div>
											</div>
										</div>
									))}
								</div>
							</div>
						);
					})
				}
			</div>

			<!-- 技术栈统计 -->
			<div
				class="mt-12 pt-8 border-t border-black/10 dark:border-white/10"
			>
				<h2
					class="projects-page__section-title font-bold text-black/90 dark:text-white/90 mb-4"
				>
					{i18n(I18nKey.projectsTechStack)}
				</h2>
				<div class="flex flex-wrap gap-2">
					{
						allTechStack.map((tech) => (
							<span class="projects-page__tech-chip px-3 py-1 bg-gray-600/20 text-gray-700 dark:bg-gray-800 dark:text-gray-300 rounded-full">
								{tech}
							</span>
						))
					}
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.projects-page__title {
		font-size: var(--text-page-title-size);
	}

	.projects-page__subtitle,
	.projects-page__section-title,
	.projects-page__card-title {
		font-size: var(--text-section-title-size);
	}

	.projects-page__section-count,
	.projects-page__stat-label,
	.projects-page__description,
	.projects-page__actions,
	.projects-page__tech-chip {
		font-size: var(--text-ui-size);
	}

	.projects-page__stat-value {
		font-size: var(--text-list-title-size);
	}

	.projects-page__featured-title {
		font-size: var(--text-card-title-size);
	}

	.projects-page__badge,
	.projects-page__tag {
		font-size: var(--text-caption-size);
	}

	.projects-page__action-icon {
		font-size: var(--text-icon-inline-size);
	}

	.line-clamp-1 {
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
