---
import Comment from "@components/comment/index.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import SharePoster from "@components/misc/SharePoster.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { licenseConfig, shareConfig } from "@/config";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { profileConfig, siteConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import Encryptor from "@components/Encryptor.astro";
import PostHeader from "./PostHeader.astro";
import PostLastModified from "./PostLastModified.astro";
import PostNavigation from "./PostNavigation.astro";
import PostSupport from "./PostSupport.astro";
import { buildTocItems } from "@components/post-toc/toc-data";
import "./post-detail.css";
import type { PostDetailPageProps } from "./types";

const {
	id,
	title,
	description,
	author,
	lang,
	banner,
	header,
	cover,
	encryption,
	comment,
	license,
	navigation,
	support,
	canonicalUrl,
	canonicalOgSlug,
	Content,
	headings,
	lastModified,
	jsonLd,
	posterCoverUrl,
	posterAvatarUrl,
} = Astro.props as PostDetailPageProps;

const staticTocItems = encryption.enabled
	? []
	: buildTocItems(headings, {
			maxDepth: siteConfig.toc?.depth || 3,
			useJapaneseBadge: siteConfig.toc?.useJapaneseBadge || false,
		});
---

<MainGridLayout
	{banner}
	{title}
	{description}
	{lang}
	setOGTypeArticle={true}
	postSlug={canonicalOgSlug}
	canonicalUrl={canonicalUrl}
	headings={headings}
	layoutPolicy="post"
>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
	<PostSupport
		slot="support"
		headings={headings}
		tocItems={staticTocItems}
		support={support}
		deferTocHeadings={encryption.enabled}
	/>
	{
		!encryption.enabled && (
			<script
				id="post-toc-data"
				is:inline
				type="application/json"
				set:html={JSON.stringify(staticTocItems)}
			/>
		)
	}
		<div class="post-detail__shell flex relative">
			<div
				id="post-container"
				class="post-detail__article post-detail__surface ds-surface-content z-10"
				data-reading-title={title}
				data-reading-minutes={header.minutes}
			>
			<PostHeader post={header} />

			<!-- always show cover as long as it has one -->

			{
				cover && siteConfig.showCoverInContent && (
					<>
						<div class="mt-4" />
						<ImageWrapper
							id="post-cover"
							src={cover.src}
							basePath={cover.basePath}
							class="mb-8 rounded-xl banner-container"
						/>
					</>
				)
			}

			{
				encryption.enabled ? (
					<Encryptor password={encryption.password}>
						<Markdown class="post-detail__content mb-6 markdown-content">
							<Content />
						</Markdown>
					</Encryptor>
				) : (
					<Markdown class="post-detail__content mb-6 markdown-content">
						<Content />
					</Markdown>
				)
			}

			{
				shareConfig.enable && (
					<div
						id="share-component"
						class:list={[
							"p-6 bg-(--license-block-bg) rounded-xl mb-6",
							{ "encrypted-hidden": encryption.enabled },
						]}
					>
						<div class="post-detail__share-row flex flex-col items-center justify-between gap-4">
							<div class="flex items-center gap-3 flex-1">
								<div class="flex items-center justify-center h-12 w-12 rounded-lg bg-(--enter-btn-bg)">
									<Icon
										name="material-symbols:share"
										class="text-3xl text-(--primary)"
									/>
								</div>
								<div class="flex flex-col gap-1">
									<div class="text-[1.0rem] leading-tight text-75">
										{i18n(I18nKey.shareOnSocial)}
									</div>
									<p class="text-[0.8rem] leading-tight text-75">
										{i18n(I18nKey.shareOnSocialDescription)}
									</p>
								</div>
							</div>
							<div class="flex items-center gap-3">
								<SharePoster
									client:visible
									{title}
									author={author || profileConfig.name}
									description={description || ""}
									pubDate={formatDateToYYYYMMDD(header.published)}
									coverImage={posterCoverUrl}
									url={canonicalUrl}
									siteTitle={siteConfig.title}
									avatar={posterAvatarUrl}
								/>
							</div>
						</div>
					</div>
				)
			}

			{
				licenseConfig.enable && (
					<div
						id="license-component"
						class:list={[
							"encrypted-hidden-wrapper",
							{ "encrypted-hidden": encryption.enabled },
						]}
					>
						<License
							{title}
							{id}
							pubDate={header.published}
							{author}
							sourceLink={license.sourceLink}
							licenseName={license.licenseName}
							licenseUrl={license.licenseUrl}
							class="mb-6 rounded-xl license-container"
						/>
					</div>
				)
			}
		</div>
	</div>

	<!-- 评论 -->
	<Comment enabled={comment.enabled} path={comment.path} />

	{siteConfig.showLastModified && <PostLastModified {lastModified} />}

	<PostNavigation next={navigation.next} prev={navigation.prev} />
</MainGridLayout>
