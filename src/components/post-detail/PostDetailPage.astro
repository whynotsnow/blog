---
import Comment from "@components/comment/index.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import SharePoster from "@components/misc/SharePoster.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getFileDirFromPath } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig, shareConfig } from "@/config";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { profileConfig, siteConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import Encryptor from "@components/Encryptor.astro";
import PostHeader from "./PostHeader.astro";
import PostLastModified from "./PostLastModified.astro";
import PostNavigation from "./PostNavigation.astro";
import "./post-detail.css";
import { getContentStore } from "@/services/core/content-store";
import type { PostDetailPageProps } from "./types";

const {
	entry,
	Content,
	headings,
	isEncrypted,
	lastModified,
	jsonLd,
	posterCoverUrl,
	posterAvatarUrl,
} = Astro.props as PostDetailPageProps;
const store = await getContentStore();

---

<MainGridLayout
	banner={entry.data.image}
	title={entry.data.title}
	description={entry.data.description}
	lang={entry.data.lang}
	setOGTypeArticle={true}
	postSlug={entry.id}
	headings={headings}
	store={store}
	layoutPolicy="post"
>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
		<div class="post-detail__shell flex relative">
			<div
				id="post-container"
				class="post-detail__article post-detail__surface ds-surface-content z-10"
				data-reading-title={entry.data.title}
				data-reading-minutes={entry.meta.minutes}
			>
			<PostHeader {entry} />

			<!-- always show cover as long as it has one -->

			{
				entry.data.image && siteConfig.showCoverInContent && (
					<>
						<div class="mt-4" />
						<ImageWrapper
							id="post-cover"
							src={entry.data.image}
							basePath={getFileDirFromPath(entry.filePath || "")}
							class="mb-8 rounded-xl banner-container"
						/>
					</>
				)
			}

			{
				isEncrypted ? (
					<Encryptor password={entry.data.password}>
						<Markdown class="post-detail__content mb-6 markdown-content">
							<Content />
						</Markdown>
					</Encryptor>
				) : (
					<Markdown class="post-detail__content mb-6 markdown-content">
						<Content />
					</Markdown>
				)
			}

			{
				shareConfig.enable && (
					<div
						id="share-component"
						class:list={[
							"p-6 bg-(--license-block-bg) rounded-xl mb-6",
							{ "encrypted-hidden": isEncrypted },
						]}
					>
						<div class="post-detail__share-row flex flex-col items-center justify-between gap-4">
							<div class="flex items-center gap-3 flex-1">
								<div class="flex items-center justify-center h-12 w-12 rounded-lg bg-(--enter-btn-bg)">
									<Icon
										name="material-symbols:share"
										class="text-3xl text-(--primary)"
									/>
								</div>
								<div class="flex flex-col gap-1">
									<div class="text-[1.0rem] leading-tight text-75">
										{i18n(I18nKey.shareOnSocial)}
									</div>
									<p class="text-[0.8rem] leading-tight text-75">
										{i18n(I18nKey.shareOnSocialDescription)}
									</p>
								</div>
							</div>
							<div class="flex items-center gap-3">
								<SharePoster
									client:load
									title={entry.data.title}
									author={
										entry.data.author || profileConfig.name
									}
									description={entry.data.description || ""}
									pubDate={formatDateToYYYYMMDD(
										entry.data.published,
									)}
									coverImage={posterCoverUrl}
									url={Astro.url.toString()}
									siteTitle={siteConfig.title}
									avatar={posterAvatarUrl}
								/>
							</div>
						</div>
					</div>
				)
			}

			{
				licenseConfig.enable && (
					<div
						id="license-component"
						class:list={[
							"encrypted-hidden-wrapper",
							{ "encrypted-hidden": isEncrypted },
						]}
					>
						<License
							title={entry.data.title}
							id={entry.id}
							pubDate={entry.data.published}
							author={entry.data.author}
							sourceLink={entry.data.sourceLink}
							licenseName={entry.data.licenseName}
							licenseUrl={entry.data.licenseUrl}
							class="mb-6 rounded-xl license-container"
						/>
					</div>
				)
			}
		</div>
	</div>

	<!-- 评论 -->
	<Comment post={entry} />

	{siteConfig.showLastModified && <PostLastModified {lastModified} />}

	<PostNavigation
		nextSlug={entry.meta.nextSlug}
		nextTitle={entry.meta.nextTitle}
		prevSlug={entry.meta.prevSlug}
		prevTitle={entry.meta.prevTitle}
	/>
</MainGridLayout>
