---
import PostMetadata from "@components/PostMeta.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { buildCategoryItems, buildTagItems } from "@/services/core/inject";
import type { ListPost } from "@/services/core/types";
import { siteConfig } from "@/config";
import { Icon } from "astro-icon/components";

interface Props {
	entry: ListPost;
}

const { entry } = Astro.props;
const { words, minutes } = entry.meta;
---

<header class="post-detail__header">
	<div class="flex flex-row text-50 gap-5 mb-3 transition">
		<div class="flex flex-row items-center">
			<div class="transition h-6 w-6 rounded-md bg-(--line-divider) flex items-center justify-center mr-2">
				<Icon name="material-symbols:notes-rounded" />
			</div>
			<div class="text-sm">{words}{" " + i18n(I18nKey.wordsCount)}</div>
		</div>
		<div class="flex flex-row items-center">
			<div class="transition h-6 w-6 rounded-md bg-(--line-divider) flex items-center justify-center mr-2">
				<Icon name="material-symbols:schedule-outline-rounded" />
			</div>
			<div class="text-sm">
				{minutes}{" " + i18n(minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
			</div>
		</div>
	</div>

	<div class="relative">
		<h1
			data-pagefind-body
			data-pagefind-weight="10"
			data-pagefind-meta="title"
			class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-90 md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary) before:absolute before:top-3 before:-left-4.5"
		>
			{entry.data.title}
		</h1>
	</div>

	<PostMetadata
		className="mb-5"
		published={entry.data.published}
		updated={entry.data.updated}
		tags={buildTagItems(entry.data.tags)}
		category={buildCategoryItems(entry.data.category)}
		id={entry.id}
	/>
	{(!entry.data.image || !siteConfig.showCoverInContent) && (
		<div class="mt-4 border-(--line-divider) border-dashed border-b mb-5" />
	)}
</header>
