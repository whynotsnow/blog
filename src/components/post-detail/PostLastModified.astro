---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";

interface Props { lastModified: string }
const { lastModified } = Astro.props;
---

<div id="last-modified" data-last-modified={lastModified} data-prefix={i18n(I18nKey.lastModifiedPrefix)} data-year={i18n(I18nKey.year)} data-month={i18n(I18nKey.month)} data-day={i18n(I18nKey.day)} data-hour={i18n(I18nKey.hour)} data-minute={i18n(I18nKey.minute)} data-second={i18n(I18nKey.second)} hidden />
<aside class="post-detail__wide-block post-detail__aux-card post-detail__notice">
	<div class="flex items-center gap-3">
		<div class="flex items-center justify-center h-12 w-12 rounded-lg bg-(--enter-btn-bg)"><Icon name="material-symbols:history-rounded" class="text-3xl text-(--primary)" /></div>
		<div class="flex flex-col gap-1">
			<div id="modifiedtime" class="text-[1rem] leading-tight text-75" />
			<p class="text-[0.8rem] leading-tight text-75">{i18n(I18nKey.lastModifiedOutdated)}</p>
		</div>
	</div>
</aside>

<script is:inline>
	function updatePostModifiedTime() {
		const source = document.getElementById("last-modified");
		const target = document.getElementById("modifiedtime");
		if (!source || !target) return;
		const seconds = Math.max(0, Math.floor((Date.now() - new Date(source.dataset.lastModified).getTime()) / 1000));
		const days = Math.floor(seconds / 86400);
		const years = Math.floor(days / 365);
		const months = Math.floor((days % 365) / 30);
		const remainingDays = days % 30;
		const hours = Math.floor((seconds % 86400) / 3600);
		const minutes = Math.floor((seconds % 3600) / 60);
		const remainingSeconds = seconds % 60;
		const parts = [];
		if (years > 0) parts.push(`${years} ${source.dataset.year}`);
		if (months > 0) parts.push(`${months} ${source.dataset.month}`);
		if (remainingDays > 0) parts.push(`${remainingDays} ${source.dataset.day}`);
		parts.push(`${hours} ${source.dataset.hour}`);
		parts.push(`${String(minutes).padStart(2, "0")} ${source.dataset.minute}`);
		parts.push(`${String(remainingSeconds).padStart(2, "0")} ${source.dataset.second}`);
		target.textContent = `${source.dataset.prefix} ${parts.join(" ")}`;
	}
	updatePostModifiedTime();
	window.setInterval(updatePostModifiedTime, 1000);
</script>
