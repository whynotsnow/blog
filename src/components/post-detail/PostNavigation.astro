---
import type { PostNavigationLink } from "@/services/core/types";
import { Icon } from "astro-icon/components";

interface Props { next?: PostNavigationLink; prev?: PostNavigationLink }
const { next, prev } = Astro.props;
---

<nav class="post-detail__navigation post-detail__wide-block">
	{next && <a href={next.url} class="post-detail__navigation-link post-detail__navigation-link--next font-bold active:scale-95"><div class="btn-card rounded-2xl h-15 px-4 flex items-center justify-start! gap-4"><Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-(--primary)" /><div class="post-detail__navigation-title text-75">{next.title}</div></div></a>}
	{prev && <a href={prev.url} class="post-detail__navigation-link post-detail__navigation-link--prev font-bold active:scale-95"><div class="btn-card rounded-2xl h-15 px-4 flex items-center justify-end! gap-4"><div class="post-detail__navigation-title text-75">{prev.title}</div><Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-(--primary)" /></div></a>}
</nav>
