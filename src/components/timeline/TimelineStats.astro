---
import type { TimelinePageModel } from "@/services/timeline";

interface Props {
	model: TimelinePageModel;
}

const { model } = Astro.props;
---

<div class="timeline-stats grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
	<div
		class="bg-blue-500/10 dark:bg-blue-900/30 rounded-xl p-5 border border-blue-500/20 dark:border-blue-900/30 hover:shadow-lg transition-shadow duration-300"
	>
		<div class="timeline-stats__value font-bold text-blue-600 dark:text-blue-400 mb-1">
			{model.stats.total}
		</div>
		<div class="timeline-stats__label text-blue-600/70 dark:text-blue-400/70">
			{model.labels.total}
		</div>
	</div>
	<div
		class="bg-green-500/10 dark:bg-green-900/30 rounded-xl p-5 border border-green-500/20 dark:border-green-900/30 hover:shadow-lg transition-shadow duration-300"
	>
		<div class="timeline-stats__value font-bold text-green-600 dark:text-green-400 mb-1">
			{model.stats.byType.work}
		</div>
		<div class="timeline-stats__label text-green-600/70 dark:text-green-400/70">
			{model.labels.work}
		</div>
	</div>
	<div
		class="bg-purple-500/10 dark:bg-purple-900/30 rounded-xl p-5 border border-purple-500/20 dark:border-purple-900/30 hover:shadow-lg transition-shadow duration-300"
	>
		<div class="timeline-stats__value font-bold text-purple-600 dark:text-purple-400 mb-1">
			{model.stats.byType.project}
		</div>
		<div class="timeline-stats__label text-purple-600/70 dark:text-purple-400/70">
			{model.labels.projects}
		</div>
	</div>
	<div
		class="bg-orange-500/10 dark:bg-orange-900/30 rounded-xl p-5 border border-orange-500/20 dark:border-orange-900/30 hover:shadow-lg transition-shadow duration-300"
	>
		<div class="timeline-stats__value font-bold text-orange-600 dark:text-orange-400 mb-1">
			{model.workExperience.years}+
		</div>
		<div class="timeline-stats__label text-orange-600/70 dark:text-orange-400/70">
			{model.labels.experience}
		</div>
	</div>
</div>

<style>
	.timeline-stats {
		--timeline-stats-value-size: var(--text-list-title-size);
		--timeline-stats-label-size: var(--text-ui-size);
	}

	.timeline-stats__value {
		font-size: var(--timeline-stats-value-size);
	}

	.timeline-stats__label {
		font-size: var(--timeline-stats-label-size);
	}
</style>
