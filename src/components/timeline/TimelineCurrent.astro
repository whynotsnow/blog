---
import Icon from "@/components/misc/Icon.astro";
import type { TimelinePageModel } from "@/services/timeline";
import { getTimelineDuration, formatTimelineDate } from "@/services/timeline";

interface Props {
	model: TimelinePageModel;
}

const { model } = Astro.props;
---

{
	model.currentItems.length > 0 && (
		<div class="timeline-current mb-12">
			<h2 class="timeline-current__section-title font-bold text-black/90 dark:text-white/90 mb-6 flex items-center">
				<span class="w-3 h-3 rounded-full bg-green-500 mr-3" />
				{model.labels.current}
			</h2>
			<div class="grid grid-cols-1 gap-6">
				{model.currentItems.map((item) => (
					<div class="bg-transparent rounded-xl border border-black/10 dark:border-white/10 p-6 hover:shadow-lg transition-shadow duration-300">
						<div class="flex flex-col md:flex-row md:items-start gap-5">
							<div
								class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0"
								style={`background-color: ${item.color || "rgb(99 102 241)"}20`}
							>
								<Icon
									icon={item.typeIcon}
									class="timeline-current__icon"
									color={item.color || "rgb(99 102 241)"}
									fallback={item.title.charAt(0)}
									loading="eager"
								/>
							</div>
							<div class="flex-1">
								<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 mb-3">
									<div>
										<h3 class="timeline-current__item-title font-semibold text-black/90 dark:text-white/90 mb-1">
											{item.title}
										</h3>
										{item.organization && (
											<div class="timeline-current__meta text-black/70 dark:text-white/70">
												{item.organization}{" "}
												{item.position &&
													`• ${item.position}`}
											</div>
										)}
									</div>
									<span class="timeline-current__badge px-3 py-1.5 bg-green-600/20 text-green-700 dark:bg-green-900/30 dark:text-green-400 rounded-full self-start">
										{model.labels.current}
									</span>
								</div>

								{item.location && (
									<div class="timeline-current__meta flex items-center text-black/60 dark:text-white/60 mb-3">
										<span class="mr-2">📍</span>
										<span>{item.location}</span>
									</div>
								)}

								<p class="text-black/70 dark:text-white/70 mb-4">
									{item.description}
								</p>

								<div class="flex flex-wrap items-center gap-4 mb-4">
									<div class="timeline-current__meta text-black/70 dark:text-white/70">
										<span class="font-medium">
											{model.labels.startDate}:
										</span>{" "}
										{formatTimelineDate(item.startDate)}
									</div>
									<div class="timeline-current__meta text-black/70 dark:text-white/70">
										<span class="font-medium">
											{model.labels.duration}:
										</span>{" "}
										{getTimelineDuration(item.startDate)}
									</div>
								</div>

								{item.skills && item.skills.length > 0 && (
									<div class="flex flex-wrap gap-2 mb-4">
										{item.skills.map((skill) => (
											<span class="timeline-current__badge px-3 py-1.5 bg-indigo-600/20 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 rounded-full">
												{skill}
											</span>
										))}
									</div>
								)}

								{item.links && item.links.length > 0 && (
									<div class="flex flex-wrap gap-4 pt-2">
										{item.links.map((link) => (
											<a
												href={link.url}
												target="_blank"
												rel="noopener noreferrer"
												class="timeline-current__link text-indigo-600 dark:text-indigo-400 hover:underline font-medium flex items-center gap-1"
											>
												{link.type ===
													"certificate" && "🏆"}
												{link.type === "project" &&
													"🔗"}
												{link.type === "website" &&
													"🌐"}
												{link.name}
											</a>
										))}
									</div>
								)}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	)
}

<style>
	.timeline-current {
		--timeline-current-section-title-size: var(--text-section-title-size);
		--timeline-current-item-title-size: var(--text-card-title-size);
		--timeline-current-body-size: var(--text-ui-size);
		--timeline-current-badge-size: var(--text-caption-size);
		--timeline-current-icon-size: var(--text-icon-large-size);
	}

	.timeline-current__section-title {
		font-size: var(--timeline-current-section-title-size);
	}

	.timeline-current__item-title {
		font-size: var(--timeline-current-item-title-size);
	}

	.timeline-current__meta,
	.timeline-current__link {
		font-size: var(--timeline-current-body-size);
	}

	.timeline-current__badge {
		font-size: var(--timeline-current-badge-size);
	}

	.timeline-current__icon {
		font-size: var(--timeline-current-icon-size);
	}
</style>
