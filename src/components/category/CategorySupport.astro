---
import { Icon } from "astro-icon/components";
import type { CategoryPageProps } from "@/services/category-page";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

type Props = Pick<CategoryPageProps, "support">;

const { support } = Astro.props as Props;
const enabledModules = new Set(support.modules);
---

<aside class="category-support ds-stack" aria-label="分类上下文">
	{
		enabledModules.has("recentPosts") && support.recentPosts.length > 0 && (
			<section class="category-support__panel ds-surface-card">
				<h2 class="category-support__heading">
					<Icon name="material-symbols:update-rounded" />
					最近更新
				</h2>
				<div class="category-support__post-list">
					{support.recentPosts.map((post) => (
						<a href={post.url} class="category-support__post">
							<strong>{post.title}</strong>
							<span>{formatDateToYYYYMMDD(post.published)}</span>
						</a>
					))}
				</div>
			</section>
		)
	}

	{
		enabledModules.has("tags") && support.tags.length > 0 && (
			<section class="category-support__panel ds-surface-card">
				<h2 class="category-support__heading">
					<Icon name="material-symbols:tag-rounded" />
					热门标签
				</h2>
				<div class="category-support__tags">
					{support.tags.map((tag) => (
						<a href={tag.url} class="category-support__tag">
							<span>{tag.name}</span>
							<small>{tag.count}</small>
						</a>
					))}
				</div>
			</section>
		)
	}

	{
		enabledModules.has("categories") && support.categories.length > 0 && (
			<section class="category-support__panel ds-surface-card">
				<h2 class="category-support__heading">
					<Icon name="material-symbols:category-outline-rounded" />
					其他分类
				</h2>
				<div class="category-support__links">
					{support.categories.map((category) => (
						<a href={category.url} class="category-support__link">
							<span>{category.name}</span>
							<small>{category.count}</small>
						</a>
					))}
				</div>
			</section>
		)
	}
</aside>

<style>
	.category-support {
		--stack-space: var(--space-grid-gap);
		--category-support-heading-size: var(--text-ui-emphasis-size);
		--category-support-heading-icon-size: var(--text-icon-inline-size);
		--category-support-item-title-size: var(--text-ui-size);
	}

	@media (max-width: 879px) {
		.category-support {
			display: none;
		}
	}

	.category-support__panel {
		padding: var(--space-card);
	}

	.category-support__heading {
		display: flex;
		align-items: center;
		gap: var(--size-2);
		margin-bottom: var(--size-3);
		color: var(--text-primary);
		font-size: var(--category-support-heading-size);
		font-weight: 800;
	}

	.category-support__heading :global(svg) {
		color: var(--accent);
		font-size: var(--category-support-heading-icon-size);
	}

	.category-support__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--size-2);
	}

	.category-support__post-list,
	.category-support__links {
		display: grid;
		gap: var(--size-2);
	}

	.category-support__post,
	.category-support__link,
	.category-support__tag {
		display: inline-flex;
		max-width: 100%;
		align-items: center;
		gap: var(--size-1);
		padding: 0.4rem 0.55rem;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		color: var(--text-secondary);
		font-size: var(--text-meta-size);
		font-weight: 700;
		line-height: 1;
		transition:
			color var(--motion-fast) var(--motion-ease-standard),
			border-color var(--motion-fast) var(--motion-ease-standard);
	}

	.category-support__tag:hover {
		border-color: var(--border-strong);
		color: var(--accent);
	}

	.category-support__post,
	.category-support__link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--size-2);
		padding: var(--size-3);
		line-height: 1.35;
	}

	.category-support__post strong,
	.category-support__link span,
	.category-support__tag span {
		overflow: hidden;
		color: var(--text-primary);
		font-size: var(--category-support-item-title-size);
		font-weight: 800;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.category-support__post:hover strong,
	.category-support__link:hover span {
		color: var(--accent);
	}

	.category-support__post span,
	.category-support__link small,
	.category-support__tag small {
		color: var(--text-muted);
		font-size: var(--text-meta-size);
	}
</style>
