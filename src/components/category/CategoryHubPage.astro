---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import PostGrid from "@components/post/PostGrid.astro";
import type { CategoryHubPageViewModel } from "@/services/category-hub";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

interface Props {
	model: CategoryHubPageViewModel;
}

const { model } = Astro.props;
---

<div
	id="page-content"
	class="listing-page category-hub-page ds-stack w-full"
	style="--stack-space: var(--space-grid-gap);"
	data-category-hub
	data-category-hub-view={model.activeView}
>
	<section
		class="category-hub-hero ds-surface-card ds-stack"
		style="--stack-space: var(--space-cluster);"
		aria-labelledby="category-hub-title"
	>
		<nav class="category-hub-tabs ds-cluster" aria-label="分类视图">
			{
				model.tabs.map((tab) => (
					<a
						href={tab.url}
						class:list={[
							"category-hub-tab",
							tab.id === model.activeView &&
								"category-hub-tab--active",
						]}
						aria-current={
							tab.id === model.activeView ? "page" : undefined
						}
					>
						{tab.label}
					</a>
				))
			}
		</nav>
		<div>
			<h1 id="category-hub-title" class="category-hub-title">
				{model.title}
			</h1>
			<p class="category-hub-description">{model.description}</p>
		</div>
	</section>

	{
		model.activeView === "all" ? (
			<section class="category-hub-grid" aria-label="全部分类">
				{model.categories.map((category) => (
					<article
						class="category-hub-card ds-surface-card"
						data-category-card={category.slug}
						data-has-cover={Boolean(category.image?.src)}
					>
						<a
							class="category-hub-card__cover"
							href={category.url}
							aria-label={category.name}
						>
							<div class="category-hub-card__cover-overlay transition" />
							<div class="category-hub-card__cover-enter">
								<Icon
									name="material-symbols:chevron-right-rounded"
									class="category-hub-card__cover-enter-icon transition"
								/>
							</div>
							{
								category.image?.src ? (
									<ImageWrapper
										src={category.image.src}
										alt={category.image.alt ?? category.name}
										position={category.image.position}
										class="category-hub-card__image"
									/>
								) : (
									<div class="category-hub-card__cover-placeholder" aria-hidden="true">
										<Icon
											name="material-symbols:category-outline-rounded"
											class="category-hub-card__cover-placeholder-icon"
										/>
									</div>
								)
							}
						</a>
						<div class="category-hub-card__content">
							<a class="category-hub-card__main" href={category.url}>
								<span class="category-hub-card__name">
									{category.name}
								</span>
								<span class="category-hub-card__count">
									{category.count} 篇
								</span>
							</a>
							<div class="category-hub-card__meta">
								<span class="category-hub-card__meta-item">
									<Icon name="material-symbols:article-outline-rounded" />
									{category.count} 篇文章
								</span>
								<span class="category-hub-card__meta-item">
									<Icon name="material-symbols:tag-rounded" />
									{category.tagCount} 个标签
								</span>
								{
									category.updated && (
										<span class="category-hub-card__meta-item">
											<Icon name="material-symbols:update-rounded" />
											{formatDateToYYYYMMDD(category.updated)}
										</span>
									)
								}
							</div>
							{
								category.description && (
									<p class="category-hub-card__description">
										{category.description}
									</p>
								)
							}
							{category.tags.length > 0 && (
								<div class="category-hub-card__tags">
									{category.tags.map((tag) => (
										<a
											href={tag.url}
											class="category-hub-card__tag"
											title={tag.name}
										>
											<span># {tag.name}</span>
										</a>
									))}
								</div>
							)}
							{category.recentPosts.length > 0 && (
								<div class="category-hub-card__posts">
									<div class="category-hub-card__posts-heading">
										<Icon name="material-symbols:update-rounded" />
										最近更新
									</div>
									{category.recentPosts.slice(0, 2).map((post) => (
										<a href={post.url} class="category-hub-card__post">
											{post.title}
										</a>
									))}
								</div>
							)}
						</div>
					</article>
				))}
			</section>
		) : (
			<PostGrid
				posts={model.posts}
				id={`category-${model.activeView}-post-list`}
			/>
		)
	}
</div>

<style>
	.category-hub-page {
		--category-hub-tab-size: var(--text-ui-size);
		--category-hub-description-size: var(--text-meta-size);
		--category-hub-card-title-size: var(--text-section-title-size);
		--category-hub-card-count-size: var(--text-caption-size);
		--category-hub-card-tag-size: var(--text-caption-size);
		--category-hub-card-post-size: var(--text-meta-size);
		--category-hub-card-meta-size: var(--text-caption-size);
		--category-hub-card-cover-icon-size: var(--post-card-cover-icon-size);
		--category-hub-card-cover-min-size: var(--post-card-cover-min-size);
		--category-hub-card-cover-max-size: var(--post-card-cover-max-size);
		--category-hub-card-section-gap: var(--post-card-section-gap);
		--category-hub-card-tag-block-size: var(--post-card-tag-block-size);
		--category-hub-card-tag-gap: var(--post-card-tag-gap);
	}

	.category-hub-hero {
		padding: clamp(1rem, 2cqi, 1.25rem);
	}

	.category-hub-tabs {
		--cluster-space: var(--size-2);
	}

	.category-hub-tab {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.25rem;
		padding: 0.45rem 0.8rem;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		color: var(--text-secondary);
		font-size: var(--category-hub-tab-size);
		font-weight: 700;
		line-height: 1.2;
		transition:
			border-color var(--motion-fast) var(--motion-ease-standard),
			color var(--motion-fast) var(--motion-ease-standard),
			background var(--motion-fast) var(--motion-ease-standard);
	}

	.category-hub-tab:hover {
		border-color: var(--border-strong);
		color: var(--accent);
	}

	.category-hub-tab--active {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--text-on-accent);
	}

	.category-hub-tab--active:hover {
		border-color: var(--accent);
		color: var(--text-on-accent);
	}

	.category-hub-title {
		color: var(--text-primary);
		font-family: var(--font-heading);
		font-size: var(--post-card-title-size);
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0;
	}

	.category-hub-description {
		margin-top: 0.35rem;
		color: var(--text-secondary);
		font-size: var(--category-hub-description-size);
		line-height: 1.6;
	}

	.category-hub-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-grid-gap);
	}

	.category-hub-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-lg);
		box-shadow: none;
		transition:
			border-color var(--motion-fast) var(--motion-ease-standard),
			background var(--motion-fast) var(--motion-ease-standard);
	}

	.category-hub-card:hover {
		border-color: var(--border-default);
		background: color-mix(in srgb, var(--surface-card) 92%, var(--accent) 8%);
	}

	.category-hub-card__cover {
		position: relative;
		display: block;
		flex: none;
		order: -1;
		width: 100%;
		height: clamp(
			var(--category-hub-card-cover-min-size),
			56.25cqi,
			var(--category-hub-card-cover-max-size)
		);
		overflow: hidden;
	}

	.category-hub-card__cover-overlay,
	.category-hub-card__cover-enter {
		position: absolute;
		inset: 0;
		z-index: 10;
		pointer-events: none;
	}

	.category-hub-card__cover-enter {
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.category-hub-card__cover-enter-icon {
		color: white;
		font-size: var(--category-hub-card-cover-icon-size);
		opacity: 0;
		transform: scale(0.5);
	}

	.category-hub-card__cover:hover .category-hub-card__cover-overlay {
		background: rgb(0 0 0 / 30%);
	}

	.category-hub-card__cover:hover .category-hub-card__cover-enter-icon {
		opacity: 1;
		transform: scale(1);
	}

	.category-hub-card__cover-placeholder {
		display: flex;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(
				circle at 25% 20%,
				color-mix(in srgb, var(--accent) 24%, transparent),
				transparent 42%
			),
			linear-gradient(145deg, var(--surface-raised), var(--surface-card));
	}

	.category-hub-card__cover-placeholder-icon {
		color: var(--accent);
		font-size: var(--category-hub-card-cover-icon-size);
	}

	.category-hub-card__image {
		width: 100%;
		height: 100%;
	}

	.category-hub-card__content {
		display: flex;
		flex: none;
		flex-direction: column;
		width: 100%;
		padding: var(--post-card-content-padding);
	}

	.category-hub-card__main {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: var(--category-hub-card-section-gap);
		color: var(--text-primary);
	}

	.category-hub-card__main:hover .category-hub-card__name {
		color: var(--accent);
	}

	.category-hub-card__name {
		min-width: 0;
		overflow: hidden;
		font-family: var(--font-heading);
		font-size: var(--category-hub-card-title-size);
		font-weight: 800;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color var(--motion-fast) var(--motion-ease-standard);
	}

	.category-hub-card__count {
		flex-shrink: 0;
		padding: 0.2rem 0.5rem;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface-overlay) 88%, transparent);
		color: var(--accent);
		font-size: var(--category-hub-card-count-size);
		font-weight: 700;
		line-height: 1.25;
	}

	.category-hub-card__meta {
		display: flex;
		flex-wrap: nowrap;
		gap: var(--category-hub-card-tag-gap);
		block-size: 1.25rem;
		margin-bottom: var(--category-hub-card-section-gap);
		overflow: hidden;
		color: var(--text-muted);
		font-size: var(--category-hub-card-meta-size);
		line-height: 1.25rem;
	}

	.category-hub-card__meta-item {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.25rem;
		white-space: nowrap;
	}

	.category-hub-card__meta-item :global(svg) {
		flex: none;
		font-size: var(--text-icon-inline-size);
	}

	.category-hub-card__description {
		display: -webkit-box;
		block-size: 3.2em;
		margin-bottom: var(--category-hub-card-section-gap);
		overflow: hidden;
		color: var(--text-secondary);
		font-size: var(--category-hub-card-post-size);
		line-height: 1.6;
		overflow-wrap: anywhere;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.category-hub-card__tags {
		display: flex;
		flex-wrap: wrap;
		block-size: calc(
			2 * var(--category-hub-card-tag-block-size) +
				var(--category-hub-card-tag-gap)
		);
		align-content: flex-start;
		gap: var(--category-hub-card-tag-gap);
		margin-bottom: var(--category-hub-card-section-gap);
		overflow: clip;
		font-size: var(--category-hub-card-tag-size);
	}

	.category-hub-card__tag {
		display: flex;
		flex: 0 1 auto;
		min-width: 0;
		max-width: 100%;
		height: var(--category-hub-card-tag-block-size);
		align-items: center;
		padding-inline: 0.5rem;
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--surface-raised) 84%, transparent);
		color: var(--text-secondary);
		font-size: inherit;
		font-weight: 700;
		line-height: 1.2;
		transition:
			color var(--motion-fast) var(--motion-ease-standard),
			background var(--motion-fast) var(--motion-ease-standard);
	}

	.category-hub-card__tag span {
		display: block;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.category-hub-card__tag:hover {
		background: color-mix(in srgb, var(--surface-raised) 72%, var(--accent) 12%);
		color: var(--accent);
	}

	.category-hub-card__posts {
		display: grid;
		gap: 0.45rem;
		padding-top: var(--category-hub-card-section-gap);
		border-top: 1px solid var(--border-subtle);
	}

	.category-hub-card__posts-heading {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--text-muted);
		font-size: var(--category-hub-card-count-size);
		font-weight: 800;
		line-height: 1.25;
	}

	.category-hub-card__posts-heading :global(svg) {
		font-size: var(--text-icon-inline-size);
	}

	.category-hub-card__post {
		color: var(--text-secondary);
		font-size: var(--category-hub-card-post-size);
		font-weight: 650;
		line-height: 1.35;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.category-hub-card__post:hover {
		color: var(--accent);
	}

	@container post-feed (min-width: 608px) {
		.category-hub-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@container post-feed (min-width: 932px) {
		.category-hub-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
