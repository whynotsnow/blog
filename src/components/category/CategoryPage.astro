---
import Pagination from "@components/control/Pagination.astro";
import PostGrid from "@components/post/PostGrid.astro";
import type { CategoryPageProps } from "@/services/category-page";
import CategoryPostListClient from "./CategoryPostListClient.svelte";

type Props = CategoryPageProps;

const { posts, allPosts, page, categories, categorySlug } = Astro.props;
---

<CategoryPostListClient
	client:load
	posts={allPosts}
	{categories}
	{categorySlug}
	resultCount={page.total}
>
	<PostGrid posts={posts} id="post-list-container" />
	<Pagination page={page} class="mx-auto" style={`animation-delay: calc(var(--content-delay) + ${page.data.length * 50}ms)`} />
</CategoryPostListClient>
