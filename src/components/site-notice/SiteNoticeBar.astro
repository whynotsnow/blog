---
import { Icon } from "astro-icon/components";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { SiteNoticeViewModel } from "@/services/site-notice";
import "./site-notice-bar.css";

interface Props {
	notice: SiteNoticeViewModel;
}

const { notice } = Astro.props;
const hasMultipleNotices = notice.notices.length > 1;
---

<aside
	class="site-notice-bar"
	aria-label={i18n(I18nKey.siteNotice)}
	data-site-notice-region
	data-auto-rotate={String(notice.autoRotate)}
	data-rotation-interval={notice.rotationIntervalMs}
>
	<div class="site-notice-bar__viewport" data-site-notice-viewport>
		{notice.notices.map((item, index) => (
			<article
				class="site-notice-bar__item"
				data-site-notice-item
				data-site-notice={index === 0 ? "" : undefined}
				data-notice-id={item.id}
				data-status={item.status}
				data-state={index === 0 ? "active" : "inactive"}
				aria-hidden={index === 0 ? "false" : "true"}
			>
				<div class="site-notice-bar__layout ds-cluster">
					<Icon
						name={item.icon}
						class="site-notice-bar__icon"
						aria-hidden="true"
					/>

					<div class="site-notice-bar__message">
						{item.title && (
							<strong class="site-notice-bar__title">{item.title}</strong>
						)}
						<span>{item.content}</span>
					</div>

					{item.action && (
						<a
							class="site-notice-bar__action"
							href={item.action.href}
							target={item.action.external ? "_blank" : undefined}
							rel={item.action.external ? "noopener noreferrer" : undefined}
						>
							{item.action.label}
							<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
						</a>
					)}

					{item.dismissible && (
						<button
							type="button"
							class="site-notice-bar__icon-button"
							data-site-notice-dismiss
							aria-label={i18n(I18nKey.siteNoticeDismiss)}
						>
							<Icon name="material-symbols:close-rounded" aria-hidden="true" />
						</button>
					)}
				</div>
			</article>
		))}
	</div>

	{hasMultipleNotices && (
		<div class="site-notice-bar__controls">
			<button
				type="button"
				class="site-notice-bar__icon-button"
				data-site-notice-previous
				aria-label={i18n(I18nKey.siteNoticePrevious)}
			>
				<Icon name="material-symbols:keyboard-arrow-up-rounded" aria-hidden="true" />
			</button>
			<span class="site-notice-bar__counter" aria-live="polite">
				<span data-site-notice-index>1</span>/{notice.notices.length}
			</span>
			<button
				type="button"
				class="site-notice-bar__icon-button"
				data-site-notice-next
				aria-label={i18n(I18nKey.siteNoticeNext)}
			>
				<Icon name="material-symbols:keyboard-arrow-down-rounded" aria-hidden="true" />
			</button>
		</div>
	)}
</aside>

<script>
	import "./site-notice-client";
</script>
