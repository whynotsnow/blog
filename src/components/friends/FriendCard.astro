---
import type { FriendItem } from "../../data/friends";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";

interface Props {
	friend: FriendItem;
}

const { friend } = Astro.props;
const hostname = new URL(friend.siteurl).hostname;
---

<article
	class="friend-card group relative overflow-hidden rounded-xl border border-(--border-subtle) bg-transparent transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
	data-title={friend.title.toLowerCase()}
	data-desc={friend.desc.toLowerCase()}
	data-tags={friend.tags.join(",")}
>
	<div class="friend-card__body">
		<div class="friend-card__header">
			<div class="friend-card__avatar">
				<img
					src={friend.imgurl}
					alt={friend.title}
					class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
					loading="lazy"
				/>
			</div>

			<div class="min-w-0 flex-1">
				<h2 class="friend-card__title">
					{friend.title}
				</h2>
				<a
					href={friend.siteurl}
					target="_blank"
					rel="noopener noreferrer"
					class="friend-card__host"
				>
					{hostname}
				</a>
			</div>
		</div>

		<p class="friend-card__description">
			{friend.desc}
		</p>

		<div class="friend-card__tags">
			{
				friend.tags.map((tag) => (
					<span class="friend-card__tag">
						{tag}
					</span>
				))
			}
		</div>

		<div class="friend-card__actions">
			<a
				href={friend.siteurl}
				target="_blank"
				rel="noopener noreferrer"
				class="friend-card__visit"
			>
				<svg
					class="h-4 w-4"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"
					></path>
				</svg>
				{i18n(I18nKey.friendsVisit)}
			</a>
			<button
				class="copy-link-btn friend-card__copy"
				data-url={friend.siteurl}
				title={i18n(I18nKey.friendsCopyLink)}
			>
				<svg
					class="h-4 w-4"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M8 16H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2m-6 12h8a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2z"
					></path>
				</svg>
			</button>
		</div>
	</div>

	<div class="friend-card__hover-layer"></div>
</article>

<style>
	.friend-card {
		animation: friend-card-enter 0.5s ease-out forwards;
		opacity: 0;
	}

	.friend-card.filtered-out {
		display: none;
	}

	.friend-card:nth-child(1) {
		animation-delay: 0.05s;
	}

	.friend-card:nth-child(2) {
		animation-delay: 0.1s;
	}

	.friend-card:nth-child(3) {
		animation-delay: 0.15s;
	}

	.friend-card:nth-child(4) {
		animation-delay: 0.2s;
	}

	.friend-card:nth-child(5) {
		animation-delay: 0.25s;
	}

	.friend-card:nth-child(6) {
		animation-delay: 0.3s;
	}

	.friend-card__body {
		position: relative;
		z-index: 1;
		padding: 1.5rem;
	}

	.friend-card__header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.friend-card__avatar {
		width: 4rem;
		height: 4rem;
		flex-shrink: 0;
		overflow: hidden;
		border-radius: 0.75rem;
		background: var(--surface-raised);
		outline: 2px solid transparent;
	}

	.friend-card__title {
		overflow: hidden;
		margin-bottom: 0.25rem;
		color: var(--text-primary);
		font-size: var(--text-card-title-size);
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.friend-card:hover .friend-card__title {
		color: var(--accent);
	}

	.friend-card__host {
		display: block;
		overflow: hidden;
		color: var(--text-muted);
		font-size: var(--text-caption-size);
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.friend-card__host:hover {
		color: var(--accent);
	}

	.friend-card__description {
		display: -webkit-box;
		min-height: 2.5rem;
		margin-bottom: 1rem;
		overflow: hidden;
		color: var(--text-secondary);
		font-size: var(--text-ui-size);
		line-height: 1.45;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.friend-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.friend-card__tag {
		border-radius: 0.375rem;
		padding: 0.25rem 0.5rem;
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		color: var(--accent);
		font-size: var(--text-caption-size);
		font-weight: 500;
	}

	.friend-card__actions {
		display: flex;
		gap: 0.5rem;
	}

	.friend-card__visit,
	.friend-card__copy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.5rem;
		font-size: var(--text-ui-size);
		font-weight: 500;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.friend-card__visit {
		flex: 1 1 auto;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--accent);
		color: var(--text-on-accent);
	}

	.friend-card__visit:hover {
		background: var(--accent-hover);
	}

	.friend-card__copy {
		padding: 0.5rem 0.75rem;
		background: var(--btn-regular-bg);
		color: var(--text-secondary);
	}

	.friend-card__copy:hover {
		background: var(--btn-regular-bg-hover);
	}

	.friend-card__visit:active,
	.friend-card__copy:active {
		transform: scale(0.95);
	}

	.friend-card__hover-layer {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom right,
			color-mix(in srgb, var(--accent) 5%, transparent),
			transparent
		);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.friend-card:hover .friend-card__hover-layer {
		opacity: 1;
	}

	@keyframes friend-card-enter {
		from {
			opacity: 0;
			transform: translateY(20px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
