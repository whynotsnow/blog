---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config";
import { buildTocItems } from "./toc-data";
import { renderDesktopTocShell } from "./toc-render";

export interface Props {
	class?: string;
	headings: MarkdownHeading[];
	deferHeadings?: boolean;
}

const { headings = [], deferHeadings = false } = Astro.props;
const className = Astro.props.class;
const tocItems = deferHeadings
	? []
	: buildTocItems(headings, {
			maxDepth: siteConfig.toc?.depth || 3,
			useJapaneseBadge: siteConfig.toc?.useJapaneseBadge || false,
		});
const tocItemsJson = JSON.stringify(tocItems).replaceAll("<", "\\u003c");
---

<table-of-contents class:list={[className, "group hide-scrollbar"]} id="toc">
	<script
		is:inline
		type="application/json"
		data-toc-items
		set:html={tocItemsJson}
	/>
	<Fragment set:html={renderDesktopTocShell(tocItems)} />
	<div
		id="active-indicator"
		style="opacity: 0"
		class="-z-10 absolute bg-(--toc-btn-hover) left-0 right-0 rounded-xl toc-active-indicator group-hover:bg-transparent border-2 border-(--toc-btn-hover) group-hover:border-(--toc-btn-active) border-dashed"
	>
	</div>
</table-of-contents>

<script>
	import { buildTocItems, collectTocHeadings } from "./toc-data";
	import {
		TOC_SCROLL_OFFSET,
		TocActiveTracker,
		findHeadingById,
		getPostContentRoot,
		getTocOptions,
		onPostTocRefresh,
		type TocItem,
	} from "./toc-runtime";
	import { renderDesktopTocShell } from "./toc-render";
	import {
		resolveDesktopTocViewState,
		type DesktopTocTransitionType,
		type DesktopTocViewState,
	} from "./toc-desktop-state";
	import { DesktopTocPresenter } from "./toc-desktop-presenter";

	class TableOfContents extends HTMLElement {
		tocEl: HTMLElement | null = null;
		headingIdxMap = new Map<string, number>();
		tocItems: TocItem[] = [];
		headings: HTMLElement[] = [];
		activeTracker = new TocActiveTracker();
		activeIndicator: HTMLElement | null = null;
		viewportState: DesktopTocViewState | null = null;
		presenter: DesktopTocPresenter | null = null;
		lastScrollY = 0;
		scrollRaf = 0;
		layoutMeasureRaf = 0;
		contentResizeObserver: ResizeObserver | null = null;
		initialized = false;

		update = (reason?: DesktopTocTransitionType) => {
			requestAnimationFrame(() => {
				const currentIndex = this.getCurrentHeadingIndex();
				const nextState = this.resolveViewportState(
					currentIndex,
					reason,
				);
				this.viewportState = nextState;
				this.presenter?.apply(nextState);
			});
		};

		handleScroll = () => {
			const currentScrollY = window.scrollY;
			this.lastScrollY = currentScrollY;
			if (this.scrollRaf) return;
			this.scrollRaf = requestAnimationFrame(() => {
				this.scrollRaf = 0;
				this.update();
			});
		};

		handleLayoutResize = () => {
			if (this.layoutMeasureRaf) return;
			this.layoutMeasureRaf = requestAnimationFrame(() => {
				this.layoutMeasureRaf = 0;
				this.activeTracker.measure();
				this.update("layout-remeasure");
			});
		};

		getCurrentHeadingIndex() {
			const stickySupport =
				document.querySelector<HTMLElement>(".post-support");
			const stickyTop = stickySupport
				? Number.parseFloat(getComputedStyle(stickySupport).top)
				: Number.NaN;
			const targetTop = Number.isFinite(stickyTop)
				? stickyTop + 24
				: 120;
			return this.activeTracker.update(window.scrollY, targetTop);
		}

		resolveRootsOnly(currentIndex: number) {
			if (!this.activeTracker.nodes.length) return true;
			if (window.scrollY <= 1 || currentIndex < 0) return true;

			if (
				window.scrollY + window.innerHeight >=
					document.documentElement.scrollHeight - 1 &&
				this.activeTracker.scrollDirection !== "up"
			) {
				return true;
			}

			return false;
		}

		resolveViewportState(
			currentIndex: number,
			reason?: DesktopTocTransitionType,
			options: { suppressHighlight?: boolean } = {},
		) {
			const rootsOnly = this.resolveRootsOnly(currentIndex);
			return resolveDesktopTocViewState({
				graph: this.activeTracker.graph,
				activeIndex: currentIndex,
				previous: this.viewportState,
				scrollDirection: this.activeTracker.scrollDirection,
				rootsOnly,
				suppressHighlight: options.suppressHighlight,
				reason,
			});
		}

		readTocItems() {
			const dataElement = this.querySelector<HTMLScriptElement>(
				"script[data-toc-items]",
			);
			if (!dataElement?.textContent) return [];
			try {
				return JSON.parse(dataElement.textContent) as TocItem[];
			} catch {
				return [];
			}
		}

		handleAnchorClick = (event: Event) => {
			const anchor = event
				.composedPath()
				.find((element) => element instanceof HTMLAnchorElement);

			if (anchor) {
				event.preventDefault(); // 阻止默认的锚点跳转

				const id = decodeURIComponent(anchor.hash?.substring(1));
				const targetElement = findHeadingById(id);

				if (targetElement) {
					// 计算目标位置，与移动端保持一致
					const targetTop =
						targetElement.getBoundingClientRect().top +
						window.scrollY -
						TOC_SCROLL_OFFSET;

					// 使用与移动端相同的滚动方式
					window.scrollTo({
						top: targetTop,
						behavior: "smooth",
					});
				}

				const idx = this.headingIdxMap.get(id);
				if (idx !== undefined) {
					this.update("anchor-jump");
				}
			}
		};

		getContentRoot() {
			return getPostContentRoot();
		}

		resetRuntimeState() {
			if (this.initialized) {
				this.tocEl?.removeEventListener(
					"click",
					this.handleAnchorClick,
				);
				window.removeEventListener("scroll", this.handleScroll);
				window.removeEventListener("resize", this.handleLayoutResize);
				this.contentResizeObserver?.disconnect();
				if (this.scrollRaf) cancelAnimationFrame(this.scrollRaf);
				if (this.layoutMeasureRaf) cancelAnimationFrame(this.layoutMeasureRaf);
				this.presenter?.dispose();
			}
			this.headingIdxMap.clear();
			this.tocItems = [];
			this.headings = [];
			this.activeTracker.setState([], []);
			this.viewportState = null;
			this.presenter = null;
			this.scrollRaf = 0;
			this.layoutMeasureRaf = 0;
			this.contentResizeObserver = null;
			this.initialized = false;
		}

		connectedCallback() {
			// 优先监听动画结束，兜底定时初始化，确保二次刷新也能正常显示 TOC
			const element =
				document.querySelector(".custom-md") ||
				document.querySelector(".prose") ||
				document.querySelector(".markdown-content");
			let initialized = false;
			const tryInit = () => {
				if (!initialized) {
					initialized = true;
					this.init();
				}
			};
			if (element) {
				element.addEventListener("animationend", tryInit, {
					once: true,
				});
				tryInit();
				// 兜底：无论动画是否触发，300ms后强制初始化一次
				setTimeout(tryInit, 300);
			} else {
				// 没有动画元素，直接初始化，兜底再延迟一次
				tryInit();
				setTimeout(tryInit, 300);
			}
		}

		init() {
			this.resetRuntimeState();

			this.tocEl =
				this.closest<HTMLElement>(".post-support__toc-body") ?? this;

			this.tocEl.addEventListener("click", this.handleAnchorClick, {
				capture: true,
			});

			this.activeIndicator =
				this.querySelector<HTMLElement>("#active-indicator");

			this.tocItems = this.readTocItems();

			this.initialized = true;
			if (this.tocItems.length === 0) return;

			this.headings = new Array(this.tocItems.length);
			const contentRoot = this.getContentRoot();
			for (let i = 0; i < this.tocItems.length; i++) {
				const id = this.tocItems[i].id;
				const heading = Array.from(
					contentRoot?.querySelectorAll<HTMLElement>(
						"h1, h2, h3, h4, h5, h6",
					) ?? [],
				).find((element) => element.id === id);
				if (heading instanceof HTMLElement) {
					this.headings[i] = heading;
					this.headingIdxMap.set(id, i);
				}
			}
			this.activeTracker.setState(this.tocItems, this.headings);
			this.presenter = new DesktopTocPresenter({
				host: this,
				scrollRoot: this.tocEl,
				indicator: this.activeIndicator,
				graph: this.activeTracker.graph,
			});
			this.viewportState = this.resolveViewportState(
				this.activeTracker.activeIndex,
				"init",
			);
			this.lastScrollY = window.scrollY;

			window.addEventListener("scroll", this.handleScroll, {
				passive: true,
			});
			window.addEventListener("resize", this.handleLayoutResize, {
				passive: true,
			});
			if (contentRoot && "ResizeObserver" in window) {
				this.contentResizeObserver = new ResizeObserver(
					this.handleLayoutResize,
				);
				this.contentResizeObserver.observe(contentRoot);
			}

			this.update("init");
		}

		refreshRuntimeHeadings(root?: Element) {
			this.regenerateTOC(0, root);
			this.init();
		}

		regenerateTOC(retryCount = 0, root?: Element) {
			// 检查是否为文章页面
			const isPostPage =
				window.location.pathname.includes("/posts/") ||
				document.querySelector(".custom-md, .markdown-content") !==
					null;
			if (!isPostPage) {
				// 如果不是文章页面，隐藏TOC
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			// 从当前页面重新获取标题
			const contentRoot = root || this.getContentRoot();
			if (!contentRoot) {
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			const headings = collectTocHeadings(contentRoot);
			// 如果没有标题，延迟重试最多3次
			if (headings.length === 0 && retryCount < 3) {
				setTimeout(
					() => this.regenerateTOC(retryCount + 1, root),
					120,
				);
				return;
			}
			if (headings.length === 0) {
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			const tocItems = buildTocItems(headings, getTocOptions());
			const tocItemsJson = JSON.stringify(tocItems).replaceAll(
				"<",
				"\\u003c",
			);
			const tocHTML = renderDesktopTocShell(tocItems);
			this.innerHTML =
				'<scr' +
				`ipt type="application/json" data-toc-items>${tocItemsJson}</scr` +
				"ipt>" +
				tocHTML +
				'<div id="active-indicator" style="opacity: 0" class="-z-10 absolute bg-(--toc-btn-hover) left-0 right-0 rounded-xl toc-active-indicator group-hover:bg-transparent border-2 border-(--toc-btn-hover) group-hover:border-(--toc-btn-active) border-dashed"></div>';
			this.dataset.loaded = "true";
		}

		disconnectedCallback() {
			this.tocEl?.removeEventListener("click", this.handleAnchorClick);
			window.removeEventListener("scroll", this.handleScroll);
			window.removeEventListener("resize", this.handleLayoutResize);
			this.contentResizeObserver?.disconnect();
			if (this.scrollRaf) cancelAnimationFrame(this.scrollRaf);
			if (this.layoutMeasureRaf) cancelAnimationFrame(this.layoutMeasureRaf);
			this.presenter?.dispose();
		}
	}

	if (!customElements.get("table-of-contents")) {
		customElements.define("table-of-contents", TableOfContents);
	}

	onPostTocRefresh(({ root }) => {
		document
			.querySelector<HTMLElementTagNameMap["table-of-contents"]>(
				"table-of-contents",
			)
			?.refreshRuntimeHeadings?.(root);
	});
</script>

<style>
	table-of-contents#toc {
		max-height: none;
		min-height: 0;
		overflow: visible;
		position: relative;
		display: block;
	}

	table-of-contents#toc :global(a) {
		max-height: 5rem;
		overflow: hidden;
		transition:
			max-height var(--motion-normal) var(--motion-ease-standard),
			min-height var(--motion-normal) var(--motion-ease-standard),
			padding var(--motion-normal) var(--motion-ease-standard),
			opacity var(--motion-normal) var(--motion-ease-standard),
			color var(--motion-fast) var(--motion-ease-standard),
			background-color var(--motion-fast) var(--motion-ease-standard);
	}

	table-of-contents#toc :global(.toc-entry-badge) {
		margin-left: calc(var(--toc-level, 0) * 1rem);
	}

	table-of-contents#toc :global(a.is-read) {
		opacity: 0.52;
	}

	table-of-contents#toc :global(a.is-current-branch) {
		color: var(--text-primary);
	}

	table-of-contents#toc :global(.toc-expanded-region) {
		height: 0;
		overflow: hidden;
		opacity: 0;
		transform: translateY(-4px);
		will-change: height, opacity, transform;
		transition:
			height var(--motion-normal) var(--motion-ease-standard),
			opacity var(--motion-fast) var(--motion-ease-standard),
			transform var(--motion-normal) var(--motion-ease-standard);
	}

	table-of-contents#toc :global(.toc-expanded-region[data-expanded="true"]) {
		opacity: 1;
		transform: translateY(0);
	}

	table-of-contents#toc :global(.toc-active-indicator) {
		top: 0;
		bottom: auto;
		transform: translateY(0);
		will-change: transform, height, opacity;
		transition:
			transform var(--motion-normal) var(--motion-ease-standard),
			height var(--motion-normal) var(--motion-ease-standard),
			opacity var(--motion-fast) var(--motion-ease-standard),
			background-color var(--motion-fast) var(--motion-ease-standard),
			border-color var(--motion-fast) var(--motion-ease-standard);
	}

	table-of-contents#toc :global(a.is-collapsed) {
		max-height: 0;
		min-height: 0;
		padding-top: 0;
		padding-bottom: 0;
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		table-of-contents#toc :global(.toc-expanded-region) {
			transition: none;
		}
	}

</style>
