---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config";
import { buildTocItems } from "./toc-data";

export interface Props {
	class?: string;
	headings: MarkdownHeading[];
	deferHeadings?: boolean;
}

const { headings = [], deferHeadings = false } = Astro.props;
const className = Astro.props.class;
const tocItems = deferHeadings
	? []
	: buildTocItems(headings, {
			maxDepth: siteConfig.toc?.depth || 3,
			useJapaneseBadge: siteConfig.toc?.useJapaneseBadge || false,
		});
---

<table-of-contents class:list={[className, "group hide-scrollbar"]} id="toc">
	{
		tocItems.map((item) => {
			const depthClass =
				item.level === 0 ? "" : item.level === 1 ? "ml-4" : "ml-8";

			return (
				<a
					href={`#${item.id}`}
					data-depth={item.depth}
					data-toc-level={item.level}
					class="px-2 flex gap-2 relative transition w-full min-h-9 rounded-xl hover:bg-(--toc-btn-hover) active:bg-(--toc-btn-active) py-2"
				>
					<div
						class:list={[
							"transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold",
							depthClass,
							{
								"bg-(--toc-badge-bg) text-(--btn-content)":
									item.badgeKind === "text",
							},
						]}
					>
						{item.badgeKind === "text" && item.badge}
						{item.badgeKind === "square" && (
							<div class="transition w-2 h-2 rounded-[0.1875rem] bg-(--toc-badge-bg)" />
						)}
						{item.badgeKind === "dot" && (
							<div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10" />
						)}
					</div>
					<div
						class:list={[
							"transition text-sm",
							item.level <= 1 ? "text-50" : "text-30",
						]}
					>
						{item.text}
					</div>
				</a>
			);
		})
	}
	<div
		id="active-indicator"
		style="opacity: 0"
		class="-z-10 absolute bg-(--toc-btn-hover) left-0 right-0 rounded-xl toc-active-indicator group-hover:bg-transparent border-2 border-(--toc-btn-hover) group-hover:border-(--toc-btn-active) border-dashed"
	>
	</div>
</table-of-contents>

<script>
	import { buildTocItems, collectTocHeadings } from "./toc-data";
	import {
		TOC_SCROLL_OFFSET,
		TocActiveTracker,
		findHeadingById,
		getPostContentRoot,
		getTocOptions,
		onPostTocRefresh,
		type TocItem,
	} from "./toc-runtime";
	import { renderDesktopTocItem } from "./toc-render";
	import {
		resolveDesktopTocViewportState,
		type DesktopTocTransitionType,
		type DesktopTocViewportState,
	} from "./toc-desktop-state";

	class TableOfContents extends HTMLElement {
		tocEl: HTMLElement | null = null;
		visibleClass = "visible";
		anchorNavTarget: HTMLElement | null = null;
		headingIdxMap = new Map<string, number>();
		tocItems: TocItem[] = [];
		headings: HTMLElement[] = [];
		tocEntries: HTMLAnchorElement[] = [];
		activeTracker = new TocActiveTracker();
		activeIndicator: HTMLElement | null = null;
		activeIndicatorState: {
			top: number;
			bottom: number;
		} | null = null;
		viewportState: DesktopTocViewportState | null = null;
		lastActiveIndicatorIndex = -1;
		lastAutoScrolledIndex = -1;
		activeScrollRetry = 0;
		activeIndicatorRetry = 0;
		lastScrollY = 0;
		scrollRaf = 0;
		layoutMeasureRaf = 0;
		contentResizeObserver: ResizeObserver | null = null;
		initialized = false;

		toggleActiveHeading = (currentIndex: number) => {
			if (!this.tocEntries.length) {
				this.hideActiveIndicator();
				return;
			}

			if (currentIndex < 0) {
				this.hideActiveIndicator();
				return;
			}

			const activeIndex = currentIndex;
			const activeEntry = this.tocEntries[activeIndex];

			if (!activeEntry) {
				this.hideActiveIndicator();
				return;
			}
			if (activeEntry.classList.contains("is-collapsed")) {
				return;
			}
			for (const entry of this.tocEntries) {
				entry.classList.remove(this.visibleClass);
			}
			activeEntry.classList.add(this.visibleClass);
			const activeEntryRect = activeEntry.getBoundingClientRect();
			if (activeEntryRect.height < 24) {
				if (!this.activeIndicatorRetry) {
					this.activeIndicatorRetry = window.setTimeout(() => {
						this.activeIndicatorRetry = 0;
						this.toggleActiveHeading(this.getCurrentHeadingIndex());
						this.scrollToActiveHeading();
					}, 260);
				}
				return;
			}
			const parentOffset = this.tocEl?.getBoundingClientRect().top || 0;
			const scrollOffset = this.tocEl?.scrollTop || 0;
			const top =
				activeEntryRect.top - parentOffset + scrollOffset;
			const bottom =
				activeEntryRect.bottom - parentOffset + scrollOffset;
			this.moveActiveIndicator(top, bottom);
			this.lastActiveIndicatorIndex = activeIndex;
		};

		hideActiveIndicator() {
			this.activeIndicator?.setAttribute("style", "opacity: 0");
			this.activeIndicatorState = null;
			this.lastActiveIndicatorIndex = -1;
		}

		moveActiveIndicator(top: number, bottom: number) {
			if (!this.activeIndicator || !this.tocEl) return;

			const boundedTop = Math.max(0, top);
			const boundedBottom = Math.max(boundedTop, bottom);
			const height = boundedBottom - boundedTop;
			if (height <= 0) {
				this.hideActiveIndicator();
				return;
			}

			const style = `top: 0; bottom: auto; height: ${height}px; opacity: 1; transform: translateY(${boundedTop}px);`;
			this.activeIndicator.setAttribute("style", style);
			this.activeIndicatorState = {
				top: boundedTop,
				bottom: boundedBottom,
			};
		}

		scrollToActiveHeading = () => {
			if (this.anchorNavTarget || !this.tocEl) return;
			const activeHeading = document.querySelectorAll<HTMLDivElement>(
				`#toc .${this.visibleClass}`,
			);
			if (!activeHeading.length) return;

			const topmost = activeHeading[0];
			const bottommost = activeHeading[activeHeading.length - 1];
			const tocHeight = this.tocEl.clientHeight;
			const currentScroll = this.tocEl.scrollTop;
			const visibilityPadding = 12;
			const safeTop = currentScroll + visibilityPadding;
			const safeBottom = currentScroll + tocHeight - visibilityPadding;
			const topmostTop = topmost.offsetTop;
			const bottommostBottom =
				bottommost.offsetTop + bottommost.offsetHeight;

			let top = currentScroll;
			if (topmostTop < safeTop) {
				top = topmostTop - visibilityPadding;
			} else if (bottommostBottom > safeBottom) {
				top = bottommostBottom - tocHeight + visibilityPadding;
			} else {
				return;
			}

			this.tocEl.scrollTo({
				top: Math.max(0, top),
				left: 0,
				behavior: "auto",
			});
		};

		update = () => {
			requestAnimationFrame(() => {
				const currentIndex = this.getCurrentHeadingIndex();
				const nextState = this.resolveViewportState(currentIndex);
				const adaptiveChanged = this.updateAdaptiveState(nextState);
				this.viewportState = nextState;
				this.toggleActiveHeading(nextState.activeIndex);
				if (
					nextState.activeIndex !== this.lastAutoScrolledIndex ||
					adaptiveChanged
				) {
					this.scrollToActiveHeading();
					this.lastAutoScrolledIndex = nextState.activeIndex;
					if (adaptiveChanged) {
						if (this.activeScrollRetry) {
							window.clearTimeout(this.activeScrollRetry);
						}
						this.activeScrollRetry = window.setTimeout(() => {
							this.activeScrollRetry = 0;
							this.scrollToActiveHeading();
						}, 260);
					}
				}
			});
		};

		handleScroll = () => {
			const currentScrollY = window.scrollY;
			this.lastScrollY = currentScrollY;
			if (this.scrollRaf) return;
			this.scrollRaf = requestAnimationFrame(() => {
				this.scrollRaf = 0;
				this.update();
			});
		};

		handleLayoutResize = () => {
			if (this.layoutMeasureRaf) return;
			this.layoutMeasureRaf = requestAnimationFrame(() => {
				this.layoutMeasureRaf = 0;
				this.activeTracker.measure();
				this.update();
			});
		};

		getCurrentHeadingIndex() {
			const stickySupport =
				document.querySelector<HTMLElement>(".post-support");
			const stickyTop = stickySupport
				? Number.parseFloat(getComputedStyle(stickySupport).top)
				: Number.NaN;
			const targetTop = Number.isFinite(stickyTop) ? stickyTop + 24 : 120;
			return this.activeTracker.update(window.scrollY, targetTop);
		}

		resolveViewportState(
			currentIndex: number,
			reason?: DesktopTocTransitionType,
		) {
			return resolveDesktopTocViewportState({
				graph: this.activeTracker.graph,
				activeIndex: currentIndex,
				previous: this.viewportState,
				scrollDirection: this.activeTracker.scrollDirection,
				reason,
			});
		}

		updateAdaptiveState(state: DesktopTocViewportState) {
			if (!this.tocEntries.length) return false;
			const previousKey = this.dataset.tocViewportKey ?? "";
			const nextKey = [
				state.activeIndex,
				state.activeRootIndex,
				state.transitionType,
				...state.visibleIndexes,
			].join(":");
			const adaptiveChanged =
				previousKey !== "" && previousKey !== nextKey;
			this.dataset.tocViewportKey = nextKey;
			this.dataset.tocTransition = state.transitionType;
			this.dataset.tocPhase = state.phase;
			this.classList.remove("toc-compact");

			for (let i = 0; i < this.tocEntries.length; i++) {
				const entry = this.tocEntries[i];
				const isCurrentBranch = state.branchIndexes.has(i);
				const isReadEntry = state.readIndexes.has(i);
				const shouldCollapse = !state.visibleIndexes.has(i);

				entry.classList.toggle("is-current-branch", isCurrentBranch);
				entry.classList.toggle("is-read", isReadEntry);
				entry.classList.toggle("is-collapsed", shouldCollapse);
			}
			return adaptiveChanged;
		}

		handleAnchorClick = (event: Event) => {
			const anchor = event
				.composedPath()
				.find((element) => element instanceof HTMLAnchorElement);

			if (anchor) {
				event.preventDefault(); // 阻止默认的锚点跳转

				const id = decodeURIComponent(anchor.hash?.substring(1));
				const targetElement = findHeadingById(id);

				if (targetElement) {
					// 计算目标位置，与移动端保持一致
					const targetTop =
						targetElement.getBoundingClientRect().top +
						window.scrollY -
						TOC_SCROLL_OFFSET;

					// 使用与移动端相同的滚动方式
					window.scrollTo({
						top: targetTop,
						behavior: "smooth",
					});
				}

				const idx = this.headingIdxMap.get(id);
				if (idx !== undefined) {
					this.anchorNavTarget = this.headings[idx];
				} else {
					this.anchorNavTarget = null;
				}
			}
		};

		getContentRoot() {
			return getPostContentRoot();
		}

		resetRuntimeState() {
			if (this.initialized) {
				this.tocEl?.removeEventListener(
					"click",
					this.handleAnchorClick,
				);
				window.removeEventListener("scroll", this.handleScroll);
				window.removeEventListener("resize", this.handleLayoutResize);
				this.contentResizeObserver?.disconnect();
				if (this.scrollRaf) cancelAnimationFrame(this.scrollRaf);
				if (this.layoutMeasureRaf) cancelAnimationFrame(this.layoutMeasureRaf);
				if (this.activeScrollRetry)
					window.clearTimeout(this.activeScrollRetry);
				if (this.activeIndicatorRetry)
					window.clearTimeout(this.activeIndicatorRetry);
			}
			this.headingIdxMap.clear();
			this.tocItems = [];
			this.headings = [];
			this.tocEntries = [];
			this.activeTracker.setState([], []);
			this.anchorNavTarget = null;
			this.activeIndicatorState = null;
			this.viewportState = null;
			this.lastActiveIndicatorIndex = -1;
			this.lastAutoScrolledIndex = -1;
			this.activeScrollRetry = 0;
			this.activeIndicatorRetry = 0;
			this.scrollRaf = 0;
			this.layoutMeasureRaf = 0;
			this.contentResizeObserver = null;
			this.initialized = false;
		}

		connectedCallback() {
			// 优先监听动画结束，兜底定时初始化，确保二次刷新也能正常显示 TOC
			const element =
				document.querySelector(".custom-md") ||
				document.querySelector(".prose") ||
				document.querySelector(".markdown-content");
			let initialized = false;
			const tryInit = () => {
				if (!initialized) {
					initialized = true;
					this.init();
				}
			};
			if (element) {
				element.addEventListener("animationend", tryInit, {
					once: true,
				});
				tryInit();
				// 兜底：无论动画是否触发，300ms后强制初始化一次
				setTimeout(tryInit, 300);
			} else {
				// 没有动画元素，直接初始化，兜底再延迟一次
				tryInit();
				setTimeout(tryInit, 300);
			}
		}

		init() {
			this.resetRuntimeState();

			this.tocEl =
				this.closest<HTMLElement>(".post-support__toc-body") ?? this;

			this.tocEl.addEventListener("click", this.handleAnchorClick, {
				capture: true,
			});

			this.activeIndicator =
				this.querySelector<HTMLElement>("#active-indicator");

			this.tocEntries = Array.from(
				this.querySelectorAll<HTMLAnchorElement>("a[href^='#']"),
			);

			this.initialized = true;
			if (this.tocEntries.length === 0) return;

			this.headings = new Array(this.tocEntries.length);
			const contentRoot = this.getContentRoot();
			for (let i = 0; i < this.tocEntries.length; i++) {
				const id = decodeURIComponent(
					this.tocEntries[i].hash?.substring(1),
				);
				const heading = Array.from(
					contentRoot?.querySelectorAll<HTMLElement>(
						"h1, h2, h3, h4, h5, h6",
					) ?? [],
				).find((element) => element.id === id);
				if (heading instanceof HTMLElement) {
					this.headings[i] = heading;
					this.headingIdxMap.set(id, i);
				}
			}
			this.tocItems = this.tocEntries.map((entry) => {
				const level = Number(entry.dataset.tocLevel ?? 0);
				const depth = Number(entry.dataset.depth ?? level + 1);
				return {
					id: decodeURIComponent(entry.hash?.substring(1)),
					text: entry.textContent?.replace(/\s+/g, " ").trim() ?? "",
					depth,
					level,
					badge: "",
					badgeKind: level === 0 ? "text" : level === 1 ? "square" : "dot",
				};
			});
			this.activeTracker.setState(this.tocItems, this.headings);
			this.viewportState = this.resolveViewportState(
				this.activeTracker.activeIndex,
				"init",
			);
			this.lastScrollY = window.scrollY;

			window.addEventListener("scroll", this.handleScroll, {
				passive: true,
			});
			window.addEventListener("resize", this.handleLayoutResize, {
				passive: true,
			});
			if (contentRoot && "ResizeObserver" in window) {
				this.contentResizeObserver = new ResizeObserver(
					this.handleLayoutResize,
				);
				this.contentResizeObserver.observe(contentRoot);
			}

			this.update();
		}

		refreshRuntimeHeadings(root?: Element) {
			this.regenerateTOC(0, root);
			this.init();
		}

		regenerateTOC(retryCount = 0, root?: Element) {
			// 检查是否为文章页面
			const isPostPage =
				window.location.pathname.includes("/posts/") ||
				document.querySelector(".custom-md, .markdown-content") !==
					null;
			if (!isPostPage) {
				// 如果不是文章页面，隐藏TOC
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			// 从当前页面重新获取标题
			const contentRoot = root || this.getContentRoot();
			if (!contentRoot) {
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			const headings = collectTocHeadings(contentRoot);
			// 如果没有标题，延迟重试最多3次
			if (headings.length === 0 && retryCount < 3) {
				setTimeout(
					() => this.regenerateTOC(retryCount + 1, root),
					120,
				);
				return;
			}
			if (headings.length === 0) {
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			const tocItems = buildTocItems(headings, getTocOptions());
			const tocHTML = tocItems.map(renderDesktopTocItem).join("");
			this.innerHTML =
				tocHTML +
				'<div id="active-indicator" style="opacity: 0" class="-z-10 absolute bg-(--toc-btn-hover) left-0 right-0 rounded-xl toc-active-indicator group-hover:bg-transparent border-2 border-(--toc-btn-hover) group-hover:border-(--toc-btn-active) border-dashed"></div>';
			this.dataset.loaded = "true";
		}

		disconnectedCallback() {
			this.tocEl?.removeEventListener("click", this.handleAnchorClick);
			window.removeEventListener("scroll", this.handleScroll);
			window.removeEventListener("resize", this.handleLayoutResize);
			this.contentResizeObserver?.disconnect();
			if (this.scrollRaf) cancelAnimationFrame(this.scrollRaf);
			if (this.layoutMeasureRaf) cancelAnimationFrame(this.layoutMeasureRaf);
			if (this.activeScrollRetry)
				window.clearTimeout(this.activeScrollRetry);
			if (this.activeIndicatorRetry)
				window.clearTimeout(this.activeIndicatorRetry);
		}
	}

	if (!customElements.get("table-of-contents")) {
		customElements.define("table-of-contents", TableOfContents);
	}

	onPostTocRefresh(({ root }) => {
		document
			.querySelector<HTMLElementTagNameMap["table-of-contents"]>(
				"table-of-contents",
			)
			?.refreshRuntimeHeadings?.(root);
	});
</script>

<style>
	table-of-contents#toc {
		max-height: none;
		min-height: 0;
		overflow: visible;
		position: relative;
		display: block;
	}

	table-of-contents#toc :global(a) {
		max-height: 5rem;
		overflow: hidden;
		transition:
			max-height var(--motion-normal) var(--motion-ease-standard),
			min-height var(--motion-normal) var(--motion-ease-standard),
			padding var(--motion-normal) var(--motion-ease-standard),
			opacity var(--motion-normal) var(--motion-ease-standard),
			color var(--motion-fast) var(--motion-ease-standard),
			background-color var(--motion-fast) var(--motion-ease-standard);
	}

	table-of-contents#toc :global(a.is-read) {
		opacity: 0.52;
	}

	table-of-contents#toc :global(a.is-current-branch) {
		color: var(--text-primary);
	}

	table-of-contents#toc :global(.toc-active-indicator) {
		top: 0;
		bottom: auto;
		transform: translateY(0);
		will-change: transform, height, opacity;
		transition:
			transform var(--motion-normal) var(--motion-ease-standard),
			height var(--motion-normal) var(--motion-ease-standard),
			opacity var(--motion-fast) var(--motion-ease-standard),
			background-color var(--motion-fast) var(--motion-ease-standard),
			border-color var(--motion-fast) var(--motion-ease-standard);
	}

	table-of-contents#toc :global(a.is-collapsed) {
		max-height: 0;
		min-height: 0;
		padding-top: 0;
		padding-bottom: 0;
		opacity: 0;
		pointer-events: none;
	}

	table-of-contents#toc.toc-compact :global(a:not(.visible)) {
		opacity: 0.58;
	}

</style>
