---
import type { MarkdownHeading } from "astro";

export interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

const { headings = [] } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const className = Astro.props.class;
---

<table-of-contents class:list={[className, "group hide-scrollbar"]} id="toc">
	<!-- TOC内容将由JavaScript动态生成 -->
</table-of-contents>

<script>
	class TableOfContents extends HTMLElement {
		tocEl: HTMLElement | null = null;
		visibleClass = "visible";
		observer: IntersectionObserver;
		anchorNavTarget: HTMLElement | null = null;
		headingIdxMap = new Map<string, number>();
		headings: HTMLElement[] = [];
		sections: HTMLElement[] = [];
		tocEntries: HTMLAnchorElement[] = [];
		tocRootIndexes: number[] = [];
		active: boolean[] = [];
		activeIndicator: HTMLElement | null = null;
		activeIndicatorState: {
			top: number;
			bottom: number;
			placement: "top" | "bottom";
		} | null = null;
		activeIndicatorStartRect: DOMRect | null = null;
		indicatorPlacement: "top" | "bottom" = "top";
		lastActiveIndicatorIndex = -1;
		activeIndicatorRetry = 0;
		lastResolvedHeadingIndex = 0;
		lastScrollY = 0;
		scrollRaf = 0;

		constructor() {
			super();
			this.observer = new IntersectionObserver(this.markVisibleSection, {
				threshold: 0,
			});
		}

		markVisibleSection = (entries: IntersectionObserverEntry[]) => {
			entries.forEach((entry) => {
				const id = entry.target.children[0]?.getAttribute("id");
				const idx = id ? this.headingIdxMap.get(id) : undefined;
				if (idx != undefined) this.active[idx] = entry.isIntersecting;

				if (
					entry.isIntersecting &&
					this.anchorNavTarget == entry.target.firstChild
				)
					this.anchorNavTarget = null;
			});

			if (!this.active.includes(true)) this.fallback();
			this.update();
		};

		toggleActiveHeading = () => {
			if (!this.tocEntries.length) {
				this.hideActiveIndicator();
				return;
			}

			const currentIndex = this.getCurrentHeadingIndex();
			const currentRoot = this.tocRootIndexes[currentIndex] ?? 0;
			const compact = this.classList.contains("toc-compact");
			const activeIndex = compact ? currentRoot : currentIndex;
			const activeEntry = this.tocEntries[activeIndex];

			for (const entry of this.tocEntries) {
				entry.classList.remove(this.visibleClass);
			}
			if (!activeEntry || activeEntry.classList.contains("is-collapsed")) {
				this.hideActiveIndicator();
				return;
			}
			activeEntry.classList.add(this.visibleClass);
			const activeEntryRect = activeEntry.getBoundingClientRect();
			if (activeEntryRect.height < 24) {
				if (!this.activeIndicatorRetry) {
					this.activeIndicatorRetry = window.setTimeout(() => {
						this.activeIndicatorRetry = 0;
						this.toggleActiveHeading();
						this.scrollToActiveHeading();
					}, 260);
				}
				return;
			}
			if (
				this.activeIndicatorStartRect &&
				this.lastActiveIndicatorIndex !== -1 &&
				this.lastActiveIndicatorIndex !== activeIndex
			) {
				this.primeActiveIndicatorFromRect(
					this.activeIndicatorStartRect,
				);
			}

			const parentOffset = this.tocEl?.getBoundingClientRect().top || 0;
			const scrollOffset = this.tocEl?.scrollTop || 0;
			const top =
				activeEntryRect.top - parentOffset + scrollOffset;
			const bottom =
				activeEntryRect.bottom - parentOffset + scrollOffset;
			this.moveActiveIndicator(top, bottom);
			this.lastActiveIndicatorIndex = activeIndex;
		};

		hideActiveIndicator() {
			this.activeIndicator?.setAttribute("style", "opacity: 0");
			this.activeIndicatorState = null;
			this.lastActiveIndicatorIndex = -1;
		}

		primeActiveIndicatorFromRect(rect: DOMRect) {
			if (!this.activeIndicator || !this.tocEl) return;

			const parentOffset = this.tocEl.getBoundingClientRect().top;
			const scrollOffset = this.tocEl.scrollTop;
			const top = Math.max(0, rect.top - parentOffset + scrollOffset);
			const bottom = Math.max(top, rect.bottom - parentOffset + scrollOffset);
			const height = bottom - top;
			if (height <= 0) return;

			const placement = this.indicatorPlacement;
			const scrollHeight = this.tocEl.scrollHeight;
			const style =
				placement === "bottom"
					? `top: auto; bottom: ${Math.max(0, scrollHeight - bottom)}px; height: ${height}px; opacity: 1; transition: none;`
					: `top: ${top}px; bottom: auto; height: ${height}px; opacity: 1; transition: none;`;
			this.activeIndicator.setAttribute("style", style);
			this.activeIndicator.getBoundingClientRect();
			this.activeIndicatorState = {
				top,
				bottom,
				placement,
			};
		}

		moveActiveIndicator(top: number, bottom: number) {
			if (!this.activeIndicator || !this.tocEl) return;

			const boundedTop = Math.max(0, top);
			const boundedBottom = Math.max(boundedTop, bottom);
			const height = boundedBottom - boundedTop;
			if (height <= 0) {
				this.hideActiveIndicator();
				return;
			}

			const previous = this.activeIndicatorState;
			const placement = this.indicatorPlacement;
			const scrollHeight = this.tocEl.scrollHeight;

			if (previous && previous.placement !== placement) {
				const currentStyle =
					placement === "bottom"
						? `top: auto; bottom: ${Math.max(0, scrollHeight - previous.bottom)}px; height: ${previous.bottom - previous.top}px; opacity: 1; transition: none;`
						: `top: ${previous.top}px; bottom: auto; height: ${previous.bottom - previous.top}px; opacity: 1; transition: none;`;
				this.activeIndicator.setAttribute("style", currentStyle);
				this.activeIndicator.getBoundingClientRect();
			}

			const style =
				placement === "bottom"
					? `top: auto; bottom: ${Math.max(0, scrollHeight - boundedBottom)}px; height: ${height}px; opacity: 1;`
					: `top: ${boundedTop}px; bottom: auto; height: ${height}px; opacity: 1;`;
			this.activeIndicator.setAttribute("style", style);
			this.activeIndicatorState = {
				top: boundedTop,
				bottom: boundedBottom,
				placement,
			};
		}

		scrollToActiveHeading = () => {
			if (this.anchorNavTarget || !this.tocEl) return;
			const activeHeading = document.querySelectorAll<HTMLDivElement>(
				`#toc .${this.visibleClass}`,
			);
			if (!activeHeading.length) return;

			const topmost = activeHeading[0];
			const bottommost = activeHeading[activeHeading.length - 1];
			const tocHeight = this.tocEl.clientHeight;
			const currentScroll = this.tocEl.scrollTop;
			const safeTop = currentScroll + tocHeight * 0.28;
			const safeBottom = currentScroll + tocHeight * 0.72;
			const topmostTop = topmost.offsetTop;
			const bottommostBottom =
				bottommost.offsetTop + bottommost.offsetHeight;

			let top = currentScroll;
			if (topmostTop < safeTop) {
				top = topmostTop - tocHeight * 0.32;
			} else if (bottommostBottom > safeBottom) {
				top = bottommostBottom - tocHeight * 0.68;
			} else {
				return;
			}

			this.tocEl.scrollTo({
				top: Math.max(0, top),
				left: 0,
				behavior: "auto",
			});
		};

		update = () => {
			requestAnimationFrame(() => {
				this.activeIndicatorStartRect =
					this.activeIndicator &&
					Number.parseFloat(
						getComputedStyle(this.activeIndicator).opacity,
					) > 0
						? this.activeIndicator.getBoundingClientRect()
						: null;
				this.updateAdaptiveState();
				this.toggleActiveHeading();
				this.scrollToActiveHeading();
				window.setTimeout(this.scrollToActiveHeading, 260);
				this.activeIndicatorStartRect = null;
			});
		};

		handleScroll = () => {
			const currentScrollY = window.scrollY;
			this.indicatorPlacement =
				currentScrollY < this.lastScrollY ? "bottom" : "top";
			this.lastScrollY = currentScrollY;
			if (this.scrollRaf) return;
			this.scrollRaf = requestAnimationFrame(() => {
				this.scrollRaf = 0;
				this.update();
			});
		};

		fallback = () => {
			if (!this.sections.length) return;

			for (let i = 0; i < this.sections.length; i++) {
				const offsetTop = this.sections[i].getBoundingClientRect().top;
				const offsetBottom =
				this.sections[i].getBoundingClientRect().bottom;

				if (
					this.isInRange(offsetTop, 0, window.innerHeight) ||
					this.isInRange(offsetBottom, 0, window.innerHeight) ||
					(offsetTop < 0 && offsetBottom > window.innerHeight)
				) {
					this.markActiveHeading(i);
				} else if (offsetTop > window.innerHeight) break;
			}
		};

		markActiveHeading = (idx: number) => {
			this.active[idx] = true;
		};

		getCurrentHeadingIndex() {
			const stickySupport =
				document.querySelector<HTMLElement>(".post-support");
			const stickyTop = stickySupport
				? Number.parseFloat(getComputedStyle(stickySupport).top)
				: Number.NaN;
			const targetTop = Number.isFinite(stickyTop) ? stickyTop + 24 : 120;
			let current = 0;
			const firstHeading = this.headings[0];
			const firstHeadingTop = firstHeading
				? firstHeading.getBoundingClientRect().top
				: Number.NaN;
			for (let i = 0; i < this.headings.length; i++) {
				const heading = this.headings[i];
				if (!heading) continue;
				if (heading.getBoundingClientRect().top <= targetTop) {
					current = i;
				} else {
					break;
				}
			}
			if (this.indicatorPlacement === "bottom") {
				const nextRoot = this.tocRootIndexes.find(
					(rootIndex) => rootIndex > current,
				);
				const nextRootHeading =
					typeof nextRoot === "number"
						? this.headings[nextRoot]
						: undefined;
				if (
					typeof nextRoot === "number" &&
					nextRootHeading &&
					nextRootHeading.getBoundingClientRect().top <=
						targetTop + 180
				) {
					current = nextRoot;
				}
			}
			if (
				current === 0 &&
				this.lastResolvedHeadingIndex > 0 &&
				Number.isFinite(firstHeadingTop) &&
				firstHeadingTop > targetTop &&
				window.scrollY > 1
			) {
				return this.lastResolvedHeadingIndex;
			}
			if (current > 0) {
				this.lastResolvedHeadingIndex = current;
				return current;
			}

			const firstActive = this.active.findIndex(Boolean);
			if (firstActive > 0) {
				this.lastResolvedHeadingIndex = firstActive;
				return firstActive;
			}
			this.lastResolvedHeadingIndex = current;
			return current;
		}

		isNearArticleEnd() {
			const article =
				document.getElementById("post-container") ||
				document.querySelector<HTMLElement>(".post-detail__content");
			if (!article) return false;
			const rect = article.getBoundingClientRect();
			return rect.bottom <= window.innerHeight + 180;
		}

		updateAdaptiveState() {
			if (!this.tocEntries.length) return;

			const currentIndex = this.getCurrentHeadingIndex();
			const currentRoot = this.tocRootIndexes[currentIndex] ?? 0;
			const compact = this.isNearArticleEnd();
			this.classList.toggle("toc-compact", compact);

			for (let i = 0; i < this.tocEntries.length; i++) {
				const entry = this.tocEntries[i];
				const level = Number(entry.dataset.tocLevel ?? 0);
				const rootIndex = this.tocRootIndexes[i] ?? 0;
				const isCurrentBranch = rootIndex === currentRoot;
				const isReadEntry = i < currentIndex && i !== currentRoot;
				const shouldCollapse =
					level > 0 && (compact || !isCurrentBranch);

				entry.classList.toggle("is-current-branch", isCurrentBranch);
				entry.classList.toggle("is-read", isReadEntry);
				entry.classList.toggle("is-collapsed", shouldCollapse);
			}
		}

		handleAnchorClick = (event: Event) => {
			const anchor = event
				.composedPath()
				.find((element) => element instanceof HTMLAnchorElement);

			if (anchor) {
				event.preventDefault(); // 阻止默认的锚点跳转

				const id = decodeURIComponent(anchor.hash?.substring(1));
				const targetElement = document.getElementById(id);

				if (targetElement) {
					// 计算目标位置，与移动端保持一致
					const navbarHeight = 80; // 导航栏高度
					const targetTop =
						targetElement.getBoundingClientRect().top +
						window.scrollY -
						navbarHeight;

					// 使用与移动端相同的滚动方式
					window.scrollTo({
						top: targetTop,
						behavior: "smooth",
					});
				}

				const idx = this.headingIdxMap.get(id);
				if (idx !== undefined) {
					this.anchorNavTarget = this.headings[idx];
				} else {
					this.anchorNavTarget = null;
				}
			}
		};

		isInRange(value: number, min: number, max: number) {
			return min < value && value < max;
		}

		connectedCallback() {
			// 优先监听动画结束，兜底定时初始化，确保二次刷新也能正常显示 TOC
			const element =
				document.querySelector(".custom-md") ||
				document.querySelector(".prose") ||
				document.querySelector(".markdown-content");
			let initialized = false;
			const tryInit = () => {
				if (!initialized) {
					initialized = true;
					this.init();
				}
			};
			if (element) {
				element.addEventListener("animationend", tryInit, {
					once: true,
				});
				// 兜底：无论动画是否触发，300ms后强制初始化一次
				setTimeout(tryInit, 300);
			} else {
				// 没有动画元素，直接初始化，兜底再延迟一次
				tryInit();
				setTimeout(tryInit, 300);
			}
		}

		init() {
			// 重新生成TOC内容
			this.regenerateTOC();

			this.tocEl =
				this.closest<HTMLElement>(".post-support__toc-body") ?? this;

			this.tocEl.addEventListener("click", this.handleAnchorClick, {
				capture: true,
			});

			this.activeIndicator = document.getElementById("active-indicator");

			this.tocEntries = Array.from(
				this.querySelectorAll<HTMLAnchorElement>("a[href^='#']"),
			);

			if (this.tocEntries.length === 0) return;

			this.tocRootIndexes = new Array(this.tocEntries.length);
			let currentRootIndex = 0;
			for (let i = 0; i < this.tocEntries.length; i++) {
				if (Number(this.tocEntries[i].dataset.tocLevel ?? 0) === 0) {
					currentRootIndex = i;
				}
				this.tocRootIndexes[i] = currentRootIndex;
			}

			this.sections = new Array(this.tocEntries.length);
			this.headings = new Array(this.tocEntries.length);
			for (let i = 0; i < this.tocEntries.length; i++) {
				const id = decodeURIComponent(
					this.tocEntries[i].hash?.substring(1),
				);
				const heading = document.getElementById(id);
				const section = heading?.parentElement;
				if (
					heading instanceof HTMLElement &&
					section instanceof HTMLElement
				) {
					this.headings[i] = heading;
					this.sections[i] = section;
					this.headingIdxMap.set(id, i);
				}
			}
			this.active = new Array(this.tocEntries.length).fill(false);
			this.lastScrollY = window.scrollY;

			this.sections.forEach((section) => this.observer.observe(section));
			window.addEventListener("scroll", this.handleScroll, {
				passive: true,
			});

			this.fallback();
			this.update();
		}

		regenerateTOC(retryCount = 0) {
			// 检查是否为文章页面
			const isPostPage =
				window.location.pathname.includes("/posts/") ||
				document.querySelector(".custom-md, .markdown-content") !==
					null;
			if (!isPostPage) {
				// 如果不是文章页面，隐藏TOC
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			// 从当前页面重新获取标题
			const contentRoot =
				document.querySelector(".markdown-content") ||
				document.querySelector(".custom-md") ||
				document.querySelector(".post-detail__content") ||
				document;
			const headings = Array.from(
				contentRoot.querySelectorAll("h1, h2, h3, h4, h5, h6"),
			)
				.filter((h) => h.id)
				.map((h) => ({
					depth: parseInt(h.tagName.substring(1)),
					slug: h.id,
					text: (h.textContent || "").replace(/#+\s*$/, ""),
				}));
			// 如果没有标题，延迟重试最多3次
			if (headings.length === 0 && retryCount < 3) {
				setTimeout(() => this.regenerateTOC(retryCount + 1), 120);
				return;
			}
			if (headings.length === 0) {
				this.innerHTML = "";
				delete this.dataset.loaded;
				return;
			}
			// 重新生成TOC HTML
			const minDepth = Math.min(...headings.map((h) => h.depth));
			// 获取配置信息
			const siteConfig = window.siteConfig;
			const maxLevel = siteConfig.toc?.depth || 3;
			const useJapaneseBadge = siteConfig.toc?.useJapaneseBadge || false;

			// 日语片假名字符集
			const japaneseKatakana = [
				"ア",
				"イ",
				"ウ",
				"エ",
				"オ",
				"カ",
				"キ",
				"ク",
				"ケ",
				"コ",
				"サ",
				"シ",
				"ス",
				"セ",
				"ソ",
				"タ",
				"チ",
				"ツ",
				"テ",
				"ト",
				"ナ",
				"ニ",
				"ヌ",
				"ネ",
				"ノ",
				"ハ",
				"ヒ",
				"フ",
				"ヘ",
				"ホ",
				"マ",
				"ミ",
				"ム",
				"メ",
				"モ",
				"ヤ",
				"ユ",
				"ヨ",
				"ラ",
				"リ",
				"ル",
				"レ",
				"ロ",
				"ワ",
				"ヲ",
				"ン",
			];

			let heading1Count = 1;
			const tocHTML = headings
				.filter((heading) => heading.depth < minDepth + maxLevel)
				.map((heading) => {
					const depthClass =
						heading.depth === minDepth
							? ""
							: heading.depth === minDepth + 1
								? "ml-4"
								: "ml-8";

					let badgeContent = "";
					if (heading.depth === minDepth) {
						if (
							useJapaneseBadge &&
							heading1Count - 1 < japaneseKatakana.length
						) {
							badgeContent = japaneseKatakana[heading1Count - 1];
						} else {
							badgeContent = heading1Count.toString();
						}
						heading1Count++;
					} else if (heading.depth === minDepth + 1) {
						badgeContent =
							'<div class="transition w-2 h-2 rounded-[0.1875rem] bg-(--toc-badge-bg)"></div>';
					} else {
						badgeContent =
							'<div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10"></div>';
					}

					return `<a href="#${heading.slug}" data-depth="${heading.depth}" data-toc-level="${heading.depth - minDepth}" class="px-2 flex gap-2 relative transition w-full min-h-9 rounded-xl hover:bg-(--toc-btn-hover) active:bg-(--toc-btn-active) py-2">
                    <div class="transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold ${depthClass} ${heading.depth === minDepth ? "bg-(--toc-badge-bg) text-(--btn-content)" : ""}">
                        ${badgeContent}
                    </div>
                    <div class="transition text-sm ${heading.depth <= minDepth + 1 ? "text-50" : "text-30"}">${heading.text}</div>
                </a>`;
				})
				.join("");
			this.innerHTML =
				tocHTML +
				'<div id="active-indicator" style="opacity: 0" class="-z-10 absolute bg-(--toc-btn-hover) left-0 right-0 rounded-xl transition-all group-hover:bg-transparent border-2 border-(--toc-btn-hover) group-hover:border-(--toc-btn-active) border-dashed"></div>';
			this.dataset.loaded = "true";
		}

		disconnectedCallback() {
			this.sections.forEach((section) =>
				this.observer.unobserve(section),
			);
			this.observer.disconnect();
			this.tocEl?.removeEventListener("click", this.handleAnchorClick);
			window.removeEventListener("scroll", this.handleScroll);
			if (this.scrollRaf) cancelAnimationFrame(this.scrollRaf);
			if (this.activeIndicatorRetry)
				window.clearTimeout(this.activeIndicatorRetry);
		}
	}

	if (!customElements.get("table-of-contents")) {
		customElements.define("table-of-contents", TableOfContents);
	}
</script>

<style>
	table-of-contents#toc {
		max-height: none;
		min-height: 0;
		overflow: visible;
		position: relative;
		display: block;
	}

	table-of-contents#toc :global(a) {
		max-height: 5rem;
		overflow: hidden;
		transition:
			max-height var(--motion-normal) var(--motion-ease-standard),
			min-height var(--motion-normal) var(--motion-ease-standard),
			padding var(--motion-normal) var(--motion-ease-standard),
			opacity var(--motion-normal) var(--motion-ease-standard),
			color var(--motion-fast) var(--motion-ease-standard),
			background-color var(--motion-fast) var(--motion-ease-standard);
	}

	table-of-contents#toc :global(a.is-read) {
		opacity: 0.52;
	}

	table-of-contents#toc :global(a.is-current-branch) {
		color: var(--text-primary);
	}

	table-of-contents#toc :global(a.is-collapsed) {
		max-height: 0;
		min-height: 0;
		padding-top: 0;
		padding-bottom: 0;
		opacity: 0;
		pointer-events: none;
	}

	table-of-contents#toc.toc-compact :global(a:not(.visible)) {
		opacity: 0.58;
	}

</style>
