---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { UIMeta } from "@/services/core/types";

export interface Props {
	published: Date;
	updated?: Date;
	category: UIMeta;
	tags: UIMeta[];
	hideUpdateDate?: boolean;
	hideTagsForMobile?: boolean;
	isHome?: boolean;
	className?: string;
	id?: string;
	showOnlyBasicMeta?: boolean;
	words?: number;
	minutes?: number;
	showWordCount?: boolean;
}

const {
	published,
	updated,
	category,
	tags,
	hideUpdateDate,
	hideTagsForMobile,
	isHome,
	className = "",
	id,
	showOnlyBasicMeta = false,
	words,
	showWordCount = false,
} = Astro.props;
---

<div
	class:list={[
		"post-meta transition",
		className,
	]}
>
	<!-- publish date -->
	<div class="post-meta__item">
		<div class="meta-icon post-meta__icon">
			<Icon
				name="material-symbols:calendar-today-outline-rounded"
			/>
		</div>
		<span class="post-meta__text">{formatDateToYYYYMMDD(published)}</span>
	</div>

	<!-- update date -->
	{
		!hideUpdateDate &&
			updated &&
			updated.getTime() !== published.getTime() && (
				<div class="post-meta__item">
					<div class="meta-icon post-meta__icon">
						<Icon
							name="material-symbols:edit-calendar-outline-rounded"
						/>
					</div>
					<span class="post-meta__text">{formatDateToYYYYMMDD(updated)}</span>
				</div>
			)
	}

	<!-- categories -->
	<div class="post-meta__item">
		<div class="meta-icon post-meta__icon">
			<Icon
				name="material-symbols:book-2-outline-rounded"
			/>
		</div>
		<div class="post-meta__value">
			<a
				href={category.url}
				aria-label={`View all posts in the ${category.name} category`}
				class="post-meta__link link-lg transition"
			>
				{category?.name || i18n(I18nKey.uncategorized)}
			</a>
		</div>
	</div>

	<!-- word count -->
	{
		showWordCount && words && (
			<div class="post-meta__item">
				<div class="meta-icon post-meta__icon">
					<Icon
						name="material-symbols:article-outline-rounded"
					/>
				</div>
				<span class="post-meta__text">
					{words}{" "}
					{words > 1
						? i18n(I18nKey.wordsCount)
						: i18n(I18nKey.wordCount)}
				</span>
			</div>
		)
	}

	<!-- tags -->
	{
		!showOnlyBasicMeta && (
			<div
				class:list={[
					"post-meta__item post-meta__item--tags",
					{
						"post-meta__item--mobile-hidden": hideTagsForMobile,
					},
				]}
			>
				<div class="meta-icon post-meta__icon">
					<Icon name="material-symbols:tag-rounded" />
				</div>
				<div class="post-meta__tag-list">
					{tags &&
						tags.length > 0 &&
						tags.map((tagItem, i) => (
							<span class="post-meta__tag-item">
								<span
									class:list={[
										{ hidden: i == 0 },
										"post-meta__tag-separator",
									]}
								>
									/
								</span>
								<a
									href={tagItem.url}
									aria-label={`View all posts with the ${tagItem.name} tag`}
									title={tagItem.name}
									class="post-meta__link post-meta__tag-link link-lg transition"
								>
									{tagItem.name}
								</a>
							</span>
						))}
					{!(tags && tags.length > 0) && (
						<div class="post-meta__text transition">{i18n(I18nKey.noTags)}</div>
					)}
				</div>
			</div>
		)
	}

	<!-- 访问量 -->
	{
		!isHome && id && (
			<div
				class="hidden post-meta__item umami-page-views"
				data-id={id}
				data-page-views-label={i18n(I18nKey.profileStatsPageViews)}
				data-visits-label={i18n(I18nKey.profileStatsVisits)}
			>
				<div class="meta-icon post-meta__icon">
					<Icon
						name="material-symbols:visibility-outline-rounded"
					/>
				</div>
				<span class="post-meta__text page-views-display">
					{i18n(I18nKey.pageViewsLoading)}
				</span>
			</div>
		)
	}
</div>

<script is:inline>
	(() => {
		const container = document.querySelector(".umami-page-views");

		function generateStatsText(container, pageViews, visits) {
			const pageViewsText = container.dataset.pageViewsLabel ?? "";
			const visitsText = container.dataset.visitsLabel ?? "";
			return `${pageViewsText} ${pageViews} · ${visitsText} ${visits}`;
		}

		async function fetchPageViews() {
			if (!container) return;
			if (!window.oddmisc) {
				container?.classList.add("hidden");
				return;
			}

			try {
				const stats = await window.oddmisc.getStats(
					`/posts/${container.dataset.id}/`,
				);
				const pageViews = stats.pageviews || 0;
				const visits = stats.visits || 0;

				if (pageViews === 0 && visits === 0) {
					container?.classList.add("hidden");
					return;
				}

				container?.classList.remove("hidden");
				container?.classList.add("flex");
				container.querySelector(".page-views-display").textContent =
					generateStatsText(container, pageViews, visits);
			} catch (error) {
				console.error("Error fetching page views:", error);
				container?.classList.add("hidden");
			}
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", fetchPageViews);
		} else {
			fetchPageViews();
		}
	})();
</script>
