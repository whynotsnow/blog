---

import * as fs from "node:fs";
import * as path from "node:path";
import { footerConfig, profileConfig } from "../config";
import { url } from "../utils/url-utils";
import FooterStats from "./footer/FooterStats.astro";
import type { FooterViewModel } from "@/services/footer";
import type { ResponsiveShellStrategy } from "@/services/layout/types";

interface Props {
	model: FooterViewModel;
	shellStrategy: ResponsiveShellStrategy;
}

const { model, shellStrategy } = Astro.props;

const currentYear = new Date().getFullYear();

// 页脚自定义内容逻辑
let customFooterHtml = "";
if (footerConfig.enable) {
	// 优先使用 customHtml，如果为空则使用 FooterConfig.html 文件内容
	if (footerConfig.customHtml && footerConfig.customHtml.trim() !== "") {
		customFooterHtml = footerConfig.customHtml.trim();
	} else {
		// customHtml 为空时，读取 FooterConfig.html 文件内容
		try {
			const footerConfigPath = path.join(
				process.cwd(),
				"src",
				"FooterConfig.html",
			);
			customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
			// 移除HTML注释
			customFooterHtml = customFooterHtml
				.replace(/<!--[\s\S]*?-->/g, "")
				.trim();
		} catch (error) {
			console.warn("FooterConfig.html文件读取失败:", error.message);
		}
	}
}
---

<footer class="site-footer" data-shell-strategy={shellStrategy}>
	<FooterStats model={model} />

	<div class="site-footer__meta transition text-center">
    {customFooterHtml && (
        <div class="site-footer__meta-row" set:html={customFooterHtml}></div>
    )}

		<div class="site-footer__meta-row">
			&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
			<a class="transition link text-(--primary) font-medium" href={url('rss/')} onclick={`event.preventDefault(); navigateToPage('${url('rss/')}')`}>RSS</a> /
			<a class="transition link text-(--primary) font-medium" href={url('atom/')} onclick={`event.preventDefault(); navigateToPage('${url('atom/')}')`}>Atom</a> /
			<a class="transition link text-(--primary) font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>
    </div>

		<div class="site-footer__meta-row">
			Powered by
			<a class="transition link text-(--primary) font-medium" target="_blank" href="https://astro.build">Astro</a> &
			<a class="transition link text-(--primary) font-medium" target="_blank" href="https://github.com/matsuzaka-yuki/mizuki">Mizuki</a>&nbsp; Version <a class="transition link text-(--primary) font-medium" target="_blank" href="https://github.com/matsuzaka-yuki/mizuki">8.3</a>
    </div>
		
	</div>
</footer>

<style>
	.site-footer {
		--footer-content-gap: var(--space-content);
		--footer-margin-before: var(--space-section);
		--footer-margin-after: var(--space-content);
		--footer-padding-block-start: var(--space-card);
		--footer-padding-inline: var(--space-page-x);
		--footer-meta-size: var(--text-small);
		--footer-stats-size: 0.8125rem;
		--footer-stats-row-gap: var(--size-2);
		--footer-stats-item-gap: var(--size-1);
		--footer-stats-column-gap: var(--space-content);
		--footer-stats-wrap-row-gap: var(--size-2);
		--footer-meta-row-gap: var(--size-2);
		display: grid;
		justify-items: center;
		gap: var(--footer-content-gap);
		width: 100%;
		margin-block: var(--footer-margin-before) var(--footer-margin-after);
		padding: var(--footer-padding-block-start) var(--footer-padding-inline) 0;
		border-top: 1px dashed var(--border-default);
	}

	.site-footer__meta {
		color: var(--text-muted);
		font-size: var(--footer-meta-size);
	}

	.site-footer__meta-row:not(:last-child) {
		margin-block-end: var(--footer-meta-row-gap);
	}

	@media (min-width: 1281px) and (orientation: landscape) {
		.site-footer[data-shell-strategy="container-content"] {
			--footer-content-gap: clamp(1.35rem, 1.2vw, 1.5rem);
			--footer-margin-before: clamp(4.5rem, 4vw, 5rem);
			--footer-margin-after: clamp(1.35rem, 1.2vw, 1.5rem);
			--footer-padding-block-start: clamp(1.125rem, 1vw, 1.25rem);
			--footer-padding-inline: clamp(1.8rem, 1.6vw, 2rem);
			--footer-meta-size: clamp(0.7875rem, 0.7vw, 0.875rem);
			--footer-stats-size: clamp(0.73125rem, 0.65vw, 0.8125rem);
			--footer-stats-row-gap: clamp(0.45rem, 0.4vw, 0.5rem);
			--footer-stats-item-gap: clamp(0.225rem, 0.2vw, 0.25rem);
			--footer-stats-column-gap: clamp(1.35rem, 1.2vw, 1.5rem);
			--footer-stats-wrap-row-gap: clamp(0.45rem, 0.4vw, 0.5rem);
			--footer-meta-row-gap: clamp(0.45rem, 0.4vw, 0.5rem);
		}
	}
</style>
