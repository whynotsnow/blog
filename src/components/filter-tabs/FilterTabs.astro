---
export interface FilterTab {
	value: string;
	label: string;
	count?: number;
}

interface Props {
	tabs: FilterTab[];
	dataAttr: string;
	activeValue?: string;
	class?: string;
}

const {
	tabs,
	dataAttr,
	activeValue = "all",
	class: className = "",
} = Astro.props;
---

<div class:list={["filter-tabs", className]}>
	{
		tabs.map((tab) => (
			<button
				type="button"
				class:list={[
					"filter-tabs__item",
					{ "is-active": tab.value === activeValue },
				]}
				data-filter-value={tab.value}
				data-filter-attr={dataAttr}
			>
				<span>{tab.label}</span>
				{tab.count !== undefined && (
					<span class="filter-tabs__count">({tab.count})</span>
				)}
			</button>
		))
	}
</div>

<style>
	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.filter-tabs__item {
		display: inline-flex;
		align-items: center;
			gap: 0.375rem;
			padding: 0.5rem 1rem;
			border: 1px solid var(--border-subtle);
		border-radius: var(--radius-lg);
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-size: var(--text-ui-size);
		font-weight: 500;
		cursor: pointer;
			transition:
				background-color 0.2s ease,
				border-color 0.2s ease,
			color 0.2s ease;
		white-space: nowrap;
	}

	.filter-tabs__item:hover:not(.is-active) {
		background: var(--btn-regular-bg-hover);
		border-color: var(--accent);
	}

	.filter-tabs__item.is-active {
		background: var(--accent);
		color: white;
		border-color: var(--accent);
	}

	.filter-tabs__count {
		opacity: 0.65;
		font-size: var(--text-caption-size);
	}

	@media (width < 768px) {
		.filter-tabs {
			gap: 0.375rem;
		}

		.filter-tabs__item {
			padding: 0.4rem 0.8rem;
		}

		.filter-tabs__count {
			display: none;
		}
	}
</style>
