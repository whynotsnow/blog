---
import { BaseSlug } from "@/services/core/types";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import PanelCard from "@components/ui/PanelCard.astro";
export interface Props {
	class?: string;
	style?: string;

	tags: BaseSlug[];
	collapseThreshold?: number;
}

const { class: className, style, tags, collapseThreshold } = Astro.props;

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed =
	collapseThreshold !== undefined && tags.length >= collapseThreshold;
---

<PanelCard
	name={i18n(I18nKey.tags)}
	id="tags"
	isCollapsed={isCollapsed}
	collapsedHeight={COLLAPSED_HEIGHT}
	class={className}
	style={style}
>
	<div class="flex gap-2 flex-wrap">
		{
			tags.map((t) => (
				<ButtonTag
					href={getTagUrl(t.slug)}
					label={`View all posts with the ${t.name} tag`}
				>
					{`# ${t.name.trim()}`}
				</ButtonTag>
			))
		}
	</div>
</PanelCard>
