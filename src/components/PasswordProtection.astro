---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import PasswordProtectionView from "./password-protection/PasswordProtectionView.astro";
import type { PasswordProtectionClientConfig } from "./password-protection/types";

export interface Props {
	encryptedContent: string;
}

const { encryptedContent } = Astro.props;

const config: PasswordProtectionClientConfig = {
	encryptedContent,
	labels: {
		title: i18n(I18nKey.passwordProtectedTitle),
		description: i18n(I18nKey.passwordProtectedDescription),
		placeholder: i18n(I18nKey.passwordPlaceholder),
		unlock: i18n(I18nKey.passwordUnlock),
		unlocking: i18n(I18nKey.passwordUnlocking),
		incorrect: i18n(I18nKey.passwordIncorrect),
		passwordRequired: i18n(I18nKey.passwordRequired),
		decryptionError: i18n(I18nKey.decryptionError),
		passwordDecryptRetry: i18n(I18nKey.passwordDecryptRetry),
	},
};
---

<PasswordProtectionView config={config} />

<script>
	import {
		initPasswordProtection,
		initPasswordProtectionCopyButtons,
	} from "./password-protection/password-protection-client";

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", () => {
			void initPasswordProtection();
			initPasswordProtectionCopyButtons();
		});
	} else {
		void initPasswordProtection();
		initPasswordProtectionCopyButtons();
	}
</script>
