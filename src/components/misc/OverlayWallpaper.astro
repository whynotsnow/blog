---
import { siteConfig } from "../../config";
import type { OverlayWallpaperConfig } from "../../types/config";

interface Props {
	config: OverlayWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

// 获取当前设备类型的图片源
const getImageSources = async () => {
	const srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] => 
		Array.isArray(src) ? src : (typeof src === "string" ? [src] : []);

	if (typeof srcConfig === "object" && srcConfig !== null && !Array.isArray(srcConfig)) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages, mobile: allImages };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) return null;

// 轮播配置
const isCarouselEnabled = config.carousel?.enable && 
	(imageSources.desktop.length > 1 || imageSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;

// 样式配置
const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
const defaultWallpaperBlur = `${blurAmount}px`;
const positionClass = (() => {
	switch (position) {
		case "top": return "object-top";
		case "bottom": return "object-bottom";
		default: return "object-center";
	}
})();

const wallpaperOptions = {
	desktopImages: imageSources.desktop,
	mobileImages: imageSources.mobile,
	positionClass,
	isCarouselEnabled,
	carouselInterval,
	defaultWallpaperMode: siteConfig.wallpaperMode.defaultMode,
};
---

<div 
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none",
		className
	]}
	style={`z-index: ${zIndex}; --wallpaper-opacity: ${opacity}; --wallpaper-blur: ${defaultWallpaperBlur}; opacity: var(--wallpaper-opacity); transform: translateZ(0); perspective: 1000px;`}
	data-overlay-wallpaper
	data-overlay-wallpaper-initialized="false"
>
	<script
		id="overlay-wallpaper-options"
		is:inline
		type="application/json"
		set:html={JSON.stringify(wallpaperOptions)}
	></script>
</div>

<script is:inline>
	(function () {
		let wallpaperOptions;

		function readWallpaperOptions() {
			if (wallpaperOptions) return wallpaperOptions;
			const optionsScript = document.getElementById("overlay-wallpaper-options");
			wallpaperOptions = optionsScript?.textContent
				? JSON.parse(optionsScript.textContent)
				: null;
			return wallpaperOptions;
		}

		function getWallpaperMode() {
			return (
				localStorage.getItem("wallpaperMode") ||
				readWallpaperOptions()?.defaultWallpaperMode
			);
		}

		function getRandomImage(images, storageKey) {
			if (images.length === 0) return null;
			if (images.length === 1) return images[0];

			const lastIndex = sessionStorage.getItem(storageKey);
			let newIndex;

			do {
				newIndex = Math.floor(Math.random() * images.length);
			} while (newIndex === parseInt(lastIndex || "-1"));

			sessionStorage.setItem(storageKey, newIndex.toString());
			return images[newIndex];
		}

		function createImage(src, alt, positionClass, index) {
			const image = document.createElement("img");
			image.src = src;
			image.alt = alt;
			image.className = `absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}`;
			image.dataset.carouselItem = String(index);
			image.style.cssText = `transform: translateZ(0); backface-visibility: hidden; will-change: opacity; filter: blur(var(--wallpaper-blur)); opacity: ${index === 0 ? 1 : 0};`;
			image.decoding = "async";
			image.loading = index === 0 ? "eager" : "lazy";
			return image;
		}

		function appendGroup(container, group, positionClass) {
			if (!group.images.length) return;
			const wrapper = document.createElement("div");
			wrapper.className = `${group.containerClass} w-full h-full relative`;
			wrapper.style.transform = "translateZ(0)";
			group.images.forEach((src, index) => {
				wrapper.appendChild(
					createImage(
						src,
						`${group.key} wallpaper ${index + 1}`,
						positionClass,
						index,
					),
				);
			});
			container.appendChild(wrapper);
		}

		function appendSingleImage(container, src, className, alt, positionClass) {
			if (!src) return;
			const wrapper = document.createElement("div");
			wrapper.className = `${className} w-full h-full relative`;
			wrapper.style.transform = "translateZ(0)";
			wrapper.appendChild(createImage(src, alt, positionClass, 0));
			container.appendChild(wrapper);
		}

		function initOverlayWallpaperCarousel(container, carouselInterval) {
			if (!container) return;

			if (window.__overlayWallpaperCleanup) {
				window.__overlayWallpaperCleanup();
				window.__overlayWallpaperCleanup = null;
			}

			const STORAGE_KEY = 'mizuki_wallpaper_index';
			const savedIndex = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0');

			const groups = [
				container.querySelectorAll('.hidden.md\\:block [data-carousel-item]'),
				container.querySelectorAll('.block.md\\:hidden [data-carousel-item]')
			];

			const state = groups.map(items => {
				const safeIndex = (savedIndex >= 0 && savedIndex < items.length) ? savedIndex : 0;
				return {
					items,
					currentIndex: safeIndex,
					timer: null,
					active: items.length > 1
				};
			});

			// 初始化显示：根据 savedIndex 立即修正图片显示
			function initImage(stateItem) {
				const { items, currentIndex } = stateItem;
				// 立即设置样式，防止视觉上跳回第一张
				for (let i = 0; i < items.length; i++) {
					items[i].style.opacity = i === currentIndex ? '1' : '0';
				}
			}

			// 切换下一张
			function switchNextImage(stateItem) {
				const { items, currentIndex } = stateItem;
				const nextIndex = (currentIndex + 1) % items.length;
				
				items[currentIndex].style.opacity = '0';
				items[nextIndex].style.opacity = '1';
				
				stateItem.currentIndex = nextIndex;

				sessionStorage.setItem(STORAGE_KEY, nextIndex.toString());
			}

			function start() {
				state.forEach(s => {
					if (s.active && !s.timer) {
						s.timer = setInterval(() => {
							if (!document.body.contains(s.items[0])) {
								stop();
								return;
							}
							switchNextImage(s);
						}, carouselInterval * 1000);
					}
				});
			}

			function stop() {
				state.forEach(s => {
					if (s.timer) {
						clearInterval(s.timer);
						s.timer = null;
					}
				});
			}

			const handleVisibilityChange = () => {
				if (document.hidden) {
					stop();
				} else {
					const exists = state.some(s => s.items.length > 0 && document.body.contains(s.items[0]));
					if (exists) start();
				}
			};

			// 初始化状态
			state.forEach(s => {
				if (s.items.length > 0) initImage(s);
			});

			start();

			document.addEventListener('visibilitychange', handleVisibilityChange);

			window.__overlayWallpaperStart = start;
			window.__overlayWallpaperStop = stop;
			window.__overlayWallpaperCleanup = () => {
				stop();
				document.removeEventListener('visibilitychange', handleVisibilityChange);
			};
		}

		function ensureWallpaperImages() {
			const container = document.querySelector("[data-overlay-wallpaper]");
			const options = readWallpaperOptions();
			if (!container || !options) return;
			if (container.dataset.overlayWallpaperInitialized === "true") {
				window.__overlayWallpaperStart?.();
				return;
			}

			if (options.isCarouselEnabled) {
				appendGroup(container, {
					key: "desktop",
					images: options.desktopImages,
					containerClass: "hidden md:block",
				}, options.positionClass);
				appendGroup(container, {
					key: "mobile",
					images: options.mobileImages,
					containerClass: "block md:hidden",
				}, options.positionClass);
				initOverlayWallpaperCarousel(container, options.carouselInterval);
			} else {
				const desktopSrc = getRandomImage(options.desktopImages, "wallpaper_desktop_index");
				const mobileSrc = getRandomImage(options.mobileImages, "wallpaper_mobile_index");
				appendSingleImage(container, desktopSrc, "hidden lg:block", "desktop wallpaper", options.positionClass);
				appendSingleImage(container, mobileSrc, "block lg:hidden", "mobile wallpaper", options.positionClass);
			}
			container.dataset.overlayWallpaperInitialized = "true";
		}

		function syncOverlayWallpaper() {
			const container = document.querySelector("[data-overlay-wallpaper]");
			if (!container) return;
			if (getWallpaperMode() === "overlay") {
				container.style.display = "block";
				ensureWallpaperImages();
				return;
			}
			container.style.display = "none";
			window.__overlayWallpaperStop?.();
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", syncOverlayWallpaper, {
				once: true,
			});
		} else {
			syncOverlayWallpaper();
		}
		window.addEventListener("wallpaper-mode-change", syncOverlayWallpaper);
	})();
</script>
