---
import { Icon as AstroIcon } from "astro-icon/components";

export interface Props {
	icon: string;
	class?: string;
	style?: string;
	size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
	color?: string;
	fallback?: string;
	loading?: "lazy" | "eager";
}

const {
	icon,
	class: className = "",
	style = "",
	size = "md",
	color,
	fallback: _fallback,
	loading: _loading,
} = Astro.props;

const sizeClasses = {
	xs: "text-xs",
	sm: "text-sm",
	md: "text-base",
	lg: "text-lg",
	xl: "text-xl",
	"2xl": "text-2xl",
};

const sizeClass = sizeClasses[size] || sizeClasses.md;
const colorStyle = color ? `color: ${color};` : "";
const combinedStyle = `${colorStyle}${style}`;
const combinedClass = `${sizeClass} ${className}`.trim();
---

<AstroIcon name={icon} class={combinedClass} style={combinedStyle} />
