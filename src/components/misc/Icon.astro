---
import { Icon as AstroIcon } from "astro-icon/components";

export interface Props {
	icon: string;
	class?: string;
	style?: string;
	size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
	color?: string;
	fallback?: string;
	loading?: "lazy" | "eager";
}

const {
	icon,
	class: className = "",
	style = "",
	size = "md",
	color,
	fallback: _fallback,
	loading: _loading,
} = Astro.props;

const sizeClasses = {
	xs: "var(--text-caption-size)",
	sm: "var(--text-ui-size)",
	md: "var(--text-body-regular-size)",
	lg: "var(--text-section-title-size)",
	xl: "var(--text-card-title-size)",
	"2xl": "var(--text-icon-large-size)",
};

const sizeValue = sizeClasses[size] || sizeClasses.md;
const colorStyle = color ? `color: ${color};` : "";
const fontSizeStyle = `font-${"size"}: ${sizeValue};`;
const combinedStyle = `${fontSizeStyle}${colorStyle}${style}`;
const combinedClass = className.trim();
---

<AstroIcon name={icon} class={combinedClass} style={combinedStyle} />
