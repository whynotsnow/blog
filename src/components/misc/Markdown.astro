---
import "@fontsource-variable/jetbrains-mono";
import "@/styles/markdown.css";
import "@/styles/markdown-extend.css";
import "@/styles/expressive-code.css";

interface Props {
	class: string;
}

const className = Astro.props.class;
---

<div
	data-pagefind-body
	class={`post-content prose dark:prose-invert prose-base max-w-none! custom-md ds-reading-flow ${className}`}
>
	<slot />
</div>

<script>
	import { initializePostContent } from "@/components/modules/post-content/post-content-client";

	initializePostContent();
</script>
