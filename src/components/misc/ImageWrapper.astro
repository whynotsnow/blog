---
import path from "node:path";

interface Props {
	id?: string;
	src: string | ImageMetadata;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
}

import { Image } from "astro:assets";
import { url } from "../../utils/url";

const { id, src, alt, position = "center", basePath = "/", loading = "lazy" } = Astro.props;
const className = Astro.props.class;

const source = typeof src === "string" ? src : src.src;
const isMetadata = typeof src !== "string";
const isLocal = !isMetadata && !(
	source.startsWith("/") ||
	source.startsWith("http") ||
	source.startsWith("https") ||
	source.startsWith("data:")
);
const isPublic = source.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	const normalizedPath = path
		.normalize(path.join("../../", basePath, source))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;

// 检查是否是 Bilibili 图片
const isBilibiliImage = !isLocal && source.includes("hdslb.com");
// 对于外部图片（特别是Bilibili），需要设置referrerpolicy避免403错误
const referrerPolicy = !isLocal && isBilibiliImage ? "no-referrer" : undefined;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isMetadata && <Image src={src} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading}/>}
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading}/>}
    {!isMetadata && !isLocal && <img src={isPublic ? url(source) : source} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} referrerpolicy={referrerPolicy} crossorigin={isBilibiliImage ? "anonymous" : undefined}/>}
</div>
