---
import TypewriterText from "@components/TypewriterText.astro";
import type { SiteConfig } from "@/types/config";

interface Props {
	homeText: SiteConfig["banner"]["homeText"];
	showHomeText: boolean | undefined;
}

const { homeText, showHomeText } = Astro.props;
const subtitle = homeText?.subtitle;
---

{
	homeText?.enable && (
		<div
			data-setting-target="banner-home-text"
			class={`banner-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showHomeText ? "hidden" : ""}`}
		>
			<div class="w-4/5 lg:w-3/4 text-center mb-0">
				<div class="flex flex-col">
					{homeText.title && (
						<h1 class="banner-title text-6xl lg:text-8xl text-white drop-shadow-lg mb-2 lg:mb-4">
							{homeText.title}
						</h1>
					)}
					{subtitle && (
						<h2 class="banner-subtitle text-xl lg:text-3xl text-white/90 drop-shadow-md">
							<span class="inline-block min-h-[1.2em]">
								{homeText.typewriter?.enable ? (
									<TypewriterText
										text={subtitle}
										speed={homeText.typewriter.speed}
										deleteSpeed={homeText.typewriter.deleteSpeed}
										pauseTime={homeText.typewriter.pauseTime}
									/>
								) : Array.isArray(subtitle) ? (
									subtitle[0]
								) : (
									subtitle
								)}
							</span>
						</h2>
					)}
				</div>
			</div>
		</div>
	)
}
