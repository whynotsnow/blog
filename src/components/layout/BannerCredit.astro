---
import { Icon } from "astro-icon/components";
import type { SiteConfig } from "@/types/config";

interface Props {
	credit: SiteConfig["banner"]["credit"];
	hasCreditLink: boolean;
}

const { credit, hasCreditLink } = Astro.props;
---

{
	credit.enable && (
		<a
			href={credit.url}
			id="banner-credit"
			target="_blank"
			rel="noopener"
			aria-label="Visit image source"
			class:list={[
				"group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
					"px-3 right-4 -top-13 bg-black/60 hover:bg-black/70 h-9",
				{
					"hover:pr-9 active:bg-black/80": hasCreditLink,
				},
			]}
		>
			<Icon
				class="text-white/75 text-[1.25rem] mr-1"
				name="material-symbols:copyright-outline-rounded"
			/>
			<div class="text-white/75 text-xs">{credit.text}</div>
			<Icon
				class:list={[
					"transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
					{
						"group-hover:opacity-100": hasCreditLink,
					},
				]}
				name="fa7-solid:arrow-up-right-from-square"
			/>
		</a>
	)
}
