---
import type { MarkdownHeading } from "astro";
import BackToTop from "@components/control/BackToTop.astro";
import FloatingTOC from "@components/control/FloatingTOC.astro";
import Footer from "@components/Footer.astro";
import type { MainGridLayoutViewModel } from "@/services/layout/main-grid";
import type { ResolvedWidgetPlacement } from "@/services/widget/types";
import BannerCredit from "./BannerCredit.astro";
import SiteNoticeBar from "@components/site-notice/SiteNoticeBar.astro";
import type { SiteNoticeViewModel } from "@/services/site-notice";
import WidgetRegion from "./WidgetRegion.astro";
import SidebarTocRegion from "./SidebarTocRegion.astro";

interface Props {
	headings: MarkdownHeading[];
	widgets: ResolvedWidgetPlacement;
	viewModel: MainGridLayoutViewModel;
	siteNotice?: SiteNoticeViewModel;
}

const { headings, widgets, viewModel, siteNotice } = Astro.props;
const { transparentClass } = viewModel.mainPanel;
const usesContainerContent = viewModel.pageLayout.responsiveStrategy === "container-content";
---

	<div
	class={`main-content-layer absolute w-full z-30 pointer-events-none ${viewModel.mainPanel.mobileNonHomeClass} ${viewModel.mainPanel.noBannerLayoutClass} ${transparentClass}`}
	>
		<!-- The pointer-events-none here prevent blocking the click event of the TOC -->
		<div
			class:list={[
				"main-grid-shell relative mx-auto pointer-events-auto",
				{ "max-w-(--page-width)": !usesContainerContent },
			]}
			data-responsive-strategy={viewModel.pageLayout.responsiveStrategy}
		>
			<div id="site-notice-container">
				{siteNotice && <SiteNoticeBar notice={siteNotice} />}
			</div>
			<div
				id="swup-container"
			class="transition-swup-layout"
				data-navbar-behavior={viewModel.interaction.navbar}
				data-entry-scroll={viewModel.interaction.entryScroll}
			>
			<div
				id="main-grid"
				class:list={[
					"page-layout-grid transition duration-700 w-full left-0 right-0 grid grid-rows-none mx-auto",
					{ "gap-4 px-2 md:px-4": !usesContainerContent },
				]}
			data-base-desktop-layout={viewModel.pageLayout.desktop.base}
			data-allowed-desktop-layouts={viewModel.pageLayout.allowedDesktopLayouts}
			data-effective-desktop-layout={viewModel.pageLayout.desktop.base}
			data-responsive-strategy={viewModel.pageLayout.responsiveStrategy}
			data-supporting-flow={viewModel.pageLayout.supporting.flowLayout}
		>
			<BannerCredit
				credit={viewModel.banner.credit}
				hasCreditLink={viewModel.banner.hasCreditLink}
			/>

			<div class={`desktop-left-region ${transparentClass}`} data-has-widgets={widgets.desktop.left.length > 0}><WidgetRegion region="desktop-left" widgets={widgets.desktop.left} /></div>
			<div class={`desktop-right-region ${transparentClass}`} data-has-widgets={widgets.desktop.right.length > 0}><WidgetRegion region="desktop-right" widgets={widgets.desktop.right} /></div>
			<div class={`desktop-sidebar-region ${transparentClass}`} data-has-widgets={widgets.desktop.sidebar.length > 0}><WidgetRegion region="desktop-sidebar" widgets={widgets.desktop.sidebar} /></div>
			<div class={`tablet-sidebar-region ${transparentClass}`} data-has-widgets={widgets.tablet.sidebar.length > 0}><WidgetRegion region="tablet-sidebar" widgets={widgets.tablet.sidebar} /></div>
			<div class={`mobile-before-region ${transparentClass}`} data-has-widgets={widgets.mobile.beforeContent.length > 0}><WidgetRegion region="mobile-before-content" widgets={widgets.mobile.beforeContent} /></div>

			<main class="page-main-content overflow-hidden w-full">
				<div id="content-wrapper">
					<slot />
					<div class="footer col-span-full hidden lg:block">
						<Footer />
					</div>
				</div>
			</main>
			<div class={`mobile-after-region ${transparentClass}`} data-has-widgets={widgets.mobile.afterContent.length > 0}><WidgetRegion region="mobile-after-content" widgets={widgets.mobile.afterContent} /></div>

			<div class="footer col-span-full block lg:hidden">
				<Footer />
			</div>
		</div>
		<SidebarTocRegion headings={headings} viewModel={viewModel} />
		{viewModel.toc.enable && viewModel.toc.isFloat && <FloatingTOC />}
		</div>

		<BackToTop />
	</div>
</div>
