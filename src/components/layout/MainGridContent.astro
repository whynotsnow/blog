---
import type { MarkdownHeading } from "astro";
import Footer from "@components/Footer.astro";
import FloatingTools from "@/components/modules/floating-tools/FloatingTools.astro";
import type { MainGridLayoutViewModel } from "@/services/layout/main-grid";
import BannerCredit from "./BannerCredit.astro";
import type { FooterViewModel } from "@/services/footer";

interface Props {
	headings: MarkdownHeading[];
	viewModel: MainGridLayoutViewModel;
	footer: FooterViewModel;
	hasSupportContent: boolean;
}

const { viewModel, footer, hasSupportContent } = Astro.props;
const { transparentClass } = viewModel.mainPanel;
---

	<div
	class={`main-content-layer absolute w-full z-30 pointer-events-none ${viewModel.mainPanel.mobileNonHomeClass} ${viewModel.mainPanel.noBannerLayoutClass} ${transparentClass}`}
	>
		<!-- The pointer-events-none here keeps fixed shell controls clickable above page content. -->
		<div
			class="main-grid-shell relative mx-auto pointer-events-auto"
			data-shell-strategy={viewModel.pageLayout.shellStrategy}
		>
			<div
				id="swup-container"
			class="transition-swup-layout"
				data-navbar-behavior={viewModel.interaction.navbar}
				data-entry-scroll={viewModel.interaction.entryScroll}
			>
			<div
				id="main-grid"
				class="page-layout-grid transition duration-700 w-full left-0 right-0 grid grid-rows-none mx-auto"
			data-desktop-layout={viewModel.pageLayout.desktop.layout}
			data-shell-strategy={viewModel.pageLayout.shellStrategy}
			data-has-support={String(hasSupportContent)}
		>
			<BannerCredit
				credit={viewModel.banner.credit}
				hasCreditLink={viewModel.banner.hasCreditLink}
			/>

			{hasSupportContent && (
				<aside class={`page-support-region ${transparentClass}`}>
					<div class="support-module-slot w-full">
						<slot name="support" />
					</div>
				</aside>
			)}

			<main class="page-main-content overflow-hidden w-full">
				<div id="content-wrapper">
					<slot />
				</div>
			</main>
			<div class="site-footer-region">
				<Footer
					model={footer}
					shellStrategy={viewModel.pageLayout.shellStrategy}
				/>
			</div>
		</div>
		</div>

	</div>
</div>

<FloatingTools />
