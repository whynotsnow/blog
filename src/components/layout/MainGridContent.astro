---
import type { MarkdownHeading } from "astro";
import BackToTop from "@components/control/BackToTop.astro";
import FloatingTOC from "@components/control/FloatingTOC.astro";
import Footer from "@components/Footer.astro";
import type { MainGridLayoutViewModel } from "@/services/layout/main-grid";
import type { ResolvedWidgetPlacement } from "@/services/widget/types";
import BannerCredit from "./BannerCredit.astro";
import WidgetRegion from "./WidgetRegion.astro";
import SidebarTocRegion from "./SidebarTocRegion.astro";

interface Props {
	headings: MarkdownHeading[];
	widgets: ResolvedWidgetPlacement;
	viewModel: MainGridLayoutViewModel;
}

const { headings, widgets, viewModel } = Astro.props;
const { transparentClass } = viewModel.mainPanel;
---

<div
	class={`main-content-layer absolute w-full z-30 pointer-events-none ${viewModel.mainPanel.mobileNonHomeClass} ${viewModel.mainPanel.noBannerLayoutClass} ${transparentClass}`}
>
	<!-- The pointer-events-none here prevent blocking the click event of the TOC -->
	<div class="main-grid-shell relative max-w-(--page-width) mx-auto pointer-events-auto">
		<div id="swup-container" class="transition-swup-layout">
		<div
			id="main-grid"
			class="page-layout-grid transition duration-700 w-full left-0 right-0 grid grid-rows-none mx-auto gap-4 px-2 md:px-4"
			data-base-desktop-layout={viewModel.pageLayout.desktop.base}
			data-allowed-desktop-layouts={viewModel.pageLayout.allowedDesktopLayouts}
			data-effective-desktop-layout={viewModel.pageLayout.desktop.base}
		>
			<BannerCredit
				credit={viewModel.banner.credit}
				hasCreditLink={viewModel.banner.hasCreditLink}
			/>

			<div class={`desktop-left-region ${transparentClass}`}><WidgetRegion region="desktop-left" widgets={widgets.desktop.left} /></div>
			<div class={`desktop-right-region ${transparentClass}`}><WidgetRegion region="desktop-right" widgets={widgets.desktop.right} /></div>
			<div class={`desktop-sidebar-region ${transparentClass}`}><WidgetRegion region="desktop-sidebar" widgets={widgets.desktop.sidebar} /></div>
			<div class={`tablet-sidebar-region ${transparentClass}`}><WidgetRegion region="tablet-sidebar" widgets={widgets.tablet.sidebar} /></div>
			<div class={`mobile-before-region ${transparentClass}`}><WidgetRegion region="mobile-before-content" widgets={widgets.mobile.beforeContent} /></div>

			<main class="page-main-content overflow-hidden w-full">
				<div id="content-wrapper">
					<slot />
					<div class="footer col-span-full hidden lg:block">
						<Footer />
					</div>
				</div>
			</main>
			<div class={`mobile-after-region ${transparentClass}`}><WidgetRegion region="mobile-after-content" widgets={widgets.mobile.afterContent} /></div>

			<div class="footer col-span-full block lg:hidden">
				<Footer />
			</div>
		</div>
		<SidebarTocRegion headings={headings} viewModel={viewModel} />
		{viewModel.toc.enable && viewModel.toc.isFloat && <FloatingTOC />}
		</div>

		<BackToTop />
	</div>
</div>
