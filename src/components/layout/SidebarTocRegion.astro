---
import type { MarkdownHeading } from "astro";
import TOC from "@components/widget/TOC.astro";
import type { MainGridLayoutViewModel } from "@/services/layout/main-grid";

interface Props {
	headings: MarkdownHeading[];
	viewModel: MainGridLayoutViewModel;
}

const { headings, viewModel } = Astro.props;
const usesContainerContent = viewModel.pageLayout.responsiveStrategy === "container-content";
---

{
	viewModel.toc.enable && viewModel.toc.isSidebar && (
		<div
			class:list={[
				"sidebar-toc-region absolute w-full z-0",
				usesContainerContent
					? "sidebar-toc-region--container"
					: "hidden 2xl:block",
			]}
		>
			<div
				class:list={[
					"relative",
					{ "max-w-(--page-width) mx-auto": !usesContainerContent },
				]}
			>
				<div
					id="toc-wrapper"
					class:list={[
						"transition absolute top-0 items-center",
						usesContainerContent
							? "sidebar-toc-region__rail"
							: "hidden lg:block w-(--toc-width) -right-(--toc-width)",
						{
							"toc-hide": viewModel.toc.hideSidebarOnLoad,
						},
					]}
				>
					<div
						id="toc-inner-wrapper"
						class:list={[
							"fixed top-14 max-h-[calc(100vh-10rem)] overflow-hidden",
							usesContainerContent
								? "sidebar-toc-region__inner"
								: "w-(--toc-width)",
						]}
					>
						<div id="toc-container" class="w-full transition-swup-fade">
							<TOC headings={headings} />
						</div>
					</div>
				</div>
			</div>
		</div>
	)
}

{
	(!viewModel.toc.enable || viewModel.toc.isFloat) && (
		<div id="toc-container" class="hidden" />
	)
}
