---
import type { ResolvedWidget } from "@/services/widget/types";

interface Props {
	widgets: ResolvedWidget[];
	region: string;
	class?: string;
}

const { widgets, region, class: className } = Astro.props;
const flowWidgets = widgets.filter((widget) => widget.position === "flow");
const stickyWidgets = widgets.filter((widget) => widget.position === "sticky");
---

<aside class:list={["widget-region w-full h-full", className]} data-widget-region={region}>
	{flowWidgets.length > 0 && (
		<div class="flex flex-col w-full gap-4 mb-4">
			{flowWidgets.map(({ component: Component, resolvedProps, className, resolvedStyle, id }) => (
				<div class="sidebar-widget-slot grid w-full" data-widget-id={id}>
					<Component {...resolvedProps} class={className} style={resolvedStyle} />
				</div>
			))}
		</div>
	)}
	{stickyWidgets.length > 0 && (
		<div class="widget-region-sticky transition-all duration-700 flex flex-col w-full gap-4 xl:sticky xl:top-4">
			{stickyWidgets.map(({ component: Component, resolvedProps, className, resolvedStyle, id }) => (
				<div class="sidebar-widget-slot grid w-full" data-widget-id={id}>
					<Component {...resolvedProps} class={className} style={resolvedStyle} />
				</div>
			))}
		</div>
	)}
</aside>
