---
import type { MarkdownHeading } from "astro";
import { WidgetManager } from "@/utils/widget-manager";
import { getWidgetComponentMap } from "@/services/widget/resolver";
import type { ContentStore } from "@/services/core/types";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	store: ContentStore;
	widgetManager: WidgetManager;
}

const { class: className, headings, store, widgetManager } = Astro.props;

// 获取右侧边栏的组件列表
const topComponents = widgetManager.getComponentsByPosition("top", "right");
const stickyComponents = widgetManager.getComponentsByPosition(
	"sticky",
	"right",
);

// 组件映射表
const widgetMap = getWidgetComponentMap({
	store,
	headings,
});

function renderComponent(
	componentConfig: WidgetComponentConfig,
	index: number,
) {
	const definition = widgetMap[componentConfig.type];
	if (!definition) return null;

	const componentClass = widgetManager.getComponentClass(
		componentConfig,
		index,
	);
	const componentStyle = widgetManager.getComponentStyle(
		componentConfig,
		index,
	);

	return {
		Component: definition.component,
		props: {
			...definition.props,
			class: componentClass,
			style: componentStyle,
			...componentConfig.customProps,
		},
	};
}
---

<div id="right-sidebar" class:list={[className, "w-full h-full"]}>
	<!-- 顶部固定组件区域 -->
	{
		topComponents.length > 0 && (
			<div class="flex flex-col w-full gap-4 mb-4">
				{topComponents.map((component, index) => {
					const renderData = renderComponent(component, index);
					if (!renderData) return null;

					const { Component, props } = renderData;
					return (
						<div class="sidebar-widget-slot sidebar-widget-slot-right grid w-full">
							<Component {...props} />
						</div>
					);
				})}
			</div>
		)
	}

	<!-- 粘性组件区域 -->
	{
		stickyComponents.length > 0 && (
			<div
				id="right-sidebar-sticky"
				class="transition-all duration-700 flex flex-col w-full gap-4 lg:sticky lg:top-4"
			>
				{stickyComponents.map((component, index) => {
					const renderData = renderComponent(component, index);
					if (!renderData) return null;

					const { Component, props } = renderData;
					return (
						<div class="sidebar-widget-slot sidebar-widget-slot-right grid w-full">
							<Component {...props} />
						</div>
					);
				})}
			</div>
		)
	}
</div>

<!-- 响应式样式和JavaScript -->
<style>
	/* 响应式断点样式 */
	@media (max-width: 768px) {
		#right-sidebar {
			display: var(--sidebar-mobile-display, block);
		}
	}

	@media (min-width: 769px) and (max-width: 1280px) {
		#right-sidebar {
			display: var(--sidebar-tablet-display, block);
		}
	}

	@media (min-width: 1281px) {
		#right-sidebar {
			display: var(--sidebar-desktop-display, block);
		}
	}
</style>

<script>
	import { widgetManager } from "../../utils/widget-manager";
	import { onPageLifecycle } from "@/utils/page-lifecycle";

	// 响应式布局管理
	class RightSidebarManager {
		constructor() {
			this.init();
		}

		init() {
			this.updateResponsiveDisplay();
			window.addEventListener("resize", () =>
				this.updateResponsiveDisplay(),
			);

			onPageLifecycle("content-replace", () => {
				setTimeout(() => {
					this.updateResponsiveDisplay();
				}, 100);
			});
		}

		updateResponsiveDisplay() {
			const breakpoints = widgetManager.getBreakpoints();
			const width = window.innerWidth;

			let deviceType: "mobile" | "tablet" | "desktop";
			if (width < breakpoints.mobile) {
				deviceType = "mobile";
			} else if (width < breakpoints.tablet) {
				deviceType = "tablet";
			} else {
				deviceType = "desktop";
			}

			const shouldShow = widgetManager.shouldShowSidebar(deviceType);
			const sidebar = document.getElementById("right-sidebar");

			if (sidebar) {
				sidebar.style.setProperty(
					`--sidebar-${deviceType}-display`,
					shouldShow ? "block" : "none",
				);
			}
		}
	}

	// 初始化右侧边栏管理器
	new RightSidebarManager();
</script>
