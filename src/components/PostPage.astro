---
import { siteConfig } from "../config";
import PostCard from "./PostCard.astro";
import PostTaxonomyNav from "./post/PostTaxonomyNav.svelte";
import type { PostNavigatorCategory, UIPost } from "@/services/core/types";
import "@/features/post-list/post-list.css";

interface Props {
	posts: UIPost[];
	categories: PostNavigatorCategory[];
}

const { posts, categories } = Astro.props;
const { slug } = Astro.params;

// 根据配置设置初始布局模式
const defaultLayout = siteConfig.postListLayout.defaultMode || "list";
const initialLayoutClass = defaultLayout === "grid" ? "grid-mode" : "list-mode";
---

<div
	id="page-content"
	class="home-post-feed ds-stack mx-auto w-full max-w-(--width-listing)"
	style="--stack-space: var(--size-4);"
>
	<PostTaxonomyNav categories={categories} currentCategory={slug} />

	<div
		id="post-list-container"
		class={`post-list home-post-list rounded-(--radius-large) bg-(--surface-card) md:bg-transparent mb-4 ${initialLayoutClass}`}
		data-default-layout={defaultLayout}
		data-post-list-renderer="astro"
	>
		{
			posts.map((entry, index) => (
				<PostCard
					entry={entry}
					class:list="post-list__item"
					style={`--i: ${index}; --interval: 50ms;`}
				/>
			))
		}
	</div>
</div>
