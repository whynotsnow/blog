---
import { commentConfig } from "@/config";
import Twikoo from "./Twikoo.astro";

interface Props {
	enabled: boolean;
	path: string;
}

const { enabled, path } = Astro.props;

let commentService = "";
if (commentConfig?.enable && commentConfig?.twikoo) {
	commentService = "twikoo";
}

---
{commentConfig?.enable && enabled && (
  <div class="card-base ds-surface-card p-6 mb-4">
    {commentService === 'twikoo' && <Twikoo path={path} />}
    {commentService === '' && null}
  </div>
)}
