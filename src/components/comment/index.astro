---
import { commentConfig } from "@/config";
import Twikoo from "./Twikoo.astro";

interface Props {
	enabled: boolean;
	path: string;
	class?: string;
	bare?: boolean;
}

const { enabled, path, class: className, bare = false } = Astro.props;

let commentService = "";
if (commentConfig?.enable && commentConfig?.twikoo) {
	commentService = "twikoo";
}

---
{commentConfig?.enable && enabled && (
  <div class:list={[!bare && "comment-card card-base ds-surface-card", className]}>
    {commentService === 'twikoo' && <Twikoo path={path} />}
    {commentService === '' && null}
  </div>
)}

<style>
  .comment-card {
    padding: var(--space-card);
    margin-bottom: var(--space-content);
  }
</style>
