---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div
	id="tcomment"
	data-twikoo-root
	data-twikoo-config={JSON.stringify(config)}
></div>
<script>
	import "./twikoo-client";
</script>

<style>
	#tcomment[data-twikoo-state="error"] {
		padding: var(--space-card);
		color: var(--text-secondary);
		font-size: var(--text-ui-size);
		text-align: center;
	}
</style>
