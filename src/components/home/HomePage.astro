---
import type { HomePageViewModel } from "@/services/home";
import HomeSection from "./HomeSection.astro";

interface Props {
	model: HomePageViewModel;
}

const { model } = Astro.props;
---

<div id="page-content" class="listing-page home-page ds-stack w-full" style="--stack-space: var(--space-section);">
	{model.sections.map((section) => <HomeSection section={section} />)}
</div>
