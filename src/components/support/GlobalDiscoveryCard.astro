---
import { Icon } from "astro-icon/components";
import type { GlobalDiscoveryCardViewModel } from "@/services/support";

interface Props {
	card: GlobalDiscoveryCardViewModel;
	class?: string;
}

const { card, class: className } = Astro.props;
---

<section
	class:list={["global-discovery-card ds-surface-card", className]}
	data-discovery-card={card.id}
>
	<a href={card.url} class="global-discovery-card__header">
		<h2 class="global-discovery-card__heading">
			<Icon name={card.icon} />
			<span>{card.title}</span>
		</h2>
		<Icon
			name="material-symbols:chevron-right-rounded"
			class="global-discovery-card__enter"
		/>
	</a>
	{
		card.items.length > 0 && (
			<div class="global-discovery-card__items">
				{card.items.map((item) => (
					<a href={item.url} class="global-discovery-card__item">
						<span>{item.label}</span>
						<small>{item.type === "category" ? item.count : item.meta}</small>
					</a>
				))}
			</div>
		)
	}
</section>

<style>
	.global-discovery-card {
		--global-discovery-heading-size: var(--text-ui-emphasis-size);
		--global-discovery-heading-icon-size: var(--text-icon-inline-size);
		--global-discovery-item-size: var(--text-ui-size);
		width: 100%;
		padding: var(--space-card);
	}

	.global-discovery-card__header {
		display: flex;
		min-width: 0;
		align-items: center;
		justify-content: space-between;
		gap: var(--size-2);
		color: var(--text-primary);
	}

	.global-discovery-card__heading {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: var(--size-2);
		font-size: var(--global-discovery-heading-size);
		font-weight: 800;
		line-height: 1.25;
	}

	.global-discovery-card__heading :global(svg),
	.global-discovery-card__enter {
		flex: none;
		color: var(--accent);
		font-size: var(--global-discovery-heading-icon-size);
	}

	.global-discovery-card__heading span {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.global-discovery-card__enter {
		transition: transform var(--motion-fast) var(--motion-ease-standard);
	}

	.global-discovery-card__header:hover {
		color: var(--accent);
	}

	.global-discovery-card__header:hover .global-discovery-card__enter {
		transform: translateX(0.125rem);
	}

	.global-discovery-card__items {
		display: grid;
		gap: var(--size-2);
		margin-top: var(--size-3);
	}

	.global-discovery-card__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--size-2);
		min-width: 0;
		padding: var(--size-3);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		color: var(--text-secondary);
		font-size: var(--text-meta-size);
		font-weight: 700;
		line-height: 1.35;
		transition:
			color var(--motion-fast) var(--motion-ease-standard),
			border-color var(--motion-fast) var(--motion-ease-standard);
	}

	.global-discovery-card__item:hover {
		border-color: var(--border-strong);
		color: var(--accent);
	}

	.global-discovery-card__item span {
		overflow: hidden;
		color: var(--text-primary);
		font-size: var(--global-discovery-item-size);
		font-weight: 800;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.global-discovery-card__item:hover span {
		color: var(--accent);
	}

	.global-discovery-card__item small {
		color: var(--text-muted);
		font-size: var(--text-meta-size);
	}
</style>
