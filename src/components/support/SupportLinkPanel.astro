---
import { Icon } from "astro-icon/components";

export type SupportPanelLink = {
	label: string;
	url: string;
	count?: number;
	description?: string;
};

interface Props {
	title: string;
	icon: string;
	links: SupportPanelLink[];
	featuredLinks?: SupportPanelLink[];
	class?: string;
}

const {
	title,
	icon,
	links,
	featuredLinks = [],
	class: className,
} = Astro.props;
---

{
	(featuredLinks.length > 0 || links.length > 0) && (
		<section class:list={["support-link-panel ds-surface-card", className]}>
			<h2 class="support-link-panel__heading">
				<Icon name={icon} />
				{title}
			</h2>
			{featuredLinks.length > 0 && (
				<div class="support-link-panel__featured-links">
					{featuredLinks.map((link) => (
						<a href={link.url} class="support-link-panel__featured-link">
							<span>{link.label}</span>
							{link.description && <small>{link.description}</small>}
						</a>
					))}
				</div>
			)}
			{links.length > 0 && (
				<div class="support-link-panel__links">
					{links.map((link) => (
						<a href={link.url} class="support-link-panel__link">
							<span>{link.label}</span>
							{typeof link.count === "number" && <small>{link.count}</small>}
						</a>
					))}
				</div>
			)}
		</section>
	)
}

<style>
	.support-link-panel {
		--support-link-panel-heading-size: var(--text-ui-emphasis-size);
		--support-link-panel-heading-icon-size: var(--text-icon-inline-size);
		--support-link-panel-item-title-size: var(--text-ui-size);
		padding: var(--space-card);
	}

	.support-link-panel__heading {
		display: flex;
		align-items: center;
		gap: var(--size-2);
		margin-bottom: var(--size-3);
		color: var(--text-primary);
		font-size: var(--support-link-panel-heading-size);
		font-weight: 800;
	}

	.support-link-panel__heading :global(svg) {
		color: var(--accent);
		font-size: var(--support-link-panel-heading-icon-size);
	}

	.support-link-panel__featured-links,
	.support-link-panel__links {
		display: grid;
		gap: var(--size-2);
	}

	.support-link-panel__featured-links {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-bottom: var(--size-2);
	}

	.support-link-panel__featured-link,
	.support-link-panel__link {
		display: grid;
		min-width: 0;
		align-items: center;
		gap: var(--size-2);
		padding: var(--size-3);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		color: var(--text-secondary);
		font-size: var(--text-meta-size);
		font-weight: 700;
		line-height: 1.35;
		transition:
			color var(--motion-fast) var(--motion-ease-standard),
			border-color var(--motion-fast) var(--motion-ease-standard);
	}

	.support-link-panel__link {
		grid-template-columns: minmax(0, 1fr) auto;
	}

	.support-link-panel__featured-link:hover,
	.support-link-panel__link:hover {
		border-color: var(--border-strong);
		color: var(--accent);
	}

	.support-link-panel__featured-link span,
	.support-link-panel__link span {
		overflow: hidden;
		color: var(--text-primary);
		font-size: var(--support-link-panel-item-title-size);
		font-weight: 800;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.support-link-panel__featured-link:hover span,
	.support-link-panel__link:hover span {
		color: var(--accent);
	}

	.support-link-panel__featured-link small,
	.support-link-panel__link small {
		color: var(--text-muted);
		font-size: var(--text-meta-size);
	}
</style>
