{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Agent Workspace Session Profile",
	"type": "object",
	"required": [
		"schema_version",
		"spec_version",
		"session_id",
		"developer_id",
		"machine_id",
		"started_at",
		"capabilities"
	],
	"properties": {
		"spec_version": { "const": "0.1.0" },
		"schema_version": { "const": 1 },
		"session_id": { "type": "string", "pattern": "^session_[a-f0-9]{12}$" },
		"developer_id": { "type": "string", "pattern": "^dev_[a-f0-9]{12}$" },
		"machine_id": { "type": "string", "pattern": "^machine_[a-f0-9]{12}$" },
		"started_at": { "type": "string", "format": "date-time" },
		"capabilities": { "type": "object" }
	},
	"additionalProperties": false
}
