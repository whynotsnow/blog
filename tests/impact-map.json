{
	"version": 1,
	"groups": {
		"workspace": [
			"node",
			".agent-workspace/tools/agent-workspace.mjs",
			"validate"
		],
		"markdown": ["pnpm", "lint:md"],
		"lint": ["pnpm", "lint"],
		"type": ["pnpm", "type-check"],
		"script-type": ["pnpm", "type-check:scripts"],
		"svelte-type": ["pnpm", "type-check:svelte"],
		"test-type": ["pnpm", "type-check:tests"],
		"astro": ["pnpm", "check"],
		"design": ["pnpm", "design:check"],
		"unit": ["pnpm", "test:unit"],
		"integration": ["pnpm", "test:integration"],
		"smoke": ["pnpm", "test:e2e:smoke"],
		"shell": ["pnpm", "test:e2e:shell"],
		"home": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/home.spec.ts"
		],
		"page-support": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/page-support.spec.ts"
		],
		"post-list": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/post-list.spec.ts"
		],
		"post-detail": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/post-detail.spec.ts"
		],
		"post-support-toc": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/post-detail.spec.ts",
			"-g",
			"post support TOC owns internal overflow without sidebar scrollbar"
		],
		"activity-center": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/activity-center.spec.ts"
		],
		"floating-tools": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/floating-tools.spec.ts"
		],
		"albums-diary": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/albums-diary.spec.ts"
		],
		"floating-toc": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/features/floating-tools.spec.ts",
			"-g",
			"floating TOC progress ring geometry"
		],
		"design-contract": [
			"pnpm",
			"exec",
			"playwright",
			"test",
			"tests/e2e/contracts/design-system.spec.ts"
		],
		"astro-build": ["pnpm", "build:astro"],
		"full": ["pnpm", "verify:full"],
		"declaration-type": ["pnpm", "type-check:declarations"]
	},
	"coverage": ["src/components/modules/**", "tests/e2e/**"],
	"rules": [
		{
			"patterns": [".gitignore"],
			"groups": ["lint", "script-type"]
		},
		{
			"patterns": [
				"AGENTS.md",
				"docs/agents/**",
				".agent-workspace/**",
				"spec/agent-workspace/**"
			],
			"groups": ["workspace", "markdown"]
		},
		{
			"patterns": ["README.md", "docs/developers/**", "docs/README.md"],
			"groups": ["markdown"]
		},
		{
			"patterns": [
				"src/design/**",
				"scripts/check-design-system.mjs",
				"scripts/typography-inventory.mjs",
				"scripts/design-system-baseline.json"
			],
			"groups": ["lint", "astro", "design", "design-contract"]
		},
		{
			"patterns": [
				"src/services/core/**",
				"src/content.config.ts",
				"src/content-source.ts",
				"src/utils/url-utils.ts"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"unit",
				"integration",
				"astro-build",
				"smoke"
			]
		},
		{
			"patterns": [
				"src/components/modules/floating-tools/FloatingTOC.astro"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"svelte-type",
				"astro",
				"design",
				"floating-tools",
				"post-detail"
			]
		},
		{
			"patterns": [
				"src/components/Navbar.astro",
				"src/components/modules/shell-controls/**",
				"src/components/modules/shell-panels/**"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"svelte-type",
				"astro",
				"design",
				"shell",
				"smoke"
			]
		},
		{
			"patterns": [
				"src/components/modules/**",
				"src/components/modules/floating-tools/BackToTop.astro",
				"src/components/modules/floating-tools/settings/**",
				"src/components/ui/local-icons.ts",
				"src/config/live2d-companion.ts",
				"src/config/music.ts"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"svelte-type",
				"astro",
				"design",
				"floating-tools"
			]
		},
		{
			"patterns": ["public/live2d-companion/**"],
			"groups": ["astro", "floating-tools"]
		},
		{
			"patterns": ["public/assets/js/mermaid-*.min.js"],
			"groups": ["astro", "astro-build", "post-detail"]
		},
		{
			"patterns": ["src/assets/icons/**"],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"svelte-type",
				"astro",
				"design",
				"floating-tools"
			]
		},
		{
			"patterns": ["src/content/**"],
			"groups": ["astro", "integration", "astro-build", "smoke"]
		},
		{
			"patterns": [
				"src/layouts/**",
				"src/styles/layout/**",
				"src/styles/main-grid-layout.css",
				"src/styles/transition.css",
				"src/components/layout/main-grid-client.ts",
				"src/scripts/layout-client.ts",
				"src/global.d.ts",
				"src/utils/page-lifecycle.ts",
				"src/services/layout/**"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"unit",
				"shell",
				"smoke"
			]
		},
		{
			"patterns": ["src/scripts/**"],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"shell",
				"smoke"
			]
		},
		{
			"patterns": ["src/plugins/**"],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"astro-build"
			]
		},
		{
			"patterns": ["public/js/**"],
			"groups": ["lint", "astro"]
		},
		{
			"patterns": [
				"src/pages/index.astro",
				"src/services/home.ts",
				"src/components/home/**"
			],
			"groups": ["lint", "astro", "home"]
		},
		{
			"patterns": ["src/pages/anime.astro", "src/components/anime/**"],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"design",
				"astro-build",
				"smoke"
			]
		},
		{
			"patterns": [
				"src/pages/albums.astro",
				"src/pages/albums/**",
				"src/pages/diary.astro",
				"src/components/albums/**",
				"src/components/diary/**",
				"src/components/filter-tabs/**",
				"src/components/modules/diary/**",
				"src/components/albums/albums.css",
				"src/styles/fancybox-custom.css",
				"src/types/album.ts",
				"src/utils/album-scanner.ts",
				"public/images/albums/**",
				"src/utils/timeFormat.ts"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"unit",
				"albums-diary"
			]
		},
		{
			"patterns": [
				"src/pages/about.astro",
				"src/pages/friends.astro",
				"src/components/friends/**",
				"src/components/page/**"
			],
			"groups": ["lint", "type", "declaration-type", "astro", "design"]
		},
		{
			"patterns": [
				"src/pages/projects.astro",
				"src/components/projects/**",
				"src/services/projects.ts"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"design",
				"astro-build",
				"smoke"
			]
		},
		{
			"patterns": [
				"src/components/footer/**",
				"src/components/profile/**",
				"src/components/layout/MainGridContent.astro",
				"src/services/footer.ts",
				"src/services/support.ts",
				"src/services/layout/presets.ts"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"home",
				"post-list",
				"post-detail",
				"page-support"
			]
		},
		{
			"patterns": [
				"src/services/site-notice.ts",
				"src/content/notifications/**",
				"src/components/modules/activity-center/**"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"integration",
				"activity-center"
			]
		},
		{
			"patterns": [
				"src/config/category-slugs.ts",
				"src/data/category-assets.ts",
				"src/pages/category/**",
				"src/pages/api/categories/**",
				"src/components/category/**",
				"src/components/post/**",
				"src/components/modules/post-list/**",
				"src/services/category-page.ts"
			],
			"groups": ["lint", "type", "declaration-type", "astro", "post-list"]
		},
		{
			"patterns": [
				"src/services/feed.ts",
				"src/pages/rss.xml.ts",
				"src/pages/atom.xml.ts"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"unit",
				"integration",
				"astro-build"
			]
		},
		{
			"patterns": [
				"src/components/misc/SharePoster.svelte",
				"src/components/misc/share-poster/**"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"svelte-type",
				"astro",
				"design",
				"post-detail"
			]
		},
		{
			"patterns": [
				"public/assets/js/twikoo.nocss.js",
				"public/assets/css/twikoo.css",
				"src/components/comment/**",
				"src/components/post-detail/**",
				"src/components/password-protection/**",
				"src/components/Encryptor.astro",
				"src/components/PasswordProtection.astro",
				"src/components/modules/post-content/**",
				"src/services/post-detail/**",
				"src/pages/posts/**"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"astro",
				"post-detail"
			]
		},
		{
			"patterns": ["src/components/post-toc/**"],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"svelte-type",
				"astro",
				"post-detail"
			]
		},
		{
			"patterns": ["tests/unit/**"],
			"groups": ["test-type", "unit"]
		},
		{
			"patterns": ["tests/content/**"],
			"groups": [
				"test-type",
				"unit",
				"home",
				"page-support",
				"post-list",
				"post-detail",
				"activity-center",
				"floating-tools",
				"shell",
				"design-contract",
				"smoke"
			]
		},
		{
			"patterns": ["tests/integration/**"],
			"groups": ["test-type", "integration"]
		},
		{
			"patterns": ["tests/e2e/smoke/**"],
			"groups": ["test-type", "smoke"]
		},
		{
			"patterns": ["tests/support/content-fixtures.ts"],
			"groups": [
				"test-type",
				"home",
				"page-support",
				"post-list",
				"post-detail",
				"activity-center",
				"floating-tools",
				"shell",
				"design-contract",
				"smoke"
			]
		},
		{
			"patterns": ["tests/e2e/shell/**"],
			"groups": ["test-type", "shell"]
		},
		{
			"patterns": ["tests/e2e/features/home.spec.ts"],
			"groups": ["test-type", "home"]
		},
		{
			"patterns": ["tests/e2e/features/page-support.spec.ts"],
			"groups": ["test-type", "page-support"]
		},
		{
			"patterns": ["tests/e2e/features/post-list.spec.ts"],
			"groups": ["test-type", "post-list"]
		},
		{
			"patterns": ["tests/e2e/features/post-detail.spec.ts"],
			"groups": ["test-type", "post-detail"]
		},
		{
			"patterns": ["tests/e2e/features/site-notice.spec.ts"],
			"groups": ["test-type", "activity-center"]
		},
		{
			"patterns": ["tests/e2e/features/activity-center.spec.ts"],
			"groups": ["test-type", "activity-center"]
		},
		{
			"patterns": ["tests/e2e/features/floating-tools.spec.ts"],
			"groups": ["test-type", "floating-tools"]
		},
		{
			"patterns": ["tests/e2e/features/albums-diary.spec.ts"],
			"groups": ["test-type", "albums-diary"]
		},
		{
			"patterns": ["tests/e2e/contracts/**"],
			"groups": ["test-type", "design-contract"]
		},
		{
			"patterns": [
				"package.json",
				"pnpm-lock.yaml",
				"astro.config.*",
				"tsconfig*.json",
				"eslint.config.*",
				"playwright.config.*",
				"vitest.config.*",
				"tests/impact-map.json",
				"scripts/pre-commit-check.mjs",
				"scripts/test-impact.mjs",
				"scripts/check-env.mjs",
				"tsconfig.scripts.json",
				".nvmrc",
				".github/workflows/**",
				"vercel.json"
			],
			"groups": [
				"lint",
				"type",
				"declaration-type",
				"svelte-type",
				"script-type",
				"test-type",
				"unit",
				"astro"
			],
			"ciGroups": ["full"]
		},
		{
			"patterns": [
				"scripts/content-sync/**",
				"scripts/prepare-content.mjs",
				"scripts/prepare-dev-content.mjs",
				"scripts/init-content-repo.js",
				"scripts/fonts/**"
			],
			"groups": ["lint", "script-type", "integration", "astro-build"],
			"ciGroups": ["full"]
		},
		{
			"patterns": [
				"scripts/*.js",
				"scripts/*.mjs",
				"scripts/**/*.js",
				"scripts/**/*.mjs"
			],
			"groups": ["lint", "script-type"]
		}
	],
	"fallback": [],
	"ciFallback": ["full"]
}
