{
	"name": "mizuki",
	"type": "module",
	"version": "8.3",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"check-env": "node scripts/check-env.mjs",
		"content:prepare": "node scripts/prepare-content.mjs",
		"sync-content": "pnpm content:prepare",
		"init-content": "node scripts/init-content-repo.js",
		"predev": "node scripts/check-env.mjs",
		"prebuild": "node scripts/check-env.mjs",
		"dev": "pnpm content:prepare && pnpm font:prepare && astro dev --host",
		"start": "pnpm content:prepare && pnpm font:prepare && astro dev",
		"precheck": "node scripts/check-env.mjs && pnpm content:prepare && pnpm font:prepare",
		"check": "astro check --minimumFailingSeverity hint",
		"update-anime": "node scripts/update-anime.mjs",
		"update-bangumi": "node scripts/update-bangumi.mjs",
		"update-bilibili": "node scripts/update-bilibili.mjs",
		"build": "pnpm content:prepare && node scripts/update-anime.mjs && pnpm font:prepare && astro build && pagefind --site dist",
		"build:astro": "pnpm content:prepare && pnpm font:prepare && astro build",
		"font:prepare": "node scripts/fonts/index.mjs",
		"font:check": "node scripts/fonts/index.mjs --check",
		"icons:export": "node scripts/icons/export-local-icons.mjs",
		"submit": "node scripts/indexnow-submit.js",
		"preview": "astro preview",
		"astro": "astro",
		"pretype-check": "node scripts/check-env.mjs",
		"type-check": "tsc --noEmit",
		"type-check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"type-check:svelte": "svelte-check --tsconfig ./tsconfig.json --threshold error",
		"type-check:declarations": "tsc --noEmit --isolatedDeclarations",
		"pretest:smoke": "node scripts/check-env.mjs",
		"test:smoke": "playwright test tests/e2e/smoke",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:fast": "vitest run tests/unit tests/integration",
		"test:e2e:smoke": "playwright test tests/e2e/smoke",
		"test:e2e:shell": "playwright test tests/e2e/shell",
		"test:e2e:full": "playwright test",
		"test:plan": "node scripts/test-impact.mjs",
		"test:plan:ci": "node scripts/test-impact.mjs --mode=ci",
		"test:affected": "node scripts/test-impact.mjs --run",
		"test:affected:ci": "node scripts/test-impact.mjs --mode=ci --run",
		"test:impact:check": "node scripts/test-impact.mjs --check-coverage",
		"type-check:tests": "tsc -p tsconfig.tests.json --noEmit",
		"verify:full": "pnpm lint && pnpm design:check && pnpm check && pnpm type-check && pnpm type-check:scripts && pnpm type-check:svelte && pnpm type-check:tests && pnpm test:fast && pnpm test:e2e:full && pnpm build",
		"test:smoke:install": "playwright install chromium",
		"new-post": "node scripts/new-post.js",
		"generate-posts": "node scripts/generate-posts.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:md": "markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --fix",
		"lint": "eslint src scripts tests \"*.config.{js,mjs,cjs,ts}\"",
		"lint:fix": "eslint src scripts tests \"*.config.{js,mjs,cjs,ts}\" --fix",
		"design:check": "node scripts/check-design-system.mjs",
		"typography:inventory": "node scripts/typography-inventory.mjs",
		"prepare": "node scripts/install-git-hooks.mjs",
		"precommit": "node scripts/check-env.mjs && node scripts/pre-commit-check.mjs",
		"preinstall": "node scripts/check-env.mjs",
		"clean": "rimraf node_modules pnpm-lock.yaml",
		"clean:force": "rimraf node_modules pnpm-lock.yaml && pnpm store prune"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/rss": "^4.0.15",
		"@astrojs/sitemap": "^3.7.0",
		"@astrojs/svelte": "7.2.5",
		"@expressive-code/core": "^0.41.7",
		"@expressive-code/plugin-collapsible-sections": "^0.41.7",
		"@expressive-code/plugin-line-numbers": "^0.41.7",
		"@fancyapps/ui": "^6.1.12",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@iconify-json/devicon": "^1.2.62",
		"@iconify-json/fa7-brands": "^1.2.2",
		"@iconify-json/fa7-regular": "^1.2.3",
		"@iconify-json/fa7-solid": "^1.2.4",
		"@iconify-json/logos": "^1.2.11",
		"@iconify-json/material-symbols": "^1.2.59",
		"@iconify-json/simple-icons": "^1.2.71",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"astro": "5.18.0",
		"astro-expressive-code": "^0.41.7",
		"astro-icon": "^1.1.5",
		"axios": "^1.13.6",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.19",
		"hastscript": "^9.0.1",
		"katex": "^0.16.33",
		"marked": "^16.4.2",
		"oddmisc": "^1.1.5",
		"pagefind": "^1.4.0",
		"photoswipe": "^5.4.4",
		"qrcode": "^1.5.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^3.0.1",
		"remark-directive-rehype": "^0.4.2",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"satori": "^0.19.2",
		"sharp": "^0.34.5",
		"stylus": "^0.64.0",
		"svelte": "^5.53.6",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.6",
		"@eslint/js": "^9.39.4",
		"@iconify-json/mdi": "^1.2.3",
		"@playwright/test": "^1.61.1",
		"@rollup/plugin-yaml": "^4.1.2",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "25.4.0",
		"@types/qrcode": "^1.5.6",
		"astro-eslint-parser": "1.4.0",
		"eslint": "^9.39.4",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-svelte": "^3.20.0",
		"fontmin": "^1.1.1",
		"globals": "^17.7.0",
		"markdownlint-cli2": "^0.17.2",
		"postcss-import": "^16.1.1",
		"postcss-nesting": "^13.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^3.5.0",
		"svelte-check": "^4.7.3",
		"typescript-eslint": "^8.62.1",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@10.22.0"
}
